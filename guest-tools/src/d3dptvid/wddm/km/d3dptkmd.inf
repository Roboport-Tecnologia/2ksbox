; d3dptkmd.inf - 2ksbox paravirtual display adapter (d3dpt-vga), WDDM,
; Windows 7 32-bit (M18 step 2, ADR-022) and Windows 11 x64 (M20; test
; signed in the guest by wddm-install.ps1, which writes the catalog). Kernel-mode driver d3dptkmd.sys,
; Direct3D 9's user-mode driver d3dptumd.dll (plan step 6). The XP-model driver
; (../../nt/d3dptvid.inf) matches the same device and stays the fallback:
; Device Manager > Update Driver > "Let me pick" brings it back.

[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/09/2026,0.3.25.0
CatalogFile.NTamd64=d3dptkmd.cat

[DestinationDirs]
DefaultDestDir=12
d3dpt.UserMode=11
d3dpt.UserModeWow=10,SysWOW64

[SourceDisksNames]
1=%DiskId%,,,

[SourceDisksFiles]
d3dptkmd.sys=1
d3dptumd.dll=1
d3dptumd32.dll=1

[Manufacturer]
%Mfg%=d3dpt.Mfg,NTx86,NTamd64

[d3dpt.Mfg.NTx86]
%d3dpt.DeviceDesc%=d3dpt_Install, PCI\VEN_1234&DEV_3D00

[d3dpt.Mfg.NTamd64]
%d3dpt.DeviceDesc%=d3dpt_Install64, PCI\VEN_1234&DEV_3D00

; The install section's own AddReg: its HKR is the adapter's software key,
; where Direct3D looks up the user-mode driver (d3d9.dll loads it by this
; name from System32; without it no process loads d3dptumd.dll and DWM
; never composes). An XP-style <install>.SoftwareSettings section is not
; processed for this driver on Windows 7: a fresh install left the key
; without the value (track M18 finding 15).
; FeatureScore: Windows 10 and 11 rank Basic Display (display.inf, FB) above
; a package without one, whatever its hardware ID match; WDDM drivers say F8.
[d3dpt_Install]
FeatureScore=F8
CopyFiles=d3dpt.Miniport, d3dpt.UserMode
AddReg=d3dpt_SoftwareDeviceSettings

; x64: also the 32-bit user-mode driver, which d3d9.dll loads in a 32-bit
; process (WoW64) by UserModeDriverNameWow from SysWOW64; without it a
; 32-bit Direct3D program (most of the era's games) has no HAL device
[d3dpt_Install64]
FeatureScore=F8
CopyFiles=d3dpt.Miniport, d3dpt.UserMode, d3dpt.UserModeWow
AddReg=d3dpt_SoftwareDeviceSettings, d3dpt_SoftwareDeviceSettingsWow

[d3dpt_Install64.Services]
AddService=d3dptkmd, 0x00000002, d3dpt_Service_Inst

[d3dpt.UserModeWow]
d3dptumd32.dll

[d3dpt_SoftwareDeviceSettingsWow]
HKR,,UserModeDriverNameWow,%REG_MULTI_SZ%,d3dptumd32.dll

[d3dpt.Miniport]
d3dptkmd.sys

[d3dpt.UserMode]
d3dptumd.dll

[d3dpt_SoftwareDeviceSettings]
HKR,,UserModeDriverName,%REG_MULTI_SZ%,d3dptumd.dll

[d3dpt_Install.Services]
AddService=d3dptkmd, 0x00000002, d3dpt_Service_Inst

[d3dpt_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=0
LoadOrderGroup=Video
ServiceBinary=%12%\d3dptkmd.sys

[Strings]
REG_MULTI_SZ=0x00010000
Provider="2ksbox"
Mfg="2ksbox"
DiskId="2ksbox guest tools"
d3dpt.DeviceDesc="2ksbox paravirtual display adapter (d3dpt-vga, WDDM)"
