<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The App Store build's launcher (package-macos.sh's App Store
       build, docs/build-macos.md "The App Store package"). The
       store takes only sandboxed apps; the players and qemu-img it starts
       inherit this sandbox (app-store-*.entitlements). @APP_ID@ and
       @TEAM@ come from the provisioning profile and must match it. -->
  <key>com.apple.security.app-sandbox</key> <true/>
  <key>com.apple.application-identifier</key> <string>@APP_ID@</string>
  <key>com.apple.developer.team-identifier</key> <string>@TEAM@</string>
  <!-- The guest's network (QEMU's user-mode stack is the host's sockets)
       and the first-run preset download. -->
  <key>com.apple.security.network.client</key> <true/>
  <!-- The guest's UDP too: slirp sends from an unconnected socket, and
       the sandbox counts its replies (DNS first) as inbound. With only
       network.client every recvfrom fails EPERM while poll keeps saying
       readable, and QEMU's main loop spins on it holding the BQL. -->
  <key>com.apple.security.network.server</key> <true/>
  <!-- Discs, disks and folders the user picks in an open or save panel,
       and keeping them across launches as security-scoped bookmarks
       (launcher-core/src/grants.rs). The screenshots folder is one
       such pick (launcher-core/src/screenshots.rs), so no Pictures
       entitlement. -->
  <key>com.apple.security.files.user-selected.read-write</key> <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key> <true/>
</dict>
</plist>
