@@ -979,6 +979,20 @@ namespace dxvk {
       return m_state.renderStates[D3DRS_ZENABLE] && m_state.depthStencil != nullptr;
     }
 
+    // Untransformed geometry is always depth-clipped. Pre-transformed
+    // vertices are clipped only by a driver claiming D3DPMISCCAPS_CLIPTLVERTS
+    // and drawn with depth clamped otherwise (Wine's z_range_test and
+    // depth_clamp_test); here they are clipped while D3DRS_CLIPPING is on,
+    // so a caller without that cap turns it off for them, and never with
+    // the depth test off, which upstream got by flattening their Z to 0
+    // (table fog needs it, test_table_fog_zw)
+    inline bool WantDepthClip() {
+      bool positionT = m_state.vertexDecl != nullptr
+        && m_state.vertexDecl->TestFlag(D3D9VertexDeclFlag::HasPositionT);
+      return !positionT
+        || (m_state.renderStates[D3DRS_CLIPPING] && IsZTestEnabled());
+    }
+
     void BindMultiSampleState();
 
     void BindBlendState();
