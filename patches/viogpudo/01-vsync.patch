+#define VSYNC_TOTAL(height) ((height) + max(1u, (UINT)(height) / 20))
+
+VOID VioGpuDod::StartVSync(VOID)
+{
+    PAGED_CODE();
+
+    if (!g_VSyncHz || m_VSyncTimer)
+    {
+        return;
+    }
+    LARGE_INTEGER Frequency;
+    KeQueryPerformanceCounter(&Frequency);
+    m_QpcFrequency = Frequency.QuadPart;
+    m_VSyncTimer = ExAllocateTimer(VSyncTimerCallback, this, EX_TIMER_HIGH_RESOLUTION);
+    if (!m_VSyncTimer)
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("%s: ExAllocateTimer failed\n", __FUNCTION__));
+    }
+}
+
+VOID VioGpuDod::StopVSync(VOID)
+{
+    PAGED_CODE();
+
+    InterlockedExchange(&m_VSyncEnabled, 0);
+    if (m_VSyncTimer)
+    {
+        // cancels it and waits for a callback under way
+        ExDeleteTimer(m_VSyncTimer, TRUE, TRUE, NULL);
+        m_VSyncTimer = NULL;
+    }
+}
+
 VOID VioGpuDod::BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalInfo, PVIDEO_MODE_INFORMATION pModeInfo)
 {
     PAGED_CODE();
@@ -897,6 +937,22 @@ VOID VioGpuDod::BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalInfo
     pVideoSignalInfo->HSyncFreq.Denominator = D3DKMDT_FREQUENCY_NOTSPECIFIED;
     pVideoSignalInfo->PixelRate = D3DKMDT_FREQUENCY_NOTSPECIFIED;
     pVideoSignalInfo->ScanLineOrdering = D3DDDI_VSSLO_PROGRESSIVE;
+
+    // With a vertical blank of our own every rate must be given: a frame
+    // of VSYNC_TOTAL lines (a 1/20 blank) at g_VSyncHz. The active size is
+    // set here too (upstream copies the total before it is filled in).
+    if (g_VSyncHz)
+    {
+        pVideoSignalInfo->ActiveSize.cx = pModeInfo->VisScreenWidth;
+        pVideoSignalInfo->ActiveSize.cy = pModeInfo->VisScreenHeight;
+        pVideoSignalInfo->TotalSize.cy = VSYNC_TOTAL(pModeInfo->VisScreenHeight);
+        pVideoSignalInfo->VSyncFreq.Numerator = g_VSyncHz;
+        pVideoSignalInfo->VSyncFreq.Denominator = 1;
+        pVideoSignalInfo->HSyncFreq.Numerator = g_VSyncHz * (UINT)pVideoSignalInfo->TotalSize.cy;
+        pVideoSignalInfo->HSyncFreq.Denominator = 1;
+        pVideoSignalInfo->PixelRate = (SIZE_T)g_VSyncHz * (UINT)pVideoSignalInfo->TotalSize.cx *
+                                      (UINT)pVideoSignalInfo->TotalSize.cy;
+    }
 }
 
