+NTSTATUS VioGpuDod::ControlInterrupt(_In_ CONST DXGK_INTERRUPT_TYPE InterruptType, _In_ BOOLEAN EnableInterrupt)
+{
+    DbgPrint(TRACE_LEVEL_INFORMATION, ("<---> %s Type = %d Enable = %d\n", __FUNCTION__, InterruptType, EnableInterrupt));
+    if (InterruptType != DXGK_INTERRUPT_DISPLAYONLY_VSYNC)
+    {
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    if (!m_VSyncTimer)
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+    if (EnableInterrupt)
+    {
+        if (!InterlockedExchange(&m_VSyncEnabled, 1))
+        {
+            // 100 ns units; a relative first expiry, then periodic
+            LONGLONG Period = 10000000LL / g_VSyncHz;
+            ExSetTimer(m_VSyncTimer, -Period, Period, NULL);
+        }
+    }
+    else if (InterlockedExchange(&m_VSyncEnabled, 0))
+    {
+        ExCancelTimer(m_VSyncTimer, NULL);
+    }
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuDod::GetScanLine(_Inout_ DXGKARG_GETSCANLINE *pGetScanLine)
+{
+    UINT Height = m_CurrentMode.DispInfo.Height;
+    UINT Total = VSYNC_TOTAL(Height);
+    LONGLONG Period = m_QpcFrequency / max(1ul, g_VSyncHz);
+    LONGLONG Since = KeQueryPerformanceCounter(NULL).QuadPart - InterlockedCompareExchange64(&m_VSyncLastQpc, 0, 0);
+
+    if (Period <= 0 || Height == 0)
+    {
+        pGetScanLine->InVerticalBlank = TRUE;
+        pGetScanLine->ScanLine = 0;
+        return STATUS_SUCCESS;
+    }
+    if (Since < 0)
+    {
+        Since = 0;
+    }
+    // the blank ends at the timer's tick; the frame's lines follow it
+    UINT Line = (UINT)((Since % Period) * Total / Period);
+    pGetScanLine->InVerticalBlank = Line >= Height;
+    pGetScanLine->ScanLine = Line >= Height ? 0 : Line;
+    return STATUS_SUCCESS;
+}
+
+VOID VioGpuDod::VSyncTimerCallback(_In_ PEX_TIMER Timer, _In_opt_ PVOID Context)
+{
+    UNREFERENCED_PARAMETER(Timer);
+    VioGpuDod *pVioGpuDod = reinterpret_cast<VioGpuDod *>(Context);
+    if (!pVioGpuDod)
+    {
+        return;
+    }
+    InterlockedExchange64(&pVioGpuDod->m_VSyncLastQpc, KeQueryPerformanceCounter(NULL).QuadPart);
+    if (!pVioGpuDod->m_VSyncEnabled || !pVioGpuDod->IsDriverActive())
+    {
+        return;
+    }
+    // DxgkCbNotifyInterrupt is called at the device's IRQL, as from an ISR
+    BOOLEAN Ret = FALSE;
+    pVioGpuDod->m_DxgkInterface.DxgkCbSynchronizeExecution(pVioGpuDod->m_DxgkInterface.DeviceHandle,
+                                                          VSyncNotify,
+                                                          pVioGpuDod,
+                                                          0,
+                                                          &Ret);
+}
+
+BOOLEAN VioGpuDod::VSyncNotify(_In_opt_ PVOID Context)
+{
+    VioGpuDod *pVioGpuDod = reinterpret_cast<VioGpuDod *>(Context);
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA NotifyInterrupt = {};
+    NotifyInterrupt.InterruptType = DXGK_INTERRUPT_DISPLAYONLY_VSYNC;
+    NotifyInterrupt.DisplayOnlyVSync.VidPnTargetId = 0;
+    pVioGpuDod->m_DxgkInterface.DxgkCbNotifyInterrupt(pVioGpuDod->m_DxgkInterface.DeviceHandle, &NotifyInterrupt);
+    pVioGpuDod->m_DxgkInterface.DxgkCbQueueDpc(pVioGpuDod->m_DxgkInterface.DeviceHandle);
+    return TRUE;
+}
+
 BOOLEAN VioGpuDod::InterruptRoutine(_In_ ULONG MessageNumber)
 {
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<--> %s\n", __FUNCTION__));
