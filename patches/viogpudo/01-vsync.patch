+// The vertical blank (2ksbox): a high-resolution kernel timer stands in for
+// the scanout's, which virtio-gpu does not have. Without one dxgkrnl
+// simulates it for a mode with no refresh rate, and DWM composes on the
+// 15.6 ms system tick (64 Hz), which a 60 Hz host screen shows as a frame
+// dropped four times a second.
+#define VIOGPU_VSYNC_DEFAULT_HZ 60
+#define VIOGPU_VSYNC_MAX_HZ     240
+extern ULONG g_VSyncHz;
+
 #pragma pack(push)
 #pragma pack(1)
 
