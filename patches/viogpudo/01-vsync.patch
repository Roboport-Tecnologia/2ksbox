     NTSTATUS GetRegisterInfo(void);
     VOID BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalInfo, PVIDEO_MODE_INFORMATION pModeInfo);
+    VOID StartVSync(VOID);
+    VOID StopVSync(VOID);
+    static VOID VSyncTimerCallback(_In_ PEX_TIMER Timer, _In_opt_ PVOID Context);
+    static BOOLEAN VSyncNotify(_In_opt_ PVOID Context);
