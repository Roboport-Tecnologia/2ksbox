+/* host-vblank (2ksbox, QEMU patch 90): the host screen's vertical blank as
+ * ours. Feature bit 23; the guest turns the ticks on and off with command
+ * 0x0f00; each host blank sets bit 31 of events_read and raises the config
+ * interrupt. */
+#define VIRTIO_GPU_F_HOST_VBLANK       23
+#define VIRTIO_GPU_EVENT_HOST_VBLANK   (1u << 31)
+#define VIRTIO_GPU_CMD_SET_HOST_VBLANK 0x0f00
+#pragma pack(1)
+typedef struct virtio_gpu_set_host_vblank
+{
+    GPU_CTRL_HDR hdr;
+    ULONG enable;
+    ULONG padding;
+} GPU_SET_HOST_VBLANK, *PGPU_SET_HOST_VBLANK;
+#pragma pack()
