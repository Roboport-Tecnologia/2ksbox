+void CtrlQueue::SetHostVBlank(BOOLEAN enable)
+{
+    PAGED_CODE();
+
+    DbgPrint(TRACE_LEVEL_VERBOSE, ("---> %s %d\n", __FUNCTION__, enable));
+    PGPU_SET_HOST_VBLANK cmd;
+    PGPU_VBUFFER vbuf;
+    cmd = (PGPU_SET_HOST_VBLANK)AllocCmd(&vbuf, sizeof(*cmd));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_SET_HOST_VBLANK;
+    cmd->enable = enable ? 1 : 0;
+
+    QueueBuffer(vbuf);
+
+    DbgPrint(TRACE_LEVEL_VERBOSE, ("<--- %s\n", __FUNCTION__));
+}
