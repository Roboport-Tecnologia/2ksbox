+// From the adapter's interrupt routine, at the device's IRQL: the host
+// screen's blank (every Nth, at the guest's rate) as ours.
+VOID VioGpuDod::HostVBlank(VOID)
+{
+    LONGLONG Now = KeQueryPerformanceCounter(NULL).QuadPart;
+    InterlockedExchange64(&m_VSyncHostQpc, Now);
+    if (!m_VSyncEnabled || !IsDriverActive())
+    {
+        return;
+    }
+    InterlockedExchange64(&m_VSyncLastQpc, Now);
+    VSyncNotify(this);
+}
