+BOOLEAN VioGpuAdapter::HostVBlankEvent(void)
+{
+    if (!m_bHostVBlank)
+    {
+        return FALSE;
+    }
+    UINT32 events_read = 0, events_clear = VIRTIO_GPU_EVENT_HOST_VBLANK;
+    virtio_get_config(&m_VioDev, FIELD_OFFSET(GPU_CONFIG, events_read), &events_read, sizeof(events_read));
+    if (!(events_read & VIRTIO_GPU_EVENT_HOST_VBLANK))
+    {
+        return FALSE;
+    }
+    virtio_set_config(&m_VioDev, FIELD_OFFSET(GPU_CONFIG, events_clear), &events_clear, sizeof(events_clear));
+    m_pVioGpuDod->HostVBlank();
+    return (events_read & ~VIRTIO_GPU_EVENT_HOST_VBLANK) == 0;
+}
