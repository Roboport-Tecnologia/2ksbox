+VOID VioGpuDod::SetVSyncMhz(ULONG Mhz)
+{
+    PAGED_CODE();
+
+    if (Mhz == 0)
+    {
+        Mhz = VIOGPU_VSYNC_DEFAULT_HZ * 1000;
+    }
+    Mhz = max(1000ul, min(Mhz, VIOGPU_VSYNC_MAX_HZ * 1000ul));
+    if ((ULONG)InterlockedExchange(&m_VSyncMhz, (LONG)Mhz) != Mhz)
+    {
+        DbgPrint(TRACE_LEVEL_FATAL, ("%s: %lu mHz\n", __FUNCTION__, Mhz));
+        InterlockedExchange(&m_VSyncRebase, 1);
+    }
+}
