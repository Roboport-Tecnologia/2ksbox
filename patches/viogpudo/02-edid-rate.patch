+// The refresh rate of the EDID's preferred timing (its first detailed
+// timing descriptor, at byte 54: the pixel clock in 10 kHz units over the
+// total size), in mHz; 0 with no EDID from the device or no timing.
+ULONG VioGpuAdapter::EdidRefreshMhz(void)
+{
+    PAGED_CODE();
+
+    if (!m_bEDID)
+    {
+        return 0;
+    }
+    PUCHAR d = m_EDIDs + 54;
+    ULONGLONG Clock = (ULONGLONG)(d[0] | (d[1] << 8)) * 10000;
+    ULONG HTotal = (d[2] | ((d[4] & 0xF0) << 4)) + (d[3] | ((d[4] & 0x0F) << 8));
+    ULONG VTotal = (d[5] | ((d[7] & 0xF0) << 4)) + (d[6] | ((d[7] & 0x0F) << 8));
+    if (!Clock || !HTotal || !VTotal)
+    {
+        return 0;
+    }
+    return (ULONG)(Clock * 1000 / ((ULONGLONG)HTotal * VTotal));
+}
