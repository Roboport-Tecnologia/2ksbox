diff --git a/src/win32/endian.h b/src/win32/endian.h
new file mode 100644
index 0000000..34f3feb
--- /dev/null
+++ b/src/win32/endian.h
@@ -0,0 +1,19 @@
+/* <endian.h> for libtpms on Windows (win32/compat.h), which x86 and Arm
+ * Windows, both little-endian, do not have: the conversions glibc's
+ * gives, for the files that include it. */
+#ifndef LIBTPMS_WIN32_ENDIAN_H
+#define LIBTPMS_WIN32_ENDIAN_H
+#include <stdlib.h>
+#define htobe16(x) _byteswap_ushort(x)
+#define htobe32(x) _byteswap_ulong(x)
+#define htobe64(x) _byteswap_uint64(x)
+#define be16toh(x) _byteswap_ushort(x)
+#define be32toh(x) _byteswap_ulong(x)
+#define be64toh(x) _byteswap_uint64(x)
+#define htole16(x) (x)
+#define htole32(x) (x)
+#define htole64(x) (x)
+#define le16toh(x) (x)
+#define le32toh(x) (x)
+#define le64toh(x) (x)
+#endif
diff --git a/src/win32/netinet/in.h b/src/win32/netinet/in.h
new file mode 100644
index 0000000..c158e27
--- /dev/null
+++ b/src/win32/netinet/in.h
@@ -0,0 +1,12 @@
+/* <netinet/in.h> for libtpms on Windows (win32/compat.h): only the byte
+ * order conversions tpm_types.h includes it for. Winsock has them, but
+ * <winsock2.h> brings <windows.h>, whose macros the TPM code redefines.
+ * x86 and Arm Windows are little-endian. */
+#ifndef LIBTPMS_WIN32_NETINET_IN_H
+#define LIBTPMS_WIN32_NETINET_IN_H
+#include <stdlib.h>
+#define htonl(x) _byteswap_ulong(x)
+#define ntohl(x) _byteswap_ulong(x)
+#define htons(x) _byteswap_ushort(x)
+#define ntohs(x) _byteswap_ushort(x)
+#endif
