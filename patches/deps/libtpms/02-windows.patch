diff --git a/src/win32/compat.h b/src/win32/compat.h
new file mode 100644
index 0000000..7bb61c8
--- /dev/null
+++ b/src/win32/compat.h
@@ -0,0 +1,100 @@
+/* What libtpms's POSIX code paths take from POSIX, on Windows with MSVC's
+ * runtime (2ksbox, scripts/build-deps.sh): the clocks, an attribute
+ * macro and the string and printing functions below. Force-included
+ * (clang-cl -FI) into every source. No <windows.h>: its macros (BOOL,
+ * TRUE, ERROR) are the TPM reference code's names too. */
+#ifndef LIBTPMS_WIN32_COMPAT_H
+#define LIBTPMS_WIN32_COMPAT_H
+
+#include <time.h>
+#include <process.h>
+
+/* src/compiler.h defines it for compilers that say they are GCC, which
+ * clang-cl does not */
+#define LIBTPMS_ATTR_UNUSED __attribute__((unused))
+
+typedef int clockid_t;
+#define CLOCK_REALTIME  0
+#define CLOCK_MONOTONIC 1
+
+static __inline int clock_gettime(clockid_t clk_id, struct timespec *ts)
+{
+    if (clk_id == CLOCK_MONOTONIC) {
+        /* the UCRT's clock() is the wall time since the process started,
+         * on the performance counter: monotonic, in milliseconds, which
+         * is the TPM clock's own unit */
+        clock_t now = clock();
+        ts->tv_sec = (time_t)(now / CLOCKS_PER_SEC);
+        ts->tv_nsec = (long)((now % CLOCKS_PER_SEC) * (1000000000 / CLOCKS_PER_SEC));
+        return 0;
+    }
+    return timespec_get(ts, TIME_UTC) == TIME_UTC ? 0 : -1;
+}
+
+/* glibc's and POSIX's string and printing functions the C runtime lacks:
+ * index(), strndup(), [v]asprintf() and [v]dprintf() */
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <io.h>
+
+#define index(s, c) strchr((s), (c))
+
+static __inline char *strndup(const char *s, size_t n)
+{
+    size_t len = strnlen(s, n);
+    char *d = malloc(len + 1);
+    if (d) {
+        memcpy(d, s, len);
+        d[len] = 0;
+    }
+    return d;
+}
+
+static __inline int vasprintf(char **out, const char *fmt, va_list ap)
+{
+    va_list copy;
+    int n;
+    va_copy(copy, ap);
+    n = vsnprintf(NULL, 0, fmt, copy);
+    va_end(copy);
+    *out = NULL;
+    if (n < 0 || !(*out = malloc((size_t)n + 1))) {
+        return -1;
+    }
+    return vsnprintf(*out, (size_t)n + 1, fmt, ap);
+}
+
+static __inline int asprintf(char **out, const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, fmt);
+    n = vasprintf(out, fmt, ap);
+    va_end(ap);
+    return n;
+}
+
+static __inline int vdprintf(int fd, const char *fmt, va_list ap)
+{
+    char *s;
+    int n = vasprintf(&s, fmt, ap);
+    if (n > 0) {
+        n = _write(fd, s, (unsigned)n);
+    }
+    free(s);
+    return n;
+}
+
+static __inline int dprintf(int fd, const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+    va_start(ap, fmt);
+    n = vdprintf(fd, fmt, ap);
+    va_end(ap);
+    return n;
+}
+
+#endif
