+    return gen == gen_ADD || gen == gen_OR  || gen == gen_ADC ||
+           gen == gen_SBB || gen == gen_AND || gen == gen_SUB ||
+           gen == gen_XOR || gen == gen_MOV || gen == gen_IMUL3;
+}
