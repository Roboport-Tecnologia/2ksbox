diff --git a/accel/tcg/tb-softimm.c b/accel/tcg/tb-softimm.c
new file mode 100644
index 0000000..7bd8872
--- /dev/null
+++ b/accel/tcg/tb-softimm.c
@@ -0,0 +1,258 @@
+/*
+ * Soft immediates: the bookkeeping (see include/exec/tb-softimm.h).
+ *
+ * Copyright (c) 2026 the 2ksbox project
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "qemu/units.h"
+#include "exec/exec-all.h"
+#include "exec/tb-softimm.h"
+#include "trace.h"
+
+/*
+ * How many times a block starting at one physical address has to be thrown
+ * away by a guest write before the next translation of it reads its operands
+ * at run time.  Low enough that a rasterizer patched per span pays it in the
+ * first frame, high enough that ordinary code (a page written once, a
+ * relocation, a hot-patched function prologue) never does.
+ */
+#define SOFT_IMM_HITS       4
+
+/* how many times a soft block may be thrown away anyway before we stop */
+#define SOFT_IMM_FAILS      4
+
+/* the invalidation counters: direct-mapped and lossy on purpose -- advisory */
+#define SOFT_IMM_HASH_BITS  13
+#define SOFT_IMM_HASH_SIZE  (1u << SOFT_IMM_HASH_BITS)
+
+/* what one soft block may carry; a span loop's template is ~14 fields */
+#define SOFT_IMM_MAX_FIELDS 48
+
+typedef struct SoftImmHot {
+    tb_page_addr_t pc;
+    uint32_t hits;              /* writes that threw a block here away */
+    uint8_t soft_fails;         /* ... of them, ones that were already soft */
+    bool giveup;                /* a block here cannot be kept: stop trying */
+} SoftImmHot;
+
+static SoftImmHot soft_imm_hot[SOFT_IMM_HASH_SIZE];
+
+/*
+ * The field lists of live blocks.  A bump arena rather than g_malloc: the
+ * lists die together with the code they belong to, and tb_flush is where
+ * both go.  Running out only means later blocks are translated the ordinary
+ * way.
+ */
+#define SOFT_IMM_ARENA_SIZE (4 * MiB)
+static uint8_t *soft_imm_arena;
+static size_t soft_imm_arena_used;
+static QemuMutex soft_imm_arena_lock;
+
+/* the block being translated on this thread */
+static __thread struct {
+    bool active;
+    unsigned n;
+    SoftImmField f[SOFT_IMM_MAX_FIELDS];
+} soft_imm_gen;
+
+/*
+ * Multiplicative, not pc >> 2: two blocks whose starts are a couple of bytes
+ * apart -- a loop entered at its top that jumps back past its first
+ * instruction, the shape of Blood's span loop -- shared a slot that way.  One
+ * patch throws both away, each reset the slot to its own pc, and neither ever
+ * reached SOFT_IMM_HITS; the loop retranslated on every patch.
+ */
+static unsigned soft_imm_hash(tb_page_addr_t pc)
+{
+    return ((uint64_t)pc * 0x9e3779b97f4a7c15ull) >> (64 - SOFT_IMM_HASH_BITS);
+}
+
+void soft_imm_note_invalidate(const TranslationBlock *tb)
+{
+    tb_page_addr_t phys_pc = tb_page_addr0(tb);
+    SoftImmHot *h = &soft_imm_hot[soft_imm_hash(phys_pc)];
+
+    if (h->pc != phys_pc) {
+        h->pc = phys_pc;
+        h->hits = 1;
+        h->soft_fails = 0;
+        h->giveup = false;
+        return;
+    }
+    if (h->hits < UINT32_MAX) {
+        h->hits++;
+    }
+    /*
+     * A block that already read its operands at run time and was thrown away
+     * regardless is patched somewhere the generated code baked in -- an
+     * opcode, or an operand of an instruction that keeps its constant.
+     * Translating it that way again would only make it slower.
+     */
+    if (tb->soft_imm && h->soft_fails < UINT8_MAX &&
+        ++h->soft_fails >= SOFT_IMM_FAILS) {
+        h->giveup = true;
+    }
+}
+
+bool soft_imm_begin(tb_page_addr_t phys_pc, int cflags)
+{
+    const SoftImmHot *h;
+
+    soft_imm_gen.active = false;
+    soft_imm_gen.n = 0;
+
+    if (!tcg_soft_imm || phys_pc == -1) {
+        return false;
+    }
+    /*
+     * A block whose operands are read from memory is fine under any number
+     * of vCPUs, but the write that skips its invalidation is only safe for
+     * the vCPU that made it: another one may be inside the block.  Leave
+     * parallel contexts to the ordinary path.
+     */
+    if (cflags & CF_PARALLEL) {
+        return false;
+    }
+    h = &soft_imm_hot[soft_imm_hash(phys_pc)];
+    if (h->pc != phys_pc || h->hits < SOFT_IMM_HITS || h->giveup) {
+        return false;
+    }
+    soft_imm_gen.active = true;
+    return true;
+}
+
+bool soft_imm_active(void)
+{
+    return soft_imm_gen.active;
+}
+
+/*
+ * Room for one more field, taken.  Asked *before* the load is emitted, so
+ * that a block with more operands than fit keeps the ones it registered and
+ * leaves the rest as constants, rather than emitting loads nothing records
+ * and then being invalidated anyway.
+ */
+bool soft_imm_field(unsigned off, unsigned size)
+{
+    SoftImmField *f;
+
+    if (!soft_imm_gen.active || soft_imm_gen.n == SOFT_IMM_MAX_FIELDS ||
+        off > UINT16_MAX) {
+        return false;
+    }
+    f = &soft_imm_gen.f[soft_imm_gen.n++];
+    f->off = off;
+    f->size = size;
+    return true;
+}
+
+/*
+ * This block cannot be kept alive across its patches after all.  Translating
+ * it with run-time operand loads again would only make it slower, so stop.
+ */
+static void soft_imm_giveup(tb_page_addr_t phys_pc)
+{
+    SoftImmHot *h = &soft_imm_hot[soft_imm_hash(phys_pc)];
+
+    if (h->pc == phys_pc) {
+        h->giveup = true;
+    }
+}
+
+static void *soft_imm_arena_alloc(size_t size)
+{
+    void *p = NULL;
+
+    qemu_mutex_lock(&soft_imm_arena_lock);
+    if (!soft_imm_arena) {
+        soft_imm_arena = g_malloc0(SOFT_IMM_ARENA_SIZE);
+    }
+    size = ROUND_UP(size, sizeof(void *));
+    if (soft_imm_arena_used + size <= SOFT_IMM_ARENA_SIZE) {
+        p = soft_imm_arena + soft_imm_arena_used;
+        soft_imm_arena_used += size;
+    }
+    qemu_mutex_unlock(&soft_imm_arena_lock);
+    return p;
+}
+
+void soft_imm_attach(TranslationBlock *tb)
+{
+    SoftImmTB *si;
+    unsigned n = soft_imm_gen.n;
+    bool active = soft_imm_gen.active;
+
+    tb->soft_imm = NULL;
+    soft_imm_gen.active = false;
+    if (!active || n == 0) {
+        return;
+    }
+    /*
+     * The field offsets are the first page's; a block that spans two pages
+     * would need the second one's writes checked against the first one's
+     * list.  Not worth it: 0 % of the blocks here span (info jit).
+     */
+    if (tb_page_addr1(tb) != -1) {
+        soft_imm_giveup(tb_page_addr0(tb));
+        return;
+    }
+    si = soft_imm_arena_alloc(sizeof(*si) + n * sizeof(si->f[0]));
+    if (!si) {
+        soft_imm_giveup(tb_page_addr0(tb));
+        return;
+    }
+    si->n = n;
+    memcpy(si->f, soft_imm_gen.f, n * sizeof(si->f[0]));
+    tb->soft_imm = si;
+    trace_soft_imm_block(tb_page_addr0(tb), n);
+}
+
+bool soft_imm_covers(const TranslationBlock *tb,
+                     tb_page_addr_t start, tb_page_addr_t last)
+{
+    const SoftImmTB *si = tb->soft_imm;
+    tb_page_addr_t tb_start;
+    int64_t lo, hi, b;
+
+    if (!si) {
+        return false;
+    }
+    tb_start = tb_page_addr0(tb);
+    lo = (int64_t)start - (int64_t)tb_start;
+    hi = (int64_t)last - (int64_t)tb_start;
+    if (lo < 0) {
+        lo = 0;
+    }
+    if (hi > (int64_t)tb->size - 1) {
+        hi = (int64_t)tb->size - 1;
+    }
+    for (b = lo; b <= hi; b++) {
+        unsigned i;
+        for (i = 0; i < si->n; i++) {
+            if (b >= si->f[i].off && b < si->f[i].off + si->f[i].size) {
+                break;
+            }
+        }
+        if (i == si->n) {
+            return false;               /* a byte the generated code baked in */
+        }
+    }
+    trace_soft_imm_absorb(start, (unsigned)(last - start + 1));
+    return true;
+}
+
+void soft_imm_reset(void)
+{
+    qemu_mutex_lock(&soft_imm_arena_lock);
+    soft_imm_arena_used = 0;
+    qemu_mutex_unlock(&soft_imm_arena_lock);
+    memset(soft_imm_hot, 0, sizeof(soft_imm_hot));
+}
+
+static void __attribute__((constructor)) soft_imm_init(void)
+{
+    qemu_mutex_init(&soft_imm_arena_lock);
+}
diff --git a/include/exec/tb-softimm.h b/include/exec/tb-softimm.h
new file mode 100644
index 0000000000..fb7d480525
--- /dev/null
+++ b/include/exec/tb-softimm.h
@@ -0,0 +1,75 @@
+/*
+ * Soft immediates: a translated block that survives the patches a
+ * self-modifying rasterizer makes to its own operands.
+ *
+ * The software renderers of the era write their inner loops as a template
+ * and patch the operands into the instruction stream per span: the texture
+ * base as a disp32, the u/v steps as imm32, the carries as imm8 (Moto
+ * Racer's two loops, docs/tracks/m9-tcg-aarch64.md).  Patch 18 takes the
+ * rewrites that land on the value already there; what is left is the ones
+ * that really change, and each of those throws a block away and pays a
+ * retranslation.
+ *
+ * A block translated in *soft* mode reads those fields from the guest's own
+ * code bytes at run time -- a host load of the bytes the guest is patching,
+ * so the guest's store is the update and there is nothing to keep in step --
+ * instead of baking them into the generated code.  The block then only has
+ * to survive the write, which is what the field list below is for: a store
+ * that lands entirely inside fields the block reads at run time changes
+ * nothing about the code translated from the rest of the bytes.
+ *
+ * Emitting the load is always correct on its own; the list is what makes a
+ * write cheap, and a field is registered only where the load is emitted, so
+ * a use that kept the constant can never be left behind stale.
+ *
+ * Copyright (c) 2026 the 2ksbox project
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_TB_SOFTIMM_H
+#define EXEC_TB_SOFTIMM_H
+
+#include "exec/translation-block.h"
+
+typedef struct SoftImmField {
+    uint16_t off;               /* the field's first byte, from the TB's start */
+    uint16_t size;              /* 1, 2 or 4 */
+} SoftImmField;
+
+typedef struct SoftImmTB {
+    uint16_t n;
+    SoftImmField f[];
+} SoftImmTB;
+
+#ifdef CONFIG_USER_ONLY
+/* system-mode only: there is no page-protection story to win in user mode */
+#define tcg_soft_imm false
+static inline bool soft_imm_active(void) { return false; }
+static inline bool soft_imm_field(unsigned off, unsigned size) { return false; }
+#else
+
+/* -accel tcg,soft-imm=on|off */
+extern bool tcg_soft_imm;
+
+/*
+ * The store side, under the page lock: every byte of [start, last] that
+ * falls in @tb is a field @tb reads at run time, so the block stays valid.
+ */
+bool soft_imm_covers(const TranslationBlock *tb,
+                     tb_page_addr_t start, tb_page_addr_t last);
+
+/* A guest write is about to throw @tb away. */
+void soft_imm_note_invalidate(const TranslationBlock *tb);
+
+/* The translation side, in tb_gen_code order. */
+bool soft_imm_begin(tb_page_addr_t phys_pc, int cflags);
+bool soft_imm_active(void);
+bool soft_imm_field(unsigned off, unsigned size);
+void soft_imm_attach(TranslationBlock *tb);
+void soft_imm_reset(void);              /* tb_flush */
+
+/* how the effect is measured from outside: the TB invalidate count of
+ * `info jit`, which is what a write absorbed here does not bump */
+
+#endif /* !CONFIG_USER_ONLY */
+
+#endif
