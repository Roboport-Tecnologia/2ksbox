+/*
+ * Patch 44: everything besides the page tables that a translation
+ * depends on, packed without loss -- CR3 (32 bits on this target), the
+ * paging mode, the A20 gate and SMM in one word, the protection keys in
+ * the other.  A retired TLB entry is only reused under the key it was
+ * filled under.
+ */
+static void x86_tlb_retire_key(CPUX86State *env, uint64_t *key, uint64_t *key2)
+{
+    *key = (uint32_t)env->cr[3]
+         | ((uint64_t)(get_pg_mode(env) & 0xffff) << 32)
+         | ((uint64_t)(env->a20_mask != -1) << 48)
+         | ((uint64_t)((env->hflags & HF_SMM_MASK) != 0) << 49);
+    *key2 = env->pkru | ((uint64_t)env->pkrs << 32);
+}
+
+bool x86_tlb_retired_reusable(CPUState *cs, int mmu_idx, vaddr addr,
+                              const CPUTLBEntryFull *full)
+{
+    CPUX86State *env = cpu_env(cs);
+    uint64_t key, key2;
+    int i;
+
+    x86_tlb_retire_key(env, &key, &key2);
+    if (full->extra.x86.key != key || full->extra.x86.key2 != key2) {
+        return false;
+    }
+    if (full->extra.x86.pt_n == 0) {
+        return full->extra.x86.identity;
+    }
+    for (i = 0; i < full->extra.x86.pt_n; i++) {
+        uint64_t now = full->extra.x86.pt_wide
+                     ? ldq_p(full->extra.x86.pt_haddr[i])
+                     : ldl_p(full->extra.x86.pt_haddr[i]);
+
+        if (now != full->extra.x86.pt_val[i]) {
+            return false;
+        }
+    }
+    return true;
+}
