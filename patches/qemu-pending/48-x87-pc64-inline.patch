+/* ---- 64-bit precision: the integer mantissas, exactly (patch 48) ----
+ *
+ * No host format holds a 64-bit mantissa, so PC=64 (x87-shadow's mode 3)
+ * is done on the integers: a normal x80 is m * 2^(e - 16383 - 63) with the
+ * integer bit set in m, and +, -, * and / of two of them are a 128-bit
+ * sum, product or quotient rounded back to 64 bits, nearest-even -- what
+ * softfloat's floatx80 path computes, without its canonicalisation.
+ * Operands: normal (integer bit set, exponent 1..0x7ffe) or zero;
+ * unnormals, denormals, pseudo-denormals, infinities and NaNs return false.
+ * Results: a pre-rounding exponent of 1..0x7ffd, so neither overflow nor
+ * tininess can arise; anything else returns false too. */
+
+static inline bool x87f_x_ok(floatx80 a)
+{
+    uint32_t e = a.high & 0x7fff;
+
+    if (e == 0) {
+        return a.low == 0;
+    }
+    return e != 0x7fff && (a.low >> 63);
+}
+
+/* m with the bits below it in `rest` (its top bit = half an ulp),
+ * nearest-even, packed with exponent e */
+static inline bool x87f_pack_x(uint32_t sign, int32_t e, uint64_t m, uint64_t rest,
+                               floatx80 *r, bool *inexact)
+{
+    const uint64_t half = 1ULL << 63;
+
+    if (e < 1 || e > 0x7ffd) {
+        return false;
+    }
+    *inexact = rest != 0;
+    if (rest > half || (rest == half && (m & 1))) {
+        if (++m == 0) {                         /* 0xffff...f + 1: 1.0 of the next binade */
+            m = half;
+            e++;
+        }
+    }
+    r->low = m;
+    r->high = sign | e;
+    return true;
+}
+
+static inline bool x87f_mul_x(floatx80 a, floatx80 b, floatx80 *r, bool *inexact)
+{
+    uint32_t sign = (a.high ^ b.high) & 0x8000;
+    int32_t ea = a.high & 0x7fff, eb = b.high & 0x7fff;
+    unsigned __int128 p;
+
+    if (ea == 0 || eb == 0) {                   /* times a zero: a signed zero */
+        r->low = 0;
+        r->high = sign;
+        *inexact = false;
+        return true;
+    }
+    p = (unsigned __int128)a.low * b.low;       /* [2^126, 2^128) */
+    if (p >> 127) {
+        return x87f_pack_x(sign, ea + eb - X87F_EXP_BIAS + 1, (uint64_t)(p >> 64), (uint64_t)p, r, inexact);
+    }
+    return x87f_pack_x(sign, ea + eb - X87F_EXP_BIAS, (uint64_t)(p >> 63), (uint64_t)p << 1, r, inexact);
+}
+
+static inline int x87f_clz128(unsigned __int128 v)
+{
+    uint64_t hi = (uint64_t)(v >> 64);
+
+    return hi ? __builtin_clzll(hi) : 64 + __builtin_clzll((uint64_t)v);
+}
+
+static inline bool x87f_add_x(floatx80 a, floatx80 b, bool sub, floatx80 *r, bool *inexact)
+{
+    uint32_t sa = a.high & 0x8000, sb = (b.high & 0x8000) ^ (sub ? 0x8000 : 0), sx;
+    int32_t ea = a.high & 0x7fff, eb = b.high & 0x7fff, ex, n;
+    uint64_t mx, my;
+    uint32_t d;
+    unsigned __int128 X, Y, S;
+
+    *inexact = false;
+    if (eb == 0) {
+        if (ea == 0) {                          /* 0 + 0: -0 only when both are, nearest-even */
+            r->low = 0;
+            r->high = sa & sb;
+        } else {
+            *r = a;
+        }
+        return true;
+    }
+    if (ea == 0) {
+        r->low = b.low;
+        r->high = sb | eb;
+        return true;
+    }
+    /* x the larger in magnitude */
+    if (ea > eb || (ea == eb && a.low >= b.low)) {
+        mx = a.low; ex = ea; sx = sa; my = b.low; d = ea - eb;
+    } else {
+        mx = b.low; ex = eb; sx = sb; my = a.low; d = eb - ea;
+    }
+    X = (unsigned __int128)mx << 64;
+    if (d <= 64) {
+        Y = ((unsigned __int128)my << 64) >> d; /* nothing shifted out */
+    } else if (d < 128) {
+        Y = ((unsigned __int128)my << 64) >> d;
+        Y |= (my << (128 - d)) != 0;            /* what went, as a sticky bit */
+    } else {
+        Y = 1;
+    }
+    if (sa == sb) {
+        S = X + Y;
+        if (S < X) {                            /* carried out of 2^128 */
+            S = (S >> 1) | (S & 1) | ((unsigned __int128)1 << 127);
+            ex++;
+        }
+    } else {
+        S = X - Y;
+        if (S == 0) {                           /* x - x: +0, nearest-even */
+            r->low = 0;
+            r->high = 0;
+            return true;
+        }
+        /* a shift of more than one place only follows d <= 1, where Y
+         * carries no sticky bit, so it is exact */
+        n = x87f_clz128(S);
+        S <<= n;
+        ex -= n;
+    }
+    return x87f_pack_x(sx, ex, (uint64_t)(S >> 64), (uint64_t)S, r, inexact);
+}
+
+static inline bool x87f_div_x(floatx80 a, floatx80 b, floatx80 *r, bool *inexact)
+{
+    uint32_t sign = (a.high ^ b.high) & 0x8000;
+    int32_t ea = a.high & 0x7fff, eb = b.high & 0x7fff, e;
+    unsigned __int128 n;
+    uint64_t q, rem, rest;
+
+    if (eb == 0) {                              /* by zero: ZE (or IE for 0/0) is softfloat's */
+        return false;
+    }
+    if (ea == 0) {
+        r->low = 0;
+        r->high = sign;
+        *inexact = false;
+        return true;
+    }
+    e = ea - eb + X87F_EXP_BIAS;
+    if (a.low >= b.low) {
+        n = (unsigned __int128)a.low << 63;     /* the quotient in [2^63, 2^64) */
+    } else {
+        n = (unsigned __int128)a.low << 64;
+        e--;
+    }
+    q = (uint64_t)(n / b.low);
+    rem = (uint64_t)(n - (unsigned __int128)q * b.low);
+    /* the remainder against half the divisor, as a `rest` for the rounding */
+    rest = rem == 0 ? 0 : rem > b.low - rem ? (1ULL << 63) + 1 : rem == b.low - rem ? 1ULL << 63 : 1;
+    return x87f_pack_x(sign, e, q, rest, r, inexact);
+}
+
+/* a OP b at PC=64; op as x87-shadow's: 0 add, 1 mul, 4 sub, 5 subr, 6 div, 7 divr */
+static inline bool x87f_binop_x(int op, floatx80 a, floatx80 b, floatx80 *r, bool *inexact)
+{
+    if (!x87f_x_ok(a) || !x87f_x_ok(b)) {
+        return false;
+    }
+    switch (op) {
+    case 0:
+        return x87f_add_x(a, b, false, r, inexact);
+    case 1:
+        return x87f_mul_x(a, b, r, inexact);
+    case 4:
+        return x87f_add_x(a, b, true, r, inexact);
+    case 5:
+        return x87f_add_x(b, a, true, r, inexact);
+    case 6:
+        return x87f_div_x(a, b, r, inexact);
+    case 7:
+        return x87f_div_x(b, a, r, inexact);
+    default:
+        return false;
+    }
+}
+
+/* a normal x80 (or zero) -> binary64 / binary32 bits, nearest-even, when
+ * the result is a normal of that format (or zero); fst m64 / m32 at PC=64 */
+static inline bool x87f_x_to_fmt(floatx80 a, int mbits, int emin, int emax, uint64_t *bits,
+                                 bool *inexact)
+{
+    uint32_t e = a.high & 0x7fff;
+    uint64_t sign = (uint64_t)(a.high >> 15) << (mbits + (mbits == 52 ? 11 : 8));
+    const uint64_t half = 1ULL << 63;
+    uint64_t m, rest;
+    int32_t ue;
+
+    *inexact = false;
+    if (e == 0 && a.low == 0) {
+        *bits = sign;
+        return true;
+    }
+    if (!x87f_x_ok(a)) {
+        return false;
+    }
+    ue = (int32_t)e - X87F_EXP_BIAS;
+    if (ue < emin || ue > emax) {
+        return false;
+    }
+    m = a.low >> (63 - mbits);                  /* mbits + 1 bits, the integer bit on top */
+    rest = a.low << (mbits + 1);
+    *inexact = rest != 0;
+    if (rest > half || (rest == half && (m & 1))) {
+        if (++m == (1ULL << (mbits + 1))) {
+            m >>= 1;
+            if (++ue > emax) {
+                return false;                   /* overflow: OE is softfloat's */
+            }
+        }
+    }
+    *bits = sign | ((uint64_t)(ue + emax) << mbits) | (m & ((1ULL << mbits) - 1));
+    return true;
+}
+
+/* a normal x80 (or zero) rounded to an integer, nearest-even, when it fits
+ * `bits` (16 or 32) signed bits with room to spare; fist at PC=64 */
+static inline bool x87f_x_to_int(floatx80 a, int bits, int32_t *out, bool *inexact)
+{
+    uint32_t e = a.high & 0x7fff;
+    const uint64_t half = 1ULL << 63;
+    uint64_t q, frac;
+    int32_t ue;
