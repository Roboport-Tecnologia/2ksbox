+ * and flags as cpu_get_tb_cpu_state() computes them, from the state the
+ * instruction and gen_eob() have already stored, so far jumps (CS and hflags
+ * changed by a helper) and the x87 / SSE fast-mode bits (runtime state) are
+ * covered exactly like the helper would. i386 target only: the x86-64
+ * target's CS64 case (cs_base 0, a 64-bit pc) is not built here.
+ */
+static void gen_lookup_and_goto_ptr(DisasContext *s)
+{
+#ifdef TARGET_X86_64
+    tcg_gen_lookup_and_goto_ptr();
+#else
+    TCGv_i32 flags = tcg_temp_new_i32();
+    TCGv_i32 t = tcg_temp_new_i32();
+    TCGv_i32 u = tcg_temp_new_i32();
+    TCGv_i64 pc = tcg_temp_new_i64();
+    TCGv_i64 cs_base = tcg_temp_new_i64();
