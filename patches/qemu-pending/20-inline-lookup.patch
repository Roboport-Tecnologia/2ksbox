+    tcg_gen_ld_i32(flags, tcg_env, offsetof(CPUX86State, hflags));
+    tcg_gen_ld_i32(t, tcg_env, offsetof(CPUX86State, eflags));
+    tcg_gen_andi_i32(t, t, IOPL_MASK | TF_MASK | RF_MASK | VM_MASK | AC_MASK);
+    tcg_gen_or_i32(flags, flags, t);
+    tcg_gen_ld8u_i32(t, tcg_env, offsetof(CPUX86State, x87_fast_mode));
+    tcg_gen_shli_i32(t, t, TB_FLAG_X87_MODE_SHIFT);
+    tcg_gen_or_i32(flags, flags, t);
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUX86State,
+                                   sse_status.float_exception_flags) != 2);
+    tcg_gen_ld16u_i32(t, tcg_env,
