-    tcg_gen_ld16u_i32(t, tcg_env, offsetof(CPUX86State, fpus));
-    tcg_gen_andi_i32(t, t, 0x20);                       /* FPUS_PE */
-    tcg_gen_setcondi_i32(TCG_COND_NE, t, t, 0);
-    tcg_gen_ld8u_i32(u, tcg_env, offsetof(CPUX86State, x87_fast_mode));
-    tcg_gen_setcondi_i32(TCG_COND_NE, u, u, 0);
