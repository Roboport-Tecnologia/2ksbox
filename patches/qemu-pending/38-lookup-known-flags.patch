-    tcg_gen_shli_i32(t, t, TB_FLAG_X87_PE_SHIFT);
-    tcg_gen_or_i32(flags, flags, t);
+    {
+        uint32_t known = s->flags & (TB_FLAG_X87_MODE_MASK | TB_FLAG_SSE_FAST_MASK);
+
+        if ((s->flags & TB_FLAG_X87_PE_MASK) && s->x87s_pe_sticky) {
+            known |= TB_FLAG_X87_PE_MASK;
