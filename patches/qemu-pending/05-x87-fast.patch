diff --git a/target/i386/tcg/x87-fast.h b/target/i386/tcg/x87-fast.h
new file mode 100644
index 00000000..8fb5a6f1
--- /dev/null
+++ b/target/i386/tcg/x87-fast.h
@@ -0,0 +1,523 @@
+/*
+ * x87 fast path: do the common case on the host FPU, bit-exactly.
+ *
+ * Every x87 arithmetic instruction goes through a helper and QEMU's
+ * software float library (80-bit, 128-bit parts, precision control
+ * applied at rounding). Under Windows the FPU almost never runs at full
+ * 64-bit precision: the process default is 53 bits (PC=10b) and Direct3D
+ * drops it to 24 bits, so the guest is really doing double/float math with
+ * a wider exponent range. When both operands are exactly representable as
+ * host doubles (floats), the rounding mode is nearest-even and the result
+ * is a normal number well inside the double (float) exponent range, the
+ * host's correctly rounded result is identical to what the 80-bit path
+ * produces after rounding to 53 (24) bits. Everything else -- denormals,
+ * infinities, NaNs, 64-bit mantissas, other rounding modes, results near
+ * the exponent limits -- falls back to softfloat, so results never change,
+ * only how fast the common case gets there.
+ *
+ * The inexact flag is recovered with error-free transformations (TwoSum,
+ * FMA residuals); the exponent window (X87F_WIN) keeps every residual
+ * representable so a nonzero residual is never rounded to zero.
+ *
+ * This header has no QEMU dependencies beyond the floatx80 struct, so
+ * tools/x87-fast-test.c can compile it on an x86-64 host and compare
+ * against the real x87 (the oracle both this and softfloat imitate).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef I386_TCG_X87_FAST_H
+#define I386_TCG_X87_FAST_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+enum {
+    X87F_PREC_S = 0,        /* precision control 24 bits: host float */
+    X87F_PREC_D = 1,        /* precision control 53 bits: host double */
+};
+
+enum {
+    X87F_ADD, X87F_SUB, X87F_MUL, X87F_DIV,
+};
+
+enum {
+    X87F_RND_NEAREST = 0, X87F_RND_DOWN = 1, X87F_RND_UP = 2, X87F_RND_ZERO = 3,
+};
+
+/* Exponent window for operands and results, relative to 2^0. */
+#define X87F_WIN_D 900
+#define X87F_WIN_S 90
+
+#define X87F_EXP_BIAS 16383
+
+/* ---- floatx80 <-> host double/float, exact conversions only ---- */
+
+static inline bool x87f_x80_to_d(floatx80 a, double *d)
+{
+    uint32_t e = a.high & 0x7fff;
+    uint64_t sign = (uint64_t)(a.high & 0x8000) << 48;
+    uint64_t bits;
+
+    if (e == 0 && a.low == 0) {
+        bits = sign;
+    } else {
+        if (e < X87F_EXP_BIAS - X87F_WIN_D || e > X87F_EXP_BIAS + X87F_WIN_D) {
+            return false;
+        }
+        /* normal with explicit integer bit; mantissa fits 53 bits */
+        if (!(a.low >> 63) || (a.low & 0x7ff)) {
+            return false;
+        }
+        bits = sign | ((uint64_t)(e - X87F_EXP_BIAS + 1023) << 52)
+             | ((a.low << 1) >> 12);
+    }
+    memcpy(d, &bits, 8);
+    return true;
+}
+
+static inline bool x87f_x80_to_f(floatx80 a, float *f)
+{
+    uint32_t e = a.high & 0x7fff;
+    uint32_t sign = (uint32_t)(a.high & 0x8000) << 16;
+    uint32_t bits;
+
+    if (e == 0 && a.low == 0) {
+        bits = sign;
+    } else {
+        if (e < X87F_EXP_BIAS - X87F_WIN_S || e > X87F_EXP_BIAS + X87F_WIN_S) {
+            return false;
+        }
+        if (!(a.low >> 63) || (a.low & 0xffffffffffULL)) {
+            return false;
+        }
+        bits = sign | ((e - X87F_EXP_BIAS + 127) << 23)
+             | (uint32_t)((a.low << 1) >> 41);
+    }
+    memcpy(f, &bits, 4);
+    return true;
+}
+
+/* Result acceptance: zero, or normal inside the window. */
+static inline bool x87f_d_ok(double d)
+{
+    uint64_t bits;
+    uint32_t e;
+
+    memcpy(&bits, &d, 8);
+    e = (bits >> 52) & 0x7ff;
+    if (e == 0) {
+        return (bits << 1) == 0;
+    }
+    return e >= 1023 - X87F_WIN_D && e <= 1023 + X87F_WIN_D;
+}
+
+static inline bool x87f_f_ok(float f)
+{
+    uint32_t bits;
+    uint32_t e;
+
+    memcpy(&bits, &f, 4);
+    e = (bits >> 23) & 0xff;
+    if (e == 0) {
+        return (bits << 1) == 0;
+    }
+    return e >= 127 - X87F_WIN_S && e <= 127 + X87F_WIN_S;
+}
+
+/* Caller guarantees d is zero or normal. */
+static inline floatx80 x87f_d_to_x80(double d)
+{
+    uint64_t bits;
+    uint32_t e;
+    floatx80 r;
+
+    memcpy(&bits, &d, 8);
+    e = (bits >> 52) & 0x7ff;
+    r.high = (bits >> 48) & 0x8000;
+    if (e == 0) {
+        r.low = 0;
+    } else {
+        r.high |= e - 1023 + X87F_EXP_BIAS;
+        r.low = (1ULL << 63) | ((bits & 0xfffffffffffffULL) << 11);
+    }
+    return r;
+}
+
+static inline floatx80 x87f_f_to_x80(float f)
+{
+    uint32_t bits;
+    uint32_t e;
+    floatx80 r;
+
+    memcpy(&bits, &f, 4);
+    e = (bits >> 23) & 0xff;
+    r.high = (bits >> 16) & 0x8000;
+    if (e == 0) {
+        r.low = 0;
+    } else {
+        r.high |= e - 127 + X87F_EXP_BIAS;
+        r.low = (1ULL << 63) | ((uint64_t)(bits & 0x7fffff) << 40);
+    }
+    return r;
+}
+
+/* ---- arithmetic ---- */
+
+static inline bool x87f_binop_d(int op, double a, double b,
+                                double *out, bool *inexact)
+{
+    double r, t, err;
+
+    switch (op) {
+    case X87F_ADD:
+    case X87F_SUB:
+        if (op == X87F_SUB) {
+            b = -b;
+        }
+        r = a + b;
+        if (!x87f_d_ok(r)) {
+            return false;
+        }
+        t = r - a;                                  /* TwoSum */
+        err = (a - (r - t)) + (b - t);
+        *inexact = err != 0.0;
+        break;
+    case X87F_MUL:
+        r = a * b;
+        if (!x87f_d_ok(r)) {
+            return false;
+        }
+        if (r == 0.0 && a != 0.0 && b != 0.0) {
+            return false;                           /* underflowed */
+        }
+        *inexact = __builtin_fma(a, b, -r) != 0.0;
+        break;
+    case X87F_DIV:
+        if (b == 0.0) {
+            return false;                           /* ZE / IE */
+        }
+        r = a / b;
+        if (!x87f_d_ok(r)) {
+            return false;
+        }
+        if (r == 0.0 && a != 0.0) {
+            return false;
+        }
+        *inexact = __builtin_fma(r, b, -a) != 0.0;
+        break;
+    default:
+        return false;
+    }
+    *out = r;
+    return true;
+}
+
+static inline bool x87f_binop_f(int op, float a, float b,
+                                float *out, bool *inexact)
+{
+    float r, t, err;
+
+    switch (op) {
+    case X87F_ADD:
+    case X87F_SUB:
+        if (op == X87F_SUB) {
+            b = -b;
+        }
+        r = a + b;
+        if (!x87f_f_ok(r)) {
+            return false;
+        }
+        t = r - a;
+        err = (a - (r - t)) + (b - t);
+        *inexact = err != 0.0f;
+        break;
+    case X87F_MUL:
+        r = a * b;
+        if (!x87f_f_ok(r)) {
+            return false;
+        }
+        if (r == 0.0f && a != 0.0f && b != 0.0f) {
+            return false;
+        }
+        *inexact = __builtin_fmaf(a, b, -r) != 0.0f;
+        break;
+    case X87F_DIV:
+        if (b == 0.0f) {
+            return false;
+        }
+        r = a / b;
+        if (!x87f_f_ok(r)) {
+            return false;
+        }
+        if (r == 0.0f && a != 0.0f) {
+            return false;
+        }
+        *inexact = __builtin_fmaf(r, b, -a) != 0.0f;
+        break;
+    default:
+        return false;
+    }
+    *out = r;
+    return true;
+}
+
+/*
+ * a OP b at precision `prec` (X87F_PREC_*), round-to-nearest-even.
+ * Returns false when the caller must use softfloat.
+ */
+static inline bool x87f_binop(int op, int prec, floatx80 a, floatx80 b,
+                              floatx80 *r, bool *inexact)
+{
+    if (prec == X87F_PREC_D) {
+        double da, db, dr;
+        if (!x87f_x80_to_d(a, &da) || !x87f_x80_to_d(b, &db)) {
+            return false;
+        }
+        if (!x87f_binop_d(op, da, db, &dr, inexact)) {
+            return false;
+        }
+        *r = x87f_d_to_x80(dr);
+        return true;
+    } else {
+        float fa, fb, fr;
+        if (!x87f_x80_to_f(a, &fa) || !x87f_x80_to_f(b, &fb)) {
+            return false;
+        }
+        if (!x87f_binop_f(op, fa, fb, &fr, inexact)) {
+            return false;
+        }
+        *r = x87f_f_to_x80(fr);
+        return true;
+    }
+}
+
+static inline bool x87f_sqrt(int prec, floatx80 a, floatx80 *r, bool *inexact)
+{
+    if (a.high & 0x8000) {
+        /* sqrt(-0) = -0 is exact; anything else negative is IE */
+        if ((a.high & 0x7fff) == 0 && a.low == 0) {
+            *r = a;
+            *inexact = false;
+            return true;
+        }
+        return false;
+    }
+    if (prec == X87F_PREC_D) {
+        double d, s;
+        if (!x87f_x80_to_d(a, &d)) {
+            return false;
+        }
+        s = __builtin_sqrt(d);
+        if (!x87f_d_ok(s)) {
+            return false;
+        }
+        *inexact = __builtin_fma(s, s, -d) != 0.0;
+        *r = x87f_d_to_x80(s);
+        return true;
+    } else {
+        float f, s;
+        if (!x87f_x80_to_f(a, &f)) {
+            return false;
+        }
+        s = __builtin_sqrtf(f);
+        if (!x87f_f_ok(s)) {
+            return false;
+        }
+        *inexact = __builtin_fmaf(s, s, -f) != 0.0f;
+        *r = x87f_f_to_x80(s);
+        return true;
+    }
+}
+
+/* Ordered compare: -1, 0, 1. Only finite exact doubles (never NaN). */
+static inline bool x87f_compare(floatx80 a, floatx80 b, int *rel)
+{
+    double da, db;
+
+    if (!x87f_x80_to_d(a, &da) || !x87f_x80_to_d(b, &db)) {
+        return false;
+    }
+    *rel = da < db ? -1 : (da > db ? 1 : 0);
+    return true;
+}
+
+/* ---- loads / stores ---- */
+
+/* IEEE double -> x80, exact; normal or zero only (denormal/inf/nan: no). */
+static inline bool x87f_from_f64(uint64_t bits, floatx80 *r)
+{
+    uint32_t e = (bits >> 52) & 0x7ff;
+
+    if (e == 0x7ff || (e == 0 && (bits << 1) != 0)) {
+        return false;
+    }
+    r->high = (bits >> 48) & 0x8000;
+    if (e == 0) {
+        r->low = 0;
+    } else {
+        r->high |= e - 1023 + X87F_EXP_BIAS;
+        r->low = (1ULL << 63) | ((bits & 0xfffffffffffffULL) << 11);
+    }
+    return true;
+}
+
+static inline bool x87f_from_f32(uint32_t bits, floatx80 *r)
+{
+    uint32_t e = (bits >> 23) & 0xff;
+
+    if (e == 0xff || (e == 0 && (bits << 1) != 0)) {
+        return false;
+    }
+    r->high = (bits >> 16) & 0x8000;
+    if (e == 0) {
+        r->low = 0;
+    } else {
+        r->high |= e - 127 + X87F_EXP_BIAS;
+        r->low = (1ULL << 63) | ((uint64_t)(bits & 0x7fffff) << 40);
+    }
+    return true;
+}
+
+/* x80 -> IEEE double when exact (no rounding, no flags). */
+static inline bool x87f_to_f64(floatx80 a, uint64_t *bits)
+{
+    uint32_t e = a.high & 0x7fff;
+    uint64_t sign = (uint64_t)(a.high & 0x8000) << 48;
+
+    if (e == 0 && a.low == 0) {
+        *bits = sign;
+        return true;
+    }
+    if (e < X87F_EXP_BIAS - 1022 || e > X87F_EXP_BIAS + 1023) {
+        return false;
+    }
+    if (!(a.low >> 63) || (a.low & 0x7ff)) {
+        return false;
+    }
+    *bits = sign | ((uint64_t)(e - X87F_EXP_BIAS + 1023) << 52)
+          | ((a.low << 1) >> 12);
+    return true;
+}
+
+static inline bool x87f_to_f32(floatx80 a, uint32_t *bits)
+{
+    uint32_t e = a.high & 0x7fff;
+    uint32_t sign = (uint32_t)(a.high & 0x8000) << 16;
+
+    if (e == 0 && a.low == 0) {
+        *bits = sign;
+        return true;
+    }
+    if (e < X87F_EXP_BIAS - 126 || e > X87F_EXP_BIAS + 127) {
+        return false;
+    }
+    if (!(a.low >> 63) || (a.low & 0xffffffffffULL)) {
+        return false;
+    }
+    *bits = sign | ((e - X87F_EXP_BIAS + 127) << 23)
+          | (uint32_t)((a.low << 1) >> 41);
+    return true;
+}
+
+/* Integer -> x80, always exact. */
+static inline floatx80 x87f_from_i64(int64_t v)
+{
+    floatx80 r;
+    uint64_t m;
+    int s;
+
+    if (v == 0) {
+        r.high = 0;
+        r.low = 0;
+        return r;
+    }
+    m = v < 0 ? -(uint64_t)v : (uint64_t)v;
+    s = __builtin_clzll(m);
+    r.low = m << s;
+    r.high = (v < 0 ? 0x8000 : 0) | (X87F_EXP_BIAS + 63 - s);
+    return r;
+}
+
+/*
+ * x80 -> integer with rounding `rnd` (X87F_RND_*), accepted when the
+ * rounded value lies in [lo, hi). Out-of-range (the invalid case) and
+ * anything not an exact double fall back.
+ */
+static inline bool x87f_to_int(floatx80 a, int rnd, double lo, double hi,
+                               int64_t *out, bool *inexact)
+{
+    double d, r, t;
+
+    if (!x87f_x80_to_d(a, &d)) {
+        return false;
+    }
+    if (rnd == X87F_RND_NEAREST) {
+        if (__builtin_fabs(d) < 4503599627370496.0) {         /* 2^52 */
+            t = __builtin_copysign(4503599627370496.0, d);
+            r = (d + t) - t;                                   /* host RNE */
+        } else {
+            r = d;
+        }
+    } else {
+        if (!(__builtin_fabs(d) < 9223372036854775808.0)) {   /* 2^63 */
+            return false;
+        }
+        t = (double)(int64_t)d;                                /* trunc */
+        switch (rnd) {
+        case X87F_RND_DOWN:
+            r = t > d ? t - 1.0 : t;
+            break;
+        case X87F_RND_UP:
+            r = t < d ? t + 1.0 : t;
+            break;
+        default:
+            r = t;
+            break;
+        }
+    }
+    if (!(r >= lo && r < hi)) {
+        return false;
+    }
+    *out = (int64_t)r;
+    *inexact = r != d;
+    return true;
+}
+
+/* frndint: x80 -> integral x80, rounding `rnd`; exact doubles only. */
+static inline bool x87f_round_to_int(floatx80 a, int rnd, floatx80 *r,
+                                     bool *inexact)
+{
+    double d, t, v;
+
+    if (!x87f_x80_to_d(a, &d)) {
+        return false;
+    }
+    if (!(__builtin_fabs(d) < 4503599627370496.0)) {          /* 2^52 */
+        *r = a;                                                /* integral */
+        *inexact = false;
+        return true;
+    }
+    t = (double)(int64_t)d;
+    switch (rnd) {
+    case X87F_RND_NEAREST:
+        v = __builtin_copysign(4503599627370496.0, d);
+        t = (d + v) - v;
+        break;
+    case X87F_RND_DOWN:
+        t = t > d ? t - 1.0 : t;
+        break;
+    case X87F_RND_UP:
+        t = t < d ? t + 1.0 : t;
+        break;
+    default:
+        break;
+    }
+    /* keep the sign of zero: x87 rounds -0.3 to -0 */
+    t = __builtin_copysign(t, d);
+    *inexact = t != d;
+    *r = x87f_d_to_x80(t);
+    return true;
+}
+
+#endif /* I386_TCG_X87_FAST_H */
