 /* x87 FPU helpers */
 
+/*
+ * x87 fast path (x87-fast.h): host FPU for the common case, softfloat for
+ * the rest. Applicable when the guest runs at 53- or 24-bit precision with
+ * round-to-nearest; the -cpu property x87-fast=off disables it.
+ */
+static inline int x87_fast_prec(CPUX86State *env)
+{
+    if (!env_archcpu(env)->x87_fast) {
+        return -1;
+    }
+    if (env->fp_status.float_rounding_mode != float_round_nearest_even) {
+        return -1;
+    }
+    switch (env->fp_status.floatx80_rounding_precision) {
+    case floatx80_precision_d:
+        return X87F_PREC_D;
+    case floatx80_precision_s:
+        return X87F_PREC_S;
+    default:
+        return -1;
+    }
+}
+
+/*
+ * softfloat rounds float64 -> floatx80 conversions (fld m64, fadd m64, the
+ * host-libm transcendental results) to the precision-control width, so at
+ * 24-bit precision a double load is inexact there. Real hardware never
+ * rounds loads, but the fast path must stay indistinguishable from
+ * softfloat: keep exact double conversions only for 53/64-bit precision.
+ */
+static inline bool x87_fast_f64(CPUX86State *env)
+{
+    return env_archcpu(env)->x87_fast
+        && env->fp_status.floatx80_rounding_precision != floatx80_precision_s;
+}
+
+static inline int x87_fast_rnd(CPUX86State *env)
+{
+    /* FloatRoundMode nearest_even/down/up/to_zero = 0..3 = X87F_RND_* */
+    return env->fp_status.float_rounding_mode;
+}
+
+static inline floatx80 x87_binop(CPUX86State *env, int op,
+                                 floatx80 a, floatx80 b)
+{
+    int prec = x87_fast_prec(env);
+    floatx80 r;
+    bool inexact;
+
+    if (prec >= 0 && x87f_binop(op, prec, a, b, &r, &inexact)) {
+        if (inexact) {
+            float_raise(float_flag_inexact, &env->fp_status);
+        }
+        return r;
+    }
+    switch (op) {
+    case X87F_ADD:
+        return floatx80_add(a, b, &env->fp_status);
+    case X87F_SUB:
+        return floatx80_sub(a, b, &env->fp_status);
+    case X87F_MUL:
+        return floatx80_mul(a, b, &env->fp_status);
+    default:
+        return floatx80_div(a, b, &env->fp_status);
+    }
+}
+
+#define x87_add(env, a, b) x87_binop(env, X87F_ADD, a, b)
+#define x87_sub(env, a, b) x87_binop(env, X87F_SUB, a, b)
+#define x87_mul(env, a, b) x87_binop(env, X87F_MUL, a, b)
+#define x87_div(env, a, b) x87_binop(env, X87F_DIV, a, b)
+
