+     * times a second by a Windows guest (the vAPIC ROM's lock word, pool
+     * pages); each write used to pay two g_tree lookups and the walk.
+     */
+    uint16_t code_lo, code_hi;
+    /*
+     * Where TBs shared with a neighbouring page reach: span_in_end is one
+     * past the last byte covered by TBs that start on the previous page,
