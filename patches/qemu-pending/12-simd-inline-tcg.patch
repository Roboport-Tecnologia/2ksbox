+/*
+ * MMX / SSE integer and permutation instructions inline (doc 16, patch
+ * 08): the helper-call instructions that sit between the inlined float
+ * ops of D3DX code (shufps, unpck*ps) and the MMX kernels of era
+ * software renderers, blitters and codecs (punpck*, pack*, pmulhw,
+ * pmaddwd, pavg*, psadbw, shifts by a register count, pshufw), plus the
+ * per-instruction MMX entry (fpstt/fptags reset) as three stores.
+ *
+ * Everything works on 64-bit halves in i64 temps: an MMX register is one
+ * half, an XMM register two; the interleaves use bit spreading instead
+ * of per-lane loops, saturation uses smax/smin/umin per lane, psadbw
+ * uses the vector unit for the byte differences and a SWAR sum. Legacy
+ * encodings only (no VEX, no ymm), everything else stays on the helper.
+ * Integer ops have no flags and no modes, so the results are exact by
+ * construction; `-cpu ...,simd-fast=off` keeps the helpers for the
+ * on/off guest test (tools/sse-guest-test.py).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static bool simd_admissible(DisasContext *s, X86DecodedInsn *decode)
+{
+    return s->simd_on && !(s->prefix & PREFIX_VEX) && !s->vex_l;
+}
+
+/* env offset of 64-bit half i of a vector operand (MMX: i == 0 only) */
+static int simd_q(X86DecodedOp *op, int i)
+{
+    if (op->unit == X86_OP_MMX) {
+        tcg_debug_assert(i == 0);
+        return vector_reg_offset(op) + offsetof(MMXReg, MMX_Q(0));
+    }
+    return vector_reg_offset(op) + offsetof(ZMMReg, ZMM_Q(i));
+}
+
+static int simd_l(X86DecodedOp *op, int i)
+{
+    if (op->unit == X86_OP_MMX) {
+        return vector_reg_offset(op) + offsetof(MMXReg, MMX_L(i));
+    }
+    return vector_reg_offset(op) + offsetof(ZMMReg, ZMM_L(i));
+}
+
+/* MMX entry: top of stack 0, all tags valid (helper_enter_mmx inline) */
+static void gen_enter_mmx(DisasContext *s)
+{
+    TCGv_i32 zero = tcg_constant_i32(0);
+
+    tcg_gen_st_i32(zero, tcg_env, offsetof(CPUX86State, fpstt));
+    tcg_gen_st_i32(zero, tcg_env, offsetof(CPUX86State, fptags[0]));
+    tcg_gen_st_i32(zero, tcg_env, offsetof(CPUX86State, fptags[4]));
+}
+
+/* spread the low 32 bits of x into every other byte / word of a 64-bit word */
+static void simd_spread16(TCGv_i64 r, TCGv_i64 x)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+
+    tcg_gen_ext32u_i64(r, x);
+    tcg_gen_shli_i64(t, r, 16);
+    tcg_gen_or_i64(r, r, t);
+    tcg_gen_andi_i64(r, r, 0x0000ffff0000ffffull);
+}
+
+static void simd_spread8(TCGv_i64 r, TCGv_i64 x)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+
+    simd_spread16(r, x);
+    tcg_gen_shli_i64(t, r, 8);
+    tcg_gen_or_i64(r, r, t);
+    tcg_gen_andi_i64(r, r, 0x00ff00ff00ff00ffull);
+}
+
+/*
+ * r = interleave of the low (hi == false) or high 32 bits of a and b,
+ * elements of 8 << esz bits (esz 0..2).
+ */
+static void simd_unpck_half(TCGv_i64 r, TCGv_i64 a, TCGv_i64 b, int esz, bool hi)
+{
+    TCGv_i64 ta = tcg_temp_new_i64();
+    TCGv_i64 tb = tcg_temp_new_i64();
+
+    if (hi) {
+        tcg_gen_shri_i64(ta, a, 32);
+        tcg_gen_shri_i64(tb, b, 32);
+        a = ta;
+        b = tb;
+    }
+    switch (esz) {
+    case 0:
+        simd_spread8(ta, a);
+        simd_spread8(tb, b);
+        tcg_gen_shli_i64(tb, tb, 8);
+        break;
+    case 1:
+        simd_spread16(ta, a);
+        simd_spread16(tb, b);
+        tcg_gen_shli_i64(tb, tb, 16);
+        break;
+    case 2:
+        tcg_gen_ext32u_i64(ta, a);
+        tcg_gen_shli_i64(tb, b, 32);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    tcg_gen_or_i64(r, ta, tb);
+}
+
+
+/* ------------------------------------------------------------------ */
+/* byte-permute tables for tbl_vec (env->simd_tbl, see cpu.h layout)     */
+
+/*
+ * Entry layout: 16 index bytes, 0x80 = zero lane. For two-source
+ * permutes three entries: [0] the lanes taken from v (others 0x80),
+ * [1] the lanes taken from s, [2] both from one register (v == s).
+ */
+static void simd_tbl_entry(uint8_t *e, const int8_t *lane_src, const uint8_t *lane_idx,
+                           int nlanes, int lane_bytes)
+{
+    int which, l, k;
+
+    for (which = 0; which < 3; which++) {
+        for (l = 0; l < nlanes; l++) {
+            for (k = 0; k < lane_bytes; k++) {
+                bool take = which == 2 || lane_src[l] == which;
+                e[which * 16 + l * lane_bytes + k] = take ? lane_idx[l] * lane_bytes + k : 0x80;
+            }
+        }
+        for (l = nlanes * lane_bytes; l < 16; l++) {
+            e[which * 16 + l] = 0x80;
+        }
+    }
+}
+
+void x86_simd_tables_init(CPUX86State *env)
+{
+    uint8_t *t = env->simd_tbl;
+    int imm, esz, hi, w, l;
+    int8_t src[16];
+    uint8_t idx[16];
+
+    for (imm = 0; imm < 256; imm++) {           /* shufps: v[i0] v[i1] s[i2] s[i3] */
+        for (l = 0; l < 4; l++) {
+            src[l] = l < 2 ? 0 : 1;
+            idx[l] = (imm >> (2 * l)) & 3;
+        }
+        simd_tbl_entry(t + SIMD_TBL_SHUFPS + imm * 48, src, idx, 4, 4);
+    }
+    for (imm = 0; imm < 4; imm++) {             /* shufpd: v[i0] s[i1] */
+        src[0] = 0; src[1] = 1;
+        idx[0] = imm & 1; idx[1] = (imm >> 1) & 1;
+        simd_tbl_entry(t + SIMD_TBL_SHUFPD + imm * 48, src, idx, 2, 8);
+    }
+    for (esz = 0; esz < 3; esz++) {             /* punpck{l,h}{bw,wd,dq}, 8- and 16-byte */
+        for (hi = 0; hi < 2; hi++) {
+            for (w = 0; w < 2; w++) {
+                int bytes = w ? 16 : 8, eb = 1 << esz, n = bytes / eb;
+                for (l = 0; l < n; l++) {
+                    src[l] = l & 1;
+                    idx[l] = (hi ? n / 2 : 0) + l / 2;
+                }
+                simd_tbl_entry(t + SIMD_TBL_UNPCK + ((esz * 2 + hi) * 2 + w) * 48, src, idx, n, eb);
+            }
+        }
+    }
+    for (imm = 0; imm < 256; imm++) {           /* pshufw: 4 words from one source */
+        uint8_t *e = t + SIMD_TBL_PSHUFW + imm * 16;
+        for (l = 0; l < 4; l++) {
+            e[2 * l] = ((imm >> (2 * l)) & 3) * 2;
+            e[2 * l + 1] = e[2 * l] + 1;
+        }
+        for (l = 8; l < 16; l++) {
+            e[l] = 0x80;
+        }
+    }
+    {                                            /* bitsel mask: lane0 all-1, lane1 all-0 */
+        uint8_t *e = t + SIMD_TBL_MASK64LO;
+        for (l = 0; l < 8; l++) {
+            e[l] = 0xff;
+        }
+        for (l = 8; l < 16; l++) {
+            e[l] = 0x00;
+        }
+    }
+}
+
+/*
+ * d = permute(v, s) by the three-entry table at `tbl` (env offset), on
+ * the vector unit: one lookup when both sources are the same register,
+ * two lookups and an OR otherwise. MMX operands are 8-byte vectors.
+ */
+static void simd_tbl_permute(DisasContext *s, X86DecodedInsn *decode, int tbl)
+{
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+    TCGType type = mmx ? TCG_TYPE_V64 : TCG_TYPE_V128;
+    int d = vector_reg_offset(&decode->op[0]);
+    int v = vector_reg_offset(&decode->op[1]);
+    int src = vector_reg_offset(&decode->op[2]);
+    TCGv_vec a = tcg_temp_new_vec(type);
+    TCGv_vec idx = tcg_temp_new_vec(type);
+    TCGv_vec r = tcg_temp_new_vec(type);
+
+    tcg_gen_ld_vec(a, tcg_env, v);
+    if (v == src) {
+        tcg_gen_ld_vec(idx, tcg_env, tbl + 32);
+        tcg_gen_tbl_vec(r, a, idx);
+    } else {
+        TCGv_vec b = tcg_temp_new_vec(type);
+        TCGv_vec t = tcg_temp_new_vec(type);
+
+        tcg_gen_ld_vec(b, tcg_env, src);
+        tcg_gen_ld_vec(idx, tcg_env, tbl);
+        tcg_gen_tbl_vec(r, a, idx);
+        tcg_gen_ld_vec(idx, tcg_env, tbl + 16);
+        tcg_gen_tbl_vec(t, b, idx);
+        tcg_gen_or_vec(MO_8, r, r, t);
+    }
+    tcg_gen_st_vec(r, tcg_env, d);
+    tcg_temp_free_vec(a);
+    tcg_temp_free_vec(idx);
+    tcg_temp_free_vec(r);
+}
+
+/* punpck{l,h}{bw,wd,dq}: MMX one half; XMM: low/high 64 bits of each source */
+static void simd_unpck(DisasContext *s, X86DecodedInsn *decode, int esz, bool hi)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 r0 = tcg_temp_new_i64();
+    TCGv_i64 r1 = tcg_temp_new_i64();
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+
+    if (tcg_tbl_vec_supported()) {
+        simd_tbl_permute(s, decode, offsetof(CPUX86State, simd_tbl)
+                         + SIMD_TBL_UNPCK + ((esz * 2 + hi) * 2 + !mmx) * 48);
+        return;
+    }
+    if (mmx) {
+        tcg_gen_ld_i64(a, tcg_env, simd_q(&decode->op[1], 0));
+        tcg_gen_ld_i64(b, tcg_env, simd_q(&decode->op[2], 0));
+        simd_unpck_half(r0, a, b, esz, hi);
+        tcg_gen_st_i64(r0, tcg_env, simd_q(&decode->op[0], 0));
+        return;
+    }
+    tcg_gen_ld_i64(a, tcg_env, simd_q(&decode->op[1], hi));
+    tcg_gen_ld_i64(b, tcg_env, simd_q(&decode->op[2], hi));
+    simd_unpck_half(r0, a, b, esz, false);
+    simd_unpck_half(r1, a, b, esz, true);
+    tcg_gen_st_i64(r0, tcg_env, simd_q(&decode->op[0], 0));
+    tcg_gen_st_i64(r1, tcg_env, simd_q(&decode->op[0], 1));
+}
+
+/* punpck{l,h}qdq: d = { v.Q(hi), s.Q(hi) } */
+static void simd_unpck_qdq(DisasContext *s, X86DecodedInsn *decode, bool hi)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+
+    tcg_gen_ld_i64(a, tcg_env, simd_q(&decode->op[1], hi));
+    tcg_gen_ld_i64(b, tcg_env, simd_q(&decode->op[2], hi));
+    tcg_gen_st_i64(a, tcg_env, simd_q(&decode->op[0], 0));
+    tcg_gen_st_i64(b, tcg_env, simd_q(&decode->op[0], 1));
+}
+
+/*
+ * Saturating pack of one 64-bit source half: 4 words -> 4 bytes at bit
+ * offset `dst_ofs` of r (kind 0 packsswb, 1 packuswb), or 2 dwords -> 2
+ * words (kind 2 packssdw). r accumulates (must start at 0).
+ */
+static void simd_pack_half(TCGv_i64 r, TCGv_i64 x, int kind, int dst_ofs)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    int n = kind == 2 ? 2 : 4;
+    int in_bits = kind == 2 ? 32 : 16;
+    int out_bits = kind == 2 ? 16 : 8;
+    int i;
+
+    for (i = 0; i < n; i++) {
+        tcg_gen_sextract_i64(t, x, i * in_bits, in_bits);
+        switch (kind) {
+        case 0:
+            tcg_gen_smax_i64(t, t, tcg_constant_i64(-128));
+            tcg_gen_smin_i64(t, t, tcg_constant_i64(127));
+            break;
+        case 1:
+            tcg_gen_smax_i64(t, t, tcg_constant_i64(0));
+            tcg_gen_umin_i64(t, t, tcg_constant_i64(255));
+            break;
+        case 2:
+            tcg_gen_smax_i64(t, t, tcg_constant_i64(-32768));
+            tcg_gen_smin_i64(t, t, tcg_constant_i64(32767));
+            break;
+        }
+        tcg_gen_deposit_i64(r, r, t, dst_ofs + i * out_bits, out_bits);
+    }
+}
+
+/* packsswb / packuswb / packssdw: MMX d = { pack(v), pack(s) }; XMM per source */
+static void simd_pack(DisasContext *s, X86DecodedInsn *decode, int kind)
+{
+    TCGv_i64 x = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+
+    if (mmx) {
+        tcg_gen_movi_i64(r, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[1], 0));
+        simd_pack_half(r, x, kind, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[2], 0));
+        simd_pack_half(r, x, kind, 32);
+        tcg_gen_st_i64(r, tcg_env, simd_q(&decode->op[0], 0));
+        return;
+    }
+    /* d.Q0 = pack(v.Q0, v.Q1), d.Q1 = pack(s.Q0, s.Q1): read s before writing d */
+    {
+        TCGv_i64 r1 = tcg_temp_new_i64();
+
+        tcg_gen_movi_i64(r1, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[2], 0));
+        simd_pack_half(r1, x, kind, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[2], 1));
+        simd_pack_half(r1, x, kind, 32);
+        tcg_gen_movi_i64(r, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[1], 0));
+        simd_pack_half(r, x, kind, 0);
+        tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[1], 1));
+        simd_pack_half(r, x, kind, 32);
+        tcg_gen_st_i64(r, tcg_env, simd_q(&decode->op[0], 0));
+        tcg_gen_st_i64(r1, tcg_env, simd_q(&decode->op[0], 1));
+    }
+}
+
+/*
+ * packsswb / packuswb / packssdw on the vector unit. kind: 0 packsswb,
+ * 1 packuswb, 2 packssdw. Only when tcg_narrow_vec_supported().
+ *
+ * XMM: the 128-bit PACKSSWB/PACKUSWB/PACKSSDW's own semantics already
+ * match ours exactly (dest low 64 = pack(all of v's lanes), dest high
+ * 64 = pack(all of s's lanes)) -- no read-before-write hazard either,
+ * a/b are fully loaded before r is stored.
+ *
+ * MMX: NOT the same instruction restricted to 64 bits -- the native
+ * legacy MMX pack (dest = v's 4 lanes packed low, s's 4 lanes packed
+ * high, one 64-bit result) has no direct 128-bit equivalent, since a
+ * 128-bit pack's low 64 bits come from *all 8* of src1's lanes, not a
+ * 4+4 split. Get there by building one combined 128-bit register (v's
+ * bits in lane 0, s's in lane 1) and packing it against itself:
+ * dest_low = pack(v0..v3, s0..s3) is exactly the MMX result, dest_high
+ * (a redundant duplicate) is simply not stored.
+ *
+ * Building that combined register through env->sses_scratch (store both
+ * halves, reload as one vector) cost as much as the helper it replaces:
+ * two GP stores immediately reloaded by a differently-sized vector load
+ * is a textbook store-to-load-forwarding stall. dup_i64_vec each half
+ * across a whole register instead (broadcast, no memory round trip) and
+ * bitsel_vec the two together against a constant lane mask
+ * (SIMD_TBL_MASK64LO): one memory read (the mask, shared by every pack
+ * here) instead of two round-tripped stores plus a reload.
+ */
+static void simd_pack_vec(DisasContext *s, X86DecodedInsn *decode, int kind)
+{
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+    unsigned vece = kind == 2 ? MO_32 : MO_16;
+
+    if (mmx) {
+        TCGv_i64 t = tcg_temp_new_i64();
+        TCGv_vec va = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec vb = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec mask = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec ab = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec r = tcg_temp_new_vec(TCG_TYPE_V128);
+
+        tcg_gen_ld_i64(t, tcg_env, simd_q(&decode->op[1], 0));
+        tcg_gen_dup_i64_vec(MO_64, va, t);
+        tcg_gen_ld_i64(t, tcg_env, simd_q(&decode->op[2], 0));
+        tcg_gen_dup_i64_vec(MO_64, vb, t);
+        tcg_gen_ld_vec(mask, tcg_env, offsetof(CPUX86State, simd_tbl) + SIMD_TBL_MASK64LO);
+        tcg_gen_bitsel_vec(MO_64, ab, mask, va, vb);
+        if (kind == 1) {
+            tcg_gen_usnarrow_vec(vece, r, ab, ab);
+        } else {
+            tcg_gen_ssnarrow_vec(vece, r, ab, ab);
+        }
+        tcg_gen_stl_vec(r, tcg_env, vector_reg_offset(&decode->op[0]), TCG_TYPE_V64);
+        tcg_temp_free_vec(va);
+        tcg_temp_free_vec(vb);
+        tcg_temp_free_vec(mask);
+        tcg_temp_free_vec(ab);
+        tcg_temp_free_vec(r);
+        return;
+    }
+
+    {
+        TCGv_vec a = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec b = tcg_temp_new_vec(TCG_TYPE_V128);
+        TCGv_vec r = tcg_temp_new_vec(TCG_TYPE_V128);
+
+        tcg_gen_ld_vec(a, tcg_env, vector_reg_offset(&decode->op[1]));
+        tcg_gen_ld_vec(b, tcg_env, vector_reg_offset(&decode->op[2]));
+        if (kind == 1) {
+            tcg_gen_usnarrow_vec(vece, r, a, b);
+        } else {
+            tcg_gen_ssnarrow_vec(vece, r, a, b);
+        }
+        tcg_gen_st_vec(r, tcg_env, vector_reg_offset(&decode->op[0]));
+        tcg_temp_free_vec(a);
+        tcg_temp_free_vec(b);
+        tcg_temp_free_vec(r);
+    }
+}
+
+/* pmulhw / pmulhuw on the vector unit; only when tcg_mulh_vec_supported() */
+static void simd_mulh_vec(DisasContext *s, X86DecodedInsn *decode, bool uns)
+{
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+    TCGType type = mmx ? TCG_TYPE_V64 : TCG_TYPE_V128;
+    TCGv_vec a = tcg_temp_new_vec(type);
+    TCGv_vec b = tcg_temp_new_vec(type);
+    TCGv_vec r = tcg_temp_new_vec(type);
+
+    tcg_gen_ld_vec(a, tcg_env, vector_reg_offset(&decode->op[1]));
+    tcg_gen_ld_vec(b, tcg_env, vector_reg_offset(&decode->op[2]));
+    if (uns) {
+        tcg_gen_muluh_vec(MO_16, r, a, b);
+    } else {
+        tcg_gen_mulsh_vec(MO_16, r, a, b);
+    }
+    tcg_gen_st_vec(r, tcg_env, vector_reg_offset(&decode->op[0]));
+    tcg_temp_free_vec(a);
+    tcg_temp_free_vec(b);
+    tcg_temp_free_vec(r);
+}
+
+/* one 64-bit half of pmulhw / pmulhuw / pmaddwd / pavgb / pavgw */
+static void simd_arith_half(TCGv_i64 r, TCGv_i64 a, TCGv_i64 b, int op)
+{
+    TCGv_i64 ta = tcg_temp_new_i64();
+    TCGv_i64 tb = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    int i;
+
+    switch (op) {
+    case SIMD_PMULHW:
+    case SIMD_PMULHUW:
+        tcg_gen_movi_i64(r, 0);
+        for (i = 0; i < 4; i++) {
+            if (op == SIMD_PMULHW) {
+                tcg_gen_sextract_i64(ta, a, 16 * i, 16);
+                tcg_gen_sextract_i64(tb, b, 16 * i, 16);
+            } else {
+                tcg_gen_extract_i64(ta, a, 16 * i, 16);
+                tcg_gen_extract_i64(tb, b, 16 * i, 16);
+            }
+            tcg_gen_mul_i64(t, ta, tb);
+            tcg_gen_shri_i64(t, t, 16);
+            tcg_gen_deposit_i64(r, r, t, 16 * i, 16);
+        }
+        break;
+    case SIMD_PMADDWD:
+        tcg_gen_movi_i64(r, 0);
+        for (i = 0; i < 2; i++) {
+            TCGv_i64 t2 = tcg_temp_new_i64();
+
+            tcg_gen_sextract_i64(ta, a, 32 * i, 16);
+            tcg_gen_sextract_i64(tb, b, 32 * i, 16);
+            tcg_gen_mul_i64(t, ta, tb);
+            tcg_gen_sextract_i64(ta, a, 32 * i + 16, 16);
+            tcg_gen_sextract_i64(tb, b, 32 * i + 16, 16);
+            tcg_gen_mul_i64(t2, ta, tb);
+            tcg_gen_add_i64(t, t, t2);
+            tcg_gen_deposit_i64(r, r, t, 32 * i, 32);
+        }
+        break;
+    case SIMD_PAVGB:
+    case SIMD_PAVGW:
+        /* (a + b + 1) >> 1 == (a | b) - ((a ^ b) >> 1), lane-wise */
+        tcg_gen_xor_i64(t, a, b);
+        tcg_gen_shri_i64(t, t, 1);
+        tcg_gen_andi_i64(t, t, op == SIMD_PAVGB ? 0x7f7f7f7f7f7f7f7full
+                                                : 0x7fff7fff7fff7fffull);
+        tcg_gen_or_i64(r, a, b);
+        tcg_gen_sub_i64(r, r, t);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static void simd_arith(DisasContext *s, X86DecodedInsn *decode, int op)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    int halves = decode->op[0].unit == X86_OP_MMX ? 1 : 2;
+    int i;
+
+    for (i = 0; i < halves; i++) {
+        tcg_gen_ld_i64(a, tcg_env, simd_q(&decode->op[1], i));
+        tcg_gen_ld_i64(b, tcg_env, simd_q(&decode->op[2], i));
+        simd_arith_half(r, a, b, op);
+        tcg_gen_st_i64(r, tcg_env, simd_q(&decode->op[0], i));
+    }
+}
+
+/*
+ * psadbw: per 64-bit half, the sum of the 8 absolute byte differences
+ * into the low 16 bits. The differences on the vector unit (umax - umin
+ * per byte, register-only like simd_tbl_permute, not the memory-based
+ * gvec_umax/umin/sub: those cost more than the helper call they replace
+ * at this width), the horizontal sum in SWAR on the 64-bit word.
+ */
+static void simd_psadbw(DisasContext *s, X86DecodedInsn *decode)
+{
+    bool mmx = decode->op[0].unit == X86_OP_MMX;
+    TCGType type = mmx ? TCG_TYPE_V64 : TCG_TYPE_V128;
+    int scratch = offsetof(CPUX86State, sses_scratch[0]);
+    TCGv_vec va = tcg_temp_new_vec(type);
+    TCGv_vec vb = tcg_temp_new_vec(type);
+    TCGv_vec vmax = tcg_temp_new_vec(type);
+    TCGv_vec vmin = tcg_temp_new_vec(type);
+    TCGv_i64 x = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    int i;
+
+    /* scratch = umax(v, s) - umin(v, s), bytes */
+    tcg_gen_ld_vec(va, tcg_env, vector_reg_offset(&decode->op[1]));
+    tcg_gen_ld_vec(vb, tcg_env, vector_reg_offset(&decode->op[2]));
+    tcg_gen_umax_vec(MO_8, vmax, va, vb);
+    tcg_gen_umin_vec(MO_8, vmin, va, vb);
+    tcg_gen_sub_vec(MO_8, vmax, vmax, vmin);
+    tcg_gen_st_vec(vmax, tcg_env, scratch);
+    tcg_temp_free_vec(va);
+    tcg_temp_free_vec(vb);
+    tcg_temp_free_vec(vmax);
+    tcg_temp_free_vec(vmin);
+    for (i = 0; i < (mmx ? 1 : 2); i++) {
+        tcg_gen_ld_i64(x, tcg_env, scratch + 8 * i);
+        /* pairwise byte sums: no carry can cross a lane (max 255 + 255) */
+        tcg_gen_shri_i64(t, x, 8);
+        tcg_gen_andi_i64(t, t, 0x00ff00ff00ff00ffull);
+        tcg_gen_andi_i64(x, x, 0x00ff00ff00ff00ffull);
+        tcg_gen_add_i64(x, x, t);
+        tcg_gen_shri_i64(t, x, 16);
+        tcg_gen_add_i64(x, x, t);
+        tcg_gen_shri_i64(t, x, 32);
+        tcg_gen_add_i64(x, x, t);
+        tcg_gen_andi_i64(x, x, 0xffff);
+        tcg_gen_st_i64(x, tcg_env, simd_q(&decode->op[0], i));
+    }
+}
+
+/*
+ * Shifts by the count in the low quadword of op[2]: counts beyond the
+ * element width give zero (logical) or a full sign fill (arithmetic).
+ */
+static void simd_shift(DisasContext *s, X86DecodedInsn *decode, int op)
+{
+    static const struct { unsigned vece; bool left, arith; } tab[] = {
+        [SIMD_PSLLW] = { MO_16, true, false }, [SIMD_PSLLD] = { MO_32, true, false },
+        [SIMD_PSLLQ] = { MO_64, true, false }, [SIMD_PSRLW] = { MO_16, false, false },
+        [SIMD_PSRLD] = { MO_32, false, false }, [SIMD_PSRLQ] = { MO_64, false, false },
+        [SIMD_PSRAW] = { MO_16, false, true }, [SIMD_PSRAD] = { MO_32, false, true },
+    };
+    unsigned vece = tab[op].vece;
+    int bits = 8 << vece;
+    int len = decode->op[0].unit == X86_OP_MMX ? 8 : 16;
+    int dofs = vector_reg_offset(&decode->op[0]);
+    int aofs = vector_reg_offset(&decode->op[1]);
+    TCGv_i64 count = tcg_temp_new_i64();
+    TCGv_i64 sh = tcg_temp_new_i64();
+    TCGv_i64 mask = tcg_temp_new_i64();
+    TCGv_i32 sh32 = tcg_temp_new_i32();
+
+    tcg_gen_ld_i64(count, tcg_env, simd_q(&decode->op[2], 0));
+    tcg_gen_umin_i64(sh, count, tcg_constant_i64(bits - 1));
+    tcg_gen_extrl_i64_i32(sh32, sh);
+    if (tab[op].left) {
+        tcg_gen_gvec_shls(vece, dofs, aofs, sh32, len, len);
+    } else if (tab[op].arith) {
+        tcg_gen_gvec_sars(vece, dofs, aofs, sh32, len, len);
+    } else {
+        tcg_gen_gvec_shrs(vece, dofs, aofs, sh32, len, len);
+    }
+    if (!tab[op].arith) {
+        /* count > bits - 1: zero (the shift above was by bits - 1) */
+        tcg_gen_setcondi_i64(TCG_COND_LEU, mask, count, bits - 1);
+        tcg_gen_neg_i64(mask, mask);
+        tcg_gen_gvec_ands(MO_64, dofs, dofs, mask, len, len);
+    }
+}
+
+/* shufps: d = { v[i0], v[i1], s[i2], s[i3] }; shufpd: d = { v[i0], s[i1] } */
+static void simd_shuf(DisasContext *s, X86DecodedInsn *decode, bool pd)
+{
+    int imm = decode->immediate & 0xff;     /* the decoder sign-extends Ib */
+
+    if (tcg_tbl_vec_supported()) {
+        simd_tbl_permute(s, decode, offsetof(CPUX86State, simd_tbl)
+                         + (pd ? SIMD_TBL_SHUFPD + (imm & 3) * 48 : SIMD_TBL_SHUFPS + imm * 48));
+        return;
+    }
+    if (pd) {
+        TCGv_i64 a = tcg_temp_new_i64();
+        TCGv_i64 b = tcg_temp_new_i64();
+
+        tcg_gen_ld_i64(a, tcg_env, simd_q(&decode->op[1], imm & 1));
+        tcg_gen_ld_i64(b, tcg_env, simd_q(&decode->op[2], (imm >> 1) & 1));
+        tcg_gen_st_i64(a, tcg_env, simd_q(&decode->op[0], 0));
+        tcg_gen_st_i64(b, tcg_env, simd_q(&decode->op[0], 1));
+    } else {
+        TCGv_i32 r[4];
+        int i;
+
+        for (i = 0; i < 4; i++) {
+            r[i] = tcg_temp_new_i32();
+            tcg_gen_ld_i32(r[i], tcg_env,
+                           simd_l(&decode->op[i < 2 ? 1 : 2], (imm >> (2 * i)) & 3));
+        }
+        for (i = 0; i < 4; i++) {
+            tcg_gen_st_i32(r[i], tcg_env, simd_l(&decode->op[0], i));
+        }
+    }
+}
+
+/* pshufw mm, mm/m64, imm: four word selects */
+static void simd_pshufw(DisasContext *s, X86DecodedInsn *decode)
+{
+    int imm = decode->immediate & 0xff;
+    TCGv_i64 x = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv_i64 r = tcg_temp_new_i64();
+    int i;
+
+    if (tcg_tbl_vec_supported()) {
+        TCGv_vec a = tcg_temp_new_vec(TCG_TYPE_V64);
+        TCGv_vec idx = tcg_temp_new_vec(TCG_TYPE_V64);
+
+        tcg_gen_ld_vec(a, tcg_env, vector_reg_offset(&decode->op[1]));
+        tcg_gen_ld_vec(idx, tcg_env, offsetof(CPUX86State, simd_tbl) + SIMD_TBL_PSHUFW + imm * 16);
+        tcg_gen_tbl_vec(a, a, idx);
+        tcg_gen_st_vec(a, tcg_env, vector_reg_offset(&decode->op[0]));
+        return;
+    }
+    tcg_gen_ld_i64(x, tcg_env, simd_q(&decode->op[1], 0));
+    tcg_gen_movi_i64(r, 0);
+    for (i = 0; i < 4; i++) {
+        tcg_gen_extract_i64(t, x, 16 * ((imm >> (2 * i)) & 3), 16);
+        tcg_gen_deposit_i64(r, r, t, 16 * i, 16);
+    }
+    tcg_gen_st_i64(r, tcg_env, simd_q(&decode->op[0], 0));
+}
+
+/* ------------------------------------------------------------------ */
+/* entry points for emit.c.inc (return false: emit the helper)          */
+
+static bool simd_int_binary(DisasContext *s, X86DecodedInsn *decode, int op)
+{
+    if (op == SIMD_NONE || !simd_admissible(s, decode)) {
+        return false;
+    }
+    switch (op) {
+    case SIMD_PUNPCKLBW: simd_unpck(s, decode, 0, false); break;
+    case SIMD_PUNPCKLWD: simd_unpck(s, decode, 1, false); break;
+    case SIMD_PUNPCKLDQ: simd_unpck(s, decode, 2, false); break;
+    case SIMD_PUNPCKHBW: simd_unpck(s, decode, 0, true); break;
+    case SIMD_PUNPCKHWD: simd_unpck(s, decode, 1, true); break;
+    case SIMD_PUNPCKHDQ: simd_unpck(s, decode, 2, true); break;
+    case SIMD_PUNPCKLQDQ: simd_unpck_qdq(s, decode, false); break;
+    case SIMD_PUNPCKHQDQ: simd_unpck_qdq(s, decode, true); break;
+    case SIMD_PACKSSWB:
+        if (tcg_narrow_vec_supported(MO_16, false)) {
+            simd_pack_vec(s, decode, 0);
+        } else {
+            simd_pack(s, decode, 0);
+        }
+        break;
+    case SIMD_PACKUSWB:
+        if (tcg_narrow_vec_supported(MO_16, true)) {
+            simd_pack_vec(s, decode, 1);
+        } else {
+            simd_pack(s, decode, 1);
+        }
+        break;
+    case SIMD_PACKSSDW:
+        if (tcg_narrow_vec_supported(MO_32, false)) {
+            simd_pack_vec(s, decode, 2);
+        } else {
+            simd_pack(s, decode, 2);
+        }
+        break;
+    case SIMD_PMULHW:
+        if (tcg_mulh_vec_supported(MO_16)) {
+            simd_mulh_vec(s, decode, false);
+        } else {
+            simd_arith(s, decode, op);
+        }
+        break;
+    case SIMD_PMULHUW:
+        if (tcg_mulh_vec_supported(MO_16)) {
+            simd_mulh_vec(s, decode, true);
+        } else {
+            simd_arith(s, decode, op);
+        }
+        break;
+    case SIMD_PMADDWD:
+    case SIMD_PAVGB:
+    case SIMD_PAVGW:
+        simd_arith(s, decode, op);
+        break;
+    case SIMD_PSADBW: simd_psadbw(s, decode); break;
+    case SIMD_PSLLW: case SIMD_PSLLD: case SIMD_PSLLQ:
+    case SIMD_PSRLW: case SIMD_PSRLD: case SIMD_PSRLQ:
+    case SIMD_PSRAW: case SIMD_PSRAD:
+        simd_shift(s, decode, op);
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+/* unpcklps / unpckhps / unpcklpd / unpckhpd (the FP_UNPACK_SSE forms) */
+static bool simd_fp_unpck(DisasContext *s, X86DecodedInsn *decode, bool hi)
+{
+    if (!simd_admissible(s, decode)) {
+        return false;
+    }
+    if (s->prefix & PREFIX_DATA) {
+        simd_unpck_qdq(s, decode, hi);
+    } else {
+        simd_unpck(s, decode, 2, hi);
+    }
+    return true;
+}
+
+static bool simd_shufp(DisasContext *s, X86DecodedInsn *decode)
+{
+    if (!simd_admissible(s, decode)) {
+        return false;
+    }
+    simd_shuf(s, decode, (s->prefix & PREFIX_DATA) != 0);
+    return true;
+}
+
+static bool simd_pshufw_insn(DisasContext *s, X86DecodedInsn *decode)
+{
+    if (!simd_admissible(s, decode)) {
+        return false;
+    }
+    simd_pshufw(s, decode);
+    return true;
+}
