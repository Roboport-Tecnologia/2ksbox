+#undef FPW
+#undef CONSTW
+#undef LANEFN
+#undef LANE
+#undef NAN_LIMIT
+#undef EXP_MASK
+#undef EXP_LO
+#undef EXP_RANGE
+#undef ONE_BITS
+#undef TO_I32
+#undef W
