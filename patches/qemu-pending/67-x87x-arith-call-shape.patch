diff --git a/target/i386/tcg/x87-fast.h b/target/i386/tcg/x87-fast.h
--- a/target/i386/tcg/x87-fast.h
+++ b/target/i386/tcg/x87-fast.h
@@ -393,6 +393,25 @@
     return x87f_pack_x(sx, ex, (uint64_t)(S >> 64), (uint64_t)S, r, inexact);
 }
 
+/*
+ * (n1:n0) / d when n1 < d, so the quotient fits in 64 bits. QEMU passes
+ * udiv_qrnnd (fpu_helper.c): one divq on x86-64. The portable division
+ * below is a call to libgcc's __udivti3, a whole 128-bit division, and
+ * under the Windows x64 ABI it takes its operands through memory -- 4 % of
+ * an x87-heavy guest's vCPU there against 1.75 % on Linux (2026-09-17).
+ */
+#ifndef X87F_UDIV128
+static inline uint64_t x87f_udiv128(uint64_t *rem, uint64_t n1, uint64_t n0, uint64_t d)
+{
+    unsigned __int128 n = ((unsigned __int128)n1 << 64) | n0;
+    uint64_t q = (uint64_t)(n / d);
+
+    *rem = (uint64_t)(n - (unsigned __int128)q * d);
+    return q;
+}
+#define X87F_UDIV128 x87f_udiv128
+#endif
+
 static inline bool x87f_div_x(floatx80 a, floatx80 b, floatx80 *r, bool *inexact)
 {
     uint32_t sign = (a.high ^ b.high) & 0x8000;
@@ -416,8 +435,7 @@
         n = (unsigned __int128)a.low << 64;
         e--;
     }
-    q = (uint64_t)(n / b.low);
-    rem = (uint64_t)(n - (unsigned __int128)q * b.low);
+    q = X87F_UDIV128(&rem, (uint64_t)(n >> 64), (uint64_t)n, b.low);   /* n < b.low << 64 */
     /* the remainder against half the divisor, as a `rest` for the rounding */
     rest = rem == 0 ? 0 : rem > b.low - rem ? (1ULL << 63) + 1 : rem == b.low - rem ? 1ULL << 63 : 1;
     return x87f_pack_x(sign, e, q, rest, r, inexact);
