+/*
+ * Reserve the code buffer's address space next to the helpers, at load
+ * time, before anything else fragments the region.
+ *
+ * The backends emit a direct call only when the target is close (aarch64
+ * BL: 128 MiB; x86-64 CALL rel32: 2 GiB) and a PC-relative address within
+ * 4 GiB (ADRP+ADD); beyond that every helper call and every host address a
+ * TB materialises is a 4-5 instruction sequence.  mmap(NULL) at TCG init
+ * time does not care: on macOS/arm64 the 1 GiB buffer landed 8 GiB from
+ * the text in about a third of launches, whenever the guest RAM and the
+ * libraries had already fragmented the space below the shared cache, and
+ * those launches ran helper-heavy guest code 35-45 % slower (2ksbox docs/22
+ * §5.0).  A constructor runs before main(), so the space is still free:
+ * take a PROT_NONE MAP_JIT reservation within 2 GiB of this image and hand
+ * it to alloc_code_gen_buffer_anon(), which would have asked for exactly
+ * that mapping.
+ */
+static void *jit_reserve;
+static size_t jit_reserve_size;
+
+static void __attribute__((constructor)) jit_reserve_near_helpers(void)
+{
+    const uintptr_t anchor = (uintptr_t)&jit_reserve_near_helpers;
+    const uintptr_t align = 64 * MiB;
+    /* 1 GiB is DEFAULT_CODE_GEN_BUFFER_SIZE on 64-bit hosts; a quarter of
+     * it is more than these guests translate between flushes, and a
+     * smaller window fits where a 1 GiB one does not */
+    static const size_t sizes[] = { 1 * GiB, 512 * MiB, 256 * MiB };
+    const int flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT;
+
+    for (size_t si = 0; si < ARRAY_SIZE(sizes); si++) {
+        const size_t size = sizes[si];
+        const intptr_t reach = 2 * (intptr_t)GiB - (intptr_t)size;
+        for (intptr_t off = (intptr_t)align; off < reach; off += (intptr_t)align) {
+            uintptr_t hint = QEMU_ALIGN_UP(anchor + off, align);
+            void *try = mmap((void *)hint, size, PROT_NONE, flags, -1, 0);
+            intptr_t d;
+            if (getenv("QEMU_JIT_DEBUG")) {
+                fprintf(stderr, "jit-reserve: anchor %p size %zuM hint %p -> %p\n",
+                        (void *)anchor, size >> 20, (void *)hint, try);
+            }
+            if (try == MAP_FAILED) {
+                continue;
+            }
+            d = (intptr_t)(uintptr_t)try - (intptr_t)anchor;
+            if (d > 0 && d < reach) {
+                jit_reserve = try;
+                jit_reserve_size = size;
+                return;
+            }
+            munmap(try, size);
+        }
+    }
+}
+#endif
+
 static int alloc_code_gen_buffer_anon(size_t size, int prot,
                                       int flags, Error **errp)
 {
-    void *buf;
+    void *buf = MAP_FAILED;
 
-    buf = mmap(NULL, size, prot, flags, -1, 0);
+#if defined(CONFIG_DARWIN) && (defined(__aarch64__) || defined(__x86_64__))
+    if (getenv("QEMU_JIT_DEBUG")) {
+        fprintf(stderr, "jit-alloc: reserve %p size %zu req %zu prot %d flags %x\n",
+                jit_reserve, jit_reserve_size, size, prot, flags);
+    }
+    if (jit_reserve && prot == PROT_NONE && (flags & MAP_JIT)) {
+        buf = jit_reserve;
+        if (size < jit_reserve_size) {
+            munmap((char *)jit_reserve + size, jit_reserve_size - size);
+        } else if (size > jit_reserve_size) {
+            size = jit_reserve_size;   /* a smaller buffer near beats a large one far */
+        }
+        jit_reserve = NULL;
+    }
+#endif
+    if (buf == MAP_FAILED) {
+        buf = mmap(NULL, size, prot, flags, -1, 0);
+    }
     if (buf == MAP_FAILED) {
