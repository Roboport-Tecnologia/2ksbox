+static void x87s_mul_x80(DisasContext *s, X87SV r, X87SV a, X87SV b,
+                         TCGLabel *slow)
+{
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 ea = x87s_tmp_i64(s);
+    TCGv_i64 eb = x87s_tmp_i64(s);
+    TCGv_i64 sign = x87s_tmp_i64(s);
+    TCGv_i64 z = x87s_tmp_i64(s);
+    TCGv_i64 t = x87s_tmp_i64(s);
+    TCGv_i64 lo = x87s_tmp_i64(s);
+    TCGv_i64 hi = x87s_tmp_i64(s);
+    TCGv_i64 top = x87s_tmp_i64(s);
+    TCGv_i64 m = x87s_tmp_i64(s);
+    TCGv_i64 rest = x87s_tmp_i64(s);
+
+    tcg_gen_extu_i32_i64(ea, a.xh);
+    tcg_gen_extu_i32_i64(eb, b.xh);
+    tcg_gen_xor_i64(sign, ea, eb);
+    tcg_gen_andi_i64(sign, sign, 0x8000);
+    tcg_gen_andi_i64(ea, ea, 0x7fff);
+    tcg_gen_andi_i64(eb, eb, 0x7fff);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, z, ea, 0);        /* a shadow is zero or normal */
+    tcg_gen_setcondi_i64(TCG_COND_EQ, t, eb, 0);
+    tcg_gen_or_i64(z, z, t);
+    tcg_gen_mulu2_i64(lo, hi, a.xl, b.xl);
+    tcg_gen_shri_i64(top, hi, 63);
+    tcg_gen_extract2_i64(m, lo, hi, 63);                /* (hi:lo) >> 63 */
+    tcg_gen_shli_i64(rest, lo, 1);
+    tcg_gen_movcond_i64(TCG_COND_NE, m, top, zero, hi, m);
+    tcg_gen_movcond_i64(TCG_COND_NE, rest, top, zero, lo, rest);
+    tcg_gen_add_i64(ea, ea, eb);
+    tcg_gen_add_i64(ea, ea, top);
+    tcg_gen_subi_i64(ea, ea, X87S_BIAS_X80);
+    x87s_pack_x80(s, r, sign, ea, m, rest, z, slow);
+}
