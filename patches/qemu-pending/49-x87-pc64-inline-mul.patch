+static void x87s_pack_x80(DisasContext *s, X87SV r, TCGv_i64 sign, TCGv_i64 e,
+                          TCGv_i64 m, TCGv_i64 rest, TCGv_i64 z, TCGLabel *slow)
+{
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 half = tcg_constant_i64(1ULL << 63);
+    TCGv_i64 bad = x87s_tmp_i64(s);
+    TCGv_i64 up = x87s_tmp_i64(s);
+    TCGv_i64 t = x87s_tmp_i64(s);
+
+    tcg_gen_subi_i64(bad, e, 1);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, bad, bad, 0x7ffc);
+    tcg_gen_andc_i64(bad, bad, z);
+    tcg_gen_brcondi_i64(TCG_COND_NE, bad, 0, slow);
+
+    if (!s->x87s_pe_sticky) {
+        tcg_gen_setcondi_i64(TCG_COND_NE, t, rest, 0);
+        tcg_gen_andc_i64(t, t, z);
+        x87s_set_pe_bit(s, t, 0);
+    }
+    tcg_gen_setcond_i64(TCG_COND_GTU, up, rest, half);
+    tcg_gen_setcond_i64(TCG_COND_EQ, t, rest, half);
+    tcg_gen_and_i64(t, t, m);
+    tcg_gen_andi_i64(t, t, 1);
+    tcg_gen_or_i64(up, up, t);
+    tcg_gen_add_i64(m, m, up);
+    tcg_gen_setcondi_i64(TCG_COND_EQ, t, m, 0);         /* carried out of 2^64 */
+    tcg_gen_movcond_i64(TCG_COND_NE, m, t, zero, half, m);
+    tcg_gen_add_i64(e, e, t);
+    tcg_gen_movcond_i64(TCG_COND_NE, r.xl, z, zero, zero, m);
+    tcg_gen_movcond_i64(TCG_COND_NE, e, z, zero, zero, e);
+    tcg_gen_or_i64(e, e, sign);
+    tcg_gen_extrl_i64_i32(r.xh, e);
+}
