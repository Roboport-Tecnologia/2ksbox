+/*
+ * Patch 17: the REP MOVS/STOS fast path (target/i386/tcg/mem_helper.c).
+ * Emitted before the per-element loop: with at least REP_FAST_MIN elements
+ * to go, the helper does the run inside the current page of the source and
+ * the destination with the host libc and returns the elements done; the
+ * registers advance by that and the instruction is re-entered for the next
+ * page (RF set, as between iterations).  0 falls into the per-element loop,
+ * which is then capped at REP_FAST_LOOP_MASK iterations per entry so that
+ * the next page gets another try.  Returns whether the path was emitted.
+ */
+#define REP_FAST_MIN 8
+#define REP_FAST_LOOP_MASK 15
+
+static bool gen_rep_fast(DisasContext *s, MemOp ot, TCGv dshift,
+                         void (*fn)(DisasContext *s, MemOp ot, TCGv dshift),
+                         target_ulong cx_mask, TCGLabel *done,
+                         TCGLabel *reenter)
+{
+    bool movs = fn == gen_movs;
+    TCGLabel *slow;
+    TCGv_i32 desc;
+    TCGv cnt, dst, n, delta, src = NULL;
+
+    if (!s->rep_fast || !(movs || fn == gen_stos)) {
+        return false;
+    }
+    slow = gen_new_label();
+    desc = tcg_constant_i32(ot | (s->mem_index << 2));
+    cnt = tcg_temp_new();
+    dst = tcg_temp_new();
+    n = tcg_temp_new();
+    delta = tcg_temp_new();
+
+    tcg_gen_andi_tl(cnt, cpu_regs[R_ECX], cx_mask);
+    tcg_gen_brcondi_tl(TCG_COND_LTU, cnt, REP_FAST_MIN, slow);
+    if (movs) {
+        src = tcg_temp_new();
+        gen_string_movl_A0_ESI(s);
+        tcg_gen_mov_tl(src, s->A0);
+    }
+    gen_string_movl_A0_EDI(s);
+    tcg_gen_mov_tl(dst, s->A0);
+    if (movs) {
+        gen_helper_rep_movs_fast(n, tcg_env, dst, src, cnt, desc);
+    } else {
+        gen_helper_rep_stos_fast(n, tcg_env, dst, s->T0, cnt, desc);
+    }
+    tcg_gen_brcondi_tl(TCG_COND_EQ, n, 0, slow);
+
+    tcg_gen_mul_tl(delta, n, dshift);
+    if (movs) {
+        gen_op_add_reg(s, s->aflag, R_ESI, delta);
+    }
+    gen_op_add_reg(s, s->aflag, R_EDI, delta);
+    tcg_gen_neg_tl(n, n);
+    gen_op_add_reg(s, s->aflag, R_ECX, n);
+    tcg_gen_brcondi_tl(TCG_COND_TSTEQ, cpu_regs[R_ECX], cx_mask, done);
+    tcg_gen_br(reenter);
+
+    gen_set_label(slow);
+    return true;
+}
