 }
+
+/*
+ * REP MOVS / STOS fast path (patch 17, docs/tracks/m9-tcg-aarch64.md).
+ *
+ * do_gen_rep() calls one of these before its per-element loop when enough
+ * elements are left.  The helper takes the run that stays inside the current
+ * page of the source and of the destination (direction from env->df), probes
+ * each page once — the probe fills the TLB, marks the destination dirty and
+ * invalidates the TBs it covers exactly as the per-element stores would, and
+ * refuses MMIO, watchpoint and unmapped pages without faulting — copies or
+ * fills with the host libc and returns the number of elements done.  The
+ * translator advances ESI/EDI/ECX by that and re-enters the instruction for
+ * the next page; 0 means "nothing done, use the per-element loop", which
+ * then runs at most a few elements before the instruction is re-entered and
+ * the next page gets its try.  Nothing is written to env here, so a longjmp
+ * out of the probe (the current TB invalidated by the write) resumes with
+ * the state of the instruction's start, and a fault on either page is left
+ * to the per-element loop, which raises it at the right element.
+ */
+
+/* fewer elements than this and the call costs more than the loop */
+#define REP_FAST_MIN 8
+
+/* elements of a run at addr in direction df that stay inside the page */
+static target_ulong rep_fast_run(target_ulong addr, int ot, int df,
+                                 target_ulong count)
+{
+    unsigned off = addr & ~TARGET_PAGE_MASK;
+    unsigned width = 1u << ot;
+    target_ulong n;
+
+    if (off + width > TARGET_PAGE_SIZE) {
+        return 0;               /* the first element straddles the page */
+    }
+    n = df < 0 ? (off >> ot) + 1 : (TARGET_PAGE_SIZE - off) >> ot;
+    return MIN(n, count);
+}
+
+/* the lowest byte of a run of n elements at addr in direction df */
+static target_ulong rep_fast_base(target_ulong addr, int ot, int df,
+                                  target_ulong n)
+{
+    return df < 0 ? addr - ((n - 1) << ot) : addr;
+}
+
+static void *rep_fast_probe(CPUX86State *env, target_ulong base,
+                            target_ulong bytes, MMUAccessType type,
+                            int mmu_idx, uintptr_t ra)
+{
+    void *host = NULL;
+    int flags = probe_access_flags(env, base, bytes, type, mmu_idx,
+                                   true, &host, ra);
+
+    return (flags || !host) ? NULL : host;
+}
+
+static inline void rep_fast_copy_elem(uint8_t *d, const uint8_t *s,
+                                      target_ulong i, int ot)
+{
+    /* load, then store: the element's own bytes may overlap */
+    switch (ot) {
+    case MO_8:
+        d[i] = s[i];
+        break;
+    case MO_16:
+        stw_p(d + (i << 1), lduw_p(s + (i << 1)));
+        break;
+    case MO_32:
+        stl_p(d + (i << 2), ldl_p(s + (i << 2)));
+        break;
+    default:
+        stq_p(d + (i << 3), ldq_p(s + (i << 3)));
+        break;
+    }
+}
+
+target_ulong helper_rep_movs_fast(CPUX86State *env, target_ulong dst,
+                                  target_ulong src, target_ulong count,
+                                  uint32_t desc)
+{
+    uintptr_t ra = GETPC();
+    int ot = desc & 3, mmu_idx = desc >> 2, df = env->df;
+    target_ulong n, bytes, sbase, dbase, i;
+    uint8_t *s, *d;
+
+    n = MIN(rep_fast_run(src, ot, df, count), rep_fast_run(dst, ot, df, count));
+    if (n < REP_FAST_MIN) {
+        return 0;
+    }
+    bytes = n << ot;
+    sbase = rep_fast_base(src, ot, df, n);
+    dbase = rep_fast_base(dst, ot, df, n);
+    s = rep_fast_probe(env, sbase, bytes, MMU_DATA_LOAD, mmu_idx, ra);
+    if (!s) {
+        return 0;
+    }
+    d = rep_fast_probe(env, dbase, bytes, MMU_DATA_STORE, mmu_idx, ra);
+    if (!d) {
+        return 0;
+    }
+
+    if (dbase + bytes <= sbase || sbase + bytes <= dbase) {
+        memcpy(d, s, bytes);
+    } else if (df > 0 ? dbase < sbase : dbase > sbase) {
+        /* the guest's order never reads a byte it has already written */
+        memmove(d, s, bytes);
+    } else if (df > 0) {
+        /* overlapping the other way: a pattern fill, element by element */
+        for (i = 0; i < n; i++) {
+            rep_fast_copy_elem(d, s, i, ot);
+        }
+    } else {
+        for (i = n; i-- > 0;) {
+            rep_fast_copy_elem(d, s, i, ot);
+        }
+    }
+    return n;
+}
+
+target_ulong helper_rep_stos_fast(CPUX86State *env, target_ulong dst,
+                                  target_ulong val, target_ulong count,
+                                  uint32_t desc)
+{
+    uintptr_t ra = GETPC();
+    int ot = desc & 3, mmu_idx = desc >> 2, df = env->df;
+    target_ulong n, bytes, i;
+    uint8_t *d;
+
+    n = rep_fast_run(dst, ot, df, count);
+    if (n < REP_FAST_MIN) {
+        return 0;
+    }
+    bytes = n << ot;
+    d = rep_fast_probe(env, rep_fast_base(dst, ot, df, n), bytes,
+                       MMU_DATA_STORE, mmu_idx, ra);
+    if (!d) {
+        return 0;
+    }
+
+    switch (ot) {
+    case MO_8:
+        memset(d, val, bytes);
+        break;
+    case MO_16: {
+        uint16_t v = val;
+        if ((v & 0xff) == (v >> 8)) {
+            memset(d, v, bytes);
+        } else {
+            for (i = 0; i < n; i++) {
+                stw_le_p(d + (i << 1), v);
+            }
+        }
+        break;
+    }
+    case MO_32: {
+        uint32_t v = val;
+        if (v == (v & 0xff) * 0x01010101u) {
+            memset(d, v, bytes);
+        } else {
+            for (i = 0; i < n; i++) {
+                stl_le_p(d + (i << 2), v);
+            }
+        }
+        break;
+    }
+    default: {
+        uint64_t v = val;
+        if (v == (v & 0xff) * 0x0101010101010101ull) {
+            memset(d, v, bytes);
+        } else {
+            for (i = 0; i < n; i++) {
+                stq_le_p(d + (i << 3), v);
+            }
+        }
+        break;
+    }
+    }
+    return n;
+}
