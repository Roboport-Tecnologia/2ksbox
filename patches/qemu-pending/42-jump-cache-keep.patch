index 3761ee5..98966b1 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -673,3 +673,28 @@ void tcg_flush_jmp_cache(CPUState *cpu)
         qatomic_set(&jc->array[i].tb, NULL);
     }
 }
+
+/*
+ * A TLB flush's jump cache flush (patch 42).  The entries are keyed by
+ * the generation they were filled in, so bumping it makes every one of
+ * them miss the inline probe exactly as clearing did; the C lookup then
+ * checks a stale entry's TB against the pc's physical page and keeps it
+ * when they agree, where it used to pay a hash-table lookup for every
+ * indirect branch target after every context switch.  A guest with the
+ * cache switched off, or a 64-bit one, gets the clear.  The generation
+ * wrapping to zero (2^32 flushes) takes the clear too, so no entry can
+ * ever alias a generation it was not filled in.
+ */
+void tcg_flush_jmp_cache_lazy(CPUState *cpu)
+{
+    if (TB_JMP_CACHE_GEN && tcg_jump_cache_keep) {
+        uint32_t gen = cpu->tb_jmp_cache->gen + 1;
+
+        if (likely(gen != 0)) {
+            cpu->tb_jmp_cache->gen = gen;
+            return;
+        }
+        cpu->tb_jmp_cache->gen = 1;
+    }
+    tcg_flush_jmp_cache(cpu);
+}
