+static uint8_t sb16_vol (int db)
+{
+    if (db >= 0) {
+        return 255;
+    }
+    return (uint8_t) lrint (255.0 * pow (10.0, db / 20.0));
+}
+
+static void sb16_apply_volumes (SB16State *s)
+{
+    const uint8_t *m = s->mixer_regs;
+    int master_l = sb16_level (m[0x30]) + (m[0x41] >> 6) * 6;
+    int master_r = sb16_level (m[0x31]) + (m[0x42] >> 6) * 6;
+
+    audio_be_set_volume_out_lr (s->audio_be, s->voice, 0,
+                                sb16_vol (master_l + sb16_level (m[0x32])),
+                                sb16_vol (master_r + sb16_level (m[0x33])));
+    audio_mixin_set_volume (AUDIO_MIXIN_FM, 0,
+                            sb16_vol (master_l + sb16_level (m[0x34])),
+                            sb16_vol (master_r + sb16_level (m[0x35])));
+    audio_mixin_set_volume (AUDIO_MIXIN_CD, 0,
+                            m[0x3c] & 4 ? sb16_vol (master_l + sb16_level (m[0x36])) : 0,
+                            m[0x3c] & 2 ? sb16_vol (master_r + sb16_level (m[0x37])) : 0);
+}
+
+/*
+ * The SB Pro's volume registers are a view of the SB16's on a CT1745: a
+ * write to one lands on the other. SB Pro holds 4 bits a side (left in
+ * 7:4, right in 3:0); SB16 level n4 is 5-bit (n4 << 1) | 1.
+ */
+static void sb16_mixer_compat (SB16State *s, int nreg, uint8_t val)
+{
+    static const struct { uint8_t pro, sb16; } map[] = {
+        { 0x04, 0x32 },     /* voice */
+        { 0x22, 0x30 },     /* master */
+        { 0x26, 0x34 },     /* FM */
+        { 0x28, 0x36 },     /* CD */
+        { 0x2e, 0x38 },     /* line */
+    };
+    uint8_t *m = s->mixer_regs;
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE (map); i++) {
+        if (nreg == map[i].pro) {
+            m[map[i].sb16] = (val & 0xf0) | 0x08;
+            m[map[i].sb16 + 1] = ((val & 0x0f) << 4) | 0x08;
+        } else if (nreg == map[i].sb16 || nreg == map[i].sb16 + 1) {
+            m[map[i].pro] = (m[map[i].sb16] & 0xf0) | (m[map[i].sb16 + 1] >> 4);
+        }
     }
 }
 
