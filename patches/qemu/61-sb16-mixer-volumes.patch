+/*
+ * 2ksbox, patch 61: the CT1745's output mixer, applied. QEMU stored these
+ * registers and applied none, so every source played at full scale and a
+ * game's effects over its CD music summed past what 16 bits hold -- the
+ * crackle in Carmageddon's races (docs/00-status.md). Windows' Volume
+ * Control writes exactly these, so its sliders work again and the mix has
+ * the headroom the real card left.
+ *
+ * A level register holds 5 bits in 7:3, 2 dB a step: 31 = 0 dB, 0 = -62
+ * dB. The output gain (0x41/0x42, bits 7:6) adds 0/6/12/18 dB. The card's
+ * own voice is master x voice; the FM chip and the CD drive are voices of
+ * other devices, reached through their mixer inputs (audio_mixin_*), and
+ * the CD's also passes the output switches in 0x3C (bit 2 left, bit 1
+ * right). A voice cannot be made louder than unity, so a total above 0 dB
+ * is 0 dB.
+ */
+static int sb16_level (uint8_t reg)
+{
+    return ((reg >> 3) - 31) * 2;
+}
 
