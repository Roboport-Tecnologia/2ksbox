index ee065fa496..8ed9e4b475 100644
--- a/audio/audio-be.c
+++ b/audio/audio-be.c
@@ -169,6 +169,65 @@ void audio_be_set_volume_out(AudioBackend *be, SWVoiceOut *sw, Volume *vol)
     klass->set_volume_out(be, sw, vol);
 }
 
+/* 2ksbox, patch 61: the sound card's analog inputs (qemu/audio.h) */
+#define AUDIO_MIXIN_VOICES 4
+
+static struct {
+    struct {
+        AudioBackend *be;
+        SWVoiceOut *sw;
+    } voice[AUDIO_MIXIN_VOICES];
+    bool set;
+    int mute;
+    uint8_t lvol, rvol;
+} audio_mixin[AUDIO_MIXIN_COUNT];
+
+void audio_mixin_attach(AudioMixIn in, AudioBackend *be, SWVoiceOut *sw)
+{
+    int i;
+
+    for (i = 0; i < AUDIO_MIXIN_VOICES; i++) {
+        if (!audio_mixin[in].voice[i].sw) {
+            audio_mixin[in].voice[i].be = be;
+            audio_mixin[in].voice[i].sw = sw;
+            break;
+        }
+    }
+    if (audio_mixin[in].set) {
+        audio_be_set_volume_out_lr(be, sw, audio_mixin[in].mute,
+                                   audio_mixin[in].lvol, audio_mixin[in].rvol);
+    }
+}
+
+void audio_mixin_detach(AudioMixIn in, SWVoiceOut *sw)
+{
+    int i;
+
+    for (i = 0; i < AUDIO_MIXIN_VOICES; i++) {
+        if (audio_mixin[in].voice[i].sw == sw) {
+            audio_mixin[in].voice[i].be = NULL;
+            audio_mixin[in].voice[i].sw = NULL;
+        }
+    }
+}
+
+void audio_mixin_set_volume(AudioMixIn in, int mute, uint8_t lvol, uint8_t rvol)
+{
+    int i;
+
+    audio_mixin[in].set = true;
+    audio_mixin[in].mute = mute;
+    audio_mixin[in].lvol = lvol;
+    audio_mixin[in].rvol = rvol;
+    for (i = 0; i < AUDIO_MIXIN_VOICES; i++) {
+        if (audio_mixin[in].voice[i].sw) {
+            audio_be_set_volume_out_lr(audio_mixin[in].voice[i].be,
+                                       audio_mixin[in].voice[i].sw,
+                                       mute, lvol, rvol);
+        }
+    }
+}
+
 void audio_be_set_volume_in(AudioBackend *be, SWVoiceIn *sw, Volume *vol)
 {
     AudioBackendClass *klass = AUDIO_BACKEND_GET_CLASS(be);
