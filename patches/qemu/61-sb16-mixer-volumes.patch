+/*
+ * 2ksbox, patch 61: the analog inputs of the machine's sound card. On a
+ * real PC the FM chip and the CD drive's audio cable ran into the sound
+ * card's mixer, whose volume registers scaled them; here each is a voice
+ * of its own device. A source attaches its voice to its input, the card
+ * sets the input's volume, and whichever comes first, the other finds
+ * it. A machine with no card that sets one plays every input at unity.
+ */
+typedef enum AudioMixIn {
+    AUDIO_MIXIN_FM,
+    AUDIO_MIXIN_CD,
+    AUDIO_MIXIN_COUNT
+} AudioMixIn;
+
+void audio_mixin_attach(AudioMixIn in, AudioBackend *be, SWVoiceOut *sw);
+void audio_mixin_detach(AudioMixIn in, SWVoiceOut *sw);
+void audio_mixin_set_volume(AudioMixIn in, int mute, uint8_t lvol, uint8_t rvol);
+
 static inline void
 audio_be_set_volume_out_lr(AudioBackend *be, SWVoiceOut *sw,
                            bool mut, uint8_t lvol, uint8_t rvol) {
