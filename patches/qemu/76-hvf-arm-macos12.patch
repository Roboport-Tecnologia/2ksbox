+++ b/target/arm/hvf/hvf.c
@@ -1254,20 +1254,30 @@ static bool hvf_arm_get_host_cpu_features(ARMHostCPUFeatures *ahcf)
     return r == HV_SUCCESS;
 }
 
+/*
+ * Before macOS 13 Hypervisor.framework has no VM configuration and every
+ * VM gets a 36-bit IPA space (2ksbox: the macOS 12 floor).
+ */
+#define HVF_ARM_IPA_SIZE_MACOS12 36
+
 uint32_t hvf_arch_get_default_ipa_bit_size(void)
 {
-    uint32_t default_ipa_size;
-    hv_return_t ret = hv_vm_config_get_default_ipa_size(&default_ipa_size);
-    assert_hvf_ok(ret);
+    uint32_t default_ipa_size = HVF_ARM_IPA_SIZE_MACOS12;
+    if (__builtin_available(macOS 13, *)) {
+        hv_return_t ret = hv_vm_config_get_default_ipa_size(&default_ipa_size);
+        assert_hvf_ok(ret);
+    }
 
     return default_ipa_size;
 }
 
 uint32_t hvf_arch_get_max_ipa_bit_size(void)
 {
-    uint32_t max_ipa_size;
-    hv_return_t ret = hv_vm_config_get_max_ipa_size(&max_ipa_size);
-    assert_hvf_ok(ret);
+    uint32_t max_ipa_size = HVF_ARM_IPA_SIZE_MACOS12;
+    if (__builtin_available(macOS 13, *)) {
+        hv_return_t ret = hv_vm_config_get_max_ipa_size(&max_ipa_size);
+        assert_hvf_ok(ret);
+    }
 
     /*
      * We clamp any IPA size we want to back the VM with to a valid PARange
@@ -1321,7 +1331,25 @@ static bool hvf_arm_el2_supported(void)
 }
 
 
+static hv_return_t hvf_arm_vm_create_config(uint32_t pa_range)
+    __attribute__((availability(macos, introduced = 13.0)));
+
 hv_return_t hvf_arch_vm_create(MachineState *ms, uint32_t pa_range)
+{
+    if (__builtin_available(macOS 13, *)) {
+        return hvf_arm_vm_create_config(pa_range);
+    }
+    /* no configuration: 36 bits; nested virtualization and the in-kernel GIC need macOS 15 */
+    if (pa_range > HVF_ARM_IPA_SIZE_MACOS12 || hvf_nested_virt_enabled() ||
+        hvf_irqchip_in_kernel()) {
+        return HV_UNSUPPORTED;
+    }
+    chosen_ipa_bit_size = HVF_ARM_IPA_SIZE_MACOS12;
+    return hv_vm_create(NULL);
+}
+
+/* upstream's hvf_arch_vm_create, the VM configuration calls of macOS 13 */
+static hv_return_t hvf_arm_vm_create_config(uint32_t pa_range)
 {
     hv_return_t ret;
     hv_vm_config_t config = hv_vm_config_create();
