Arm HVF on the macOS 12 floor (2ksbox, track M20 step 4, 2026-10-01).

QEMU 9.2's Arm Hypervisor.framework accelerator sizes the VM's IPA space
through the VM configuration calls macOS 13 added
(`hv_vm_config_create`, `hv_vm_config_{get_default,get_max,set}_ipa_size`)
and calls them unconditionally, so `aarch64-softmmu` does not compile
against our floor (`-Werror=unguarded-availability-new`, macOS 12 for
the community build) and would call a missing symbol on a macOS 12 host.
Each call now runs only under `__builtin_available(macOS 13, *)`; before
that the VM is made with no configuration, which is a 36-bit IPA space,
and a machine that needs more is refused with HV_UNSUPPORTED.
diff --git a/target/arm/hvf/hvf.c b/target/arm/hvf/hvf.c
index d1cf47c..310e42d 100644
--- a/target/arm/hvf/hvf.c
+++ b/target/arm/hvf/hvf.c
@@ -931,20 +931,30 @@ static bool hvf_arm_get_host_cpu_features(ARMHostCPUFeatures *ahcf)
     return r == HV_SUCCESS;
 }
 
+/*
+ * Before macOS 13 Hypervisor.framework has no VM configuration and every
+ * VM gets a 36-bit IPA space (2ksbox: the macOS 12 floor).
+ */
+#define HVF_ARM_IPA_SIZE_MACOS12 36
+
 uint32_t hvf_arm_get_default_ipa_bit_size(void)
 {
-    uint32_t default_ipa_size;
-    hv_return_t ret = hv_vm_config_get_default_ipa_size(&default_ipa_size);
-    assert_hvf_ok(ret);
+    uint32_t default_ipa_size = HVF_ARM_IPA_SIZE_MACOS12;
+    if (__builtin_available(macOS 13, *)) {
+        hv_return_t ret = hv_vm_config_get_default_ipa_size(&default_ipa_size);
+        assert_hvf_ok(ret);
+    }
 
     return default_ipa_size;
 }
 
 uint32_t hvf_arm_get_max_ipa_bit_size(void)
 {
-    uint32_t max_ipa_size;
-    hv_return_t ret = hv_vm_config_get_max_ipa_size(&max_ipa_size);
-    assert_hvf_ok(ret);
+    uint32_t max_ipa_size = HVF_ARM_IPA_SIZE_MACOS12;
+    if (__builtin_available(macOS 13, *)) {
+        hv_return_t ret = hv_vm_config_get_max_ipa_size(&max_ipa_size);
+        assert_hvf_ok(ret);
+    }
 
     /*
      * We clamp any IPA size we want to back the VM with to a valid PARange
@@ -983,20 +993,24 @@ void hvf_arch_vcpu_destroy(CPUState *cpu)
 hv_return_t hvf_arch_vm_create(MachineState *ms, uint32_t pa_range)
 {
     hv_return_t ret;
-    hv_vm_config_t config = hv_vm_config_create();
-
-    ret = hv_vm_config_set_ipa_size(config, pa_range);
-    if (ret != HV_SUCCESS) {
-        goto cleanup;
-    }
-    chosen_ipa_bit_size = pa_range;
 
-    ret = hv_vm_create(config);
+    if (__builtin_available(macOS 13, *)) {
+        hv_vm_config_t config = hv_vm_config_create();
 
-cleanup:
-    os_release(config);
+        ret = hv_vm_config_set_ipa_size(config, pa_range);
+        if (ret == HV_SUCCESS) {
+            chosen_ipa_bit_size = pa_range;
+            ret = hv_vm_create(config);
+        }
+        os_release(config);
+        return ret;
+    }
 
-    return ret;
+    if (pa_range > HVF_ARM_IPA_SIZE_MACOS12) {
+        return HV_UNSUPPORTED;
+    }
+    chosen_ipa_bit_size = HVF_ARM_IPA_SIZE_MACOS12;
+    return hv_vm_create(NULL);
 }
 
 int hvf_arch_init_vcpu(CPUState *cpu)
