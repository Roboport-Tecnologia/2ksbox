Register the "embed" audiodev driver (embed/embedaudio.c, built into
libqemu-embed): QAPI enum/union entry plus the per-direction options case.
The driver clips QEMU's mixed output into a ring owned by the embedding
application (docs/11-m1-embed-api.md).

diff --git a/audio/audio.c b/audio/audio.c
index 6f10ee470e..9ccbc4b8c1 100644
--- a/audio/audio.c
+++ b/audio/audio.c
@@ -186,6 +186,7 @@ static void audio_create_pdos(Audiodev *dev)
         break
 
         CASE(NONE, none, );
+        CASE(EMBED, embed, );
 #ifdef CONFIG_AUDIO_ALSA
         CASE(ALSA, alsa, Alsa);
 #endif
@@ -271,6 +272,8 @@ static AudiodevPerDirectionOptions *audio_get_pdo_out(Audiodev *dev)
     switch (dev->driver) {
     case AUDIODEV_DRIVER_NONE:
         return dev->u.none.out;
+    case AUDIODEV_DRIVER_EMBED:
+        return dev->u.embed.out;
 #ifdef CONFIG_AUDIO_ALSA
     case AUDIODEV_DRIVER_ALSA:
         return qapi_AudiodevAlsaPerDirectionOptions_base(dev->u.alsa.out);
@@ -330,6 +333,8 @@ static AudiodevPerDirectionOptions *audio_get_pdo_in(Audiodev *dev)
     switch (dev->driver) {
     case AUDIODEV_DRIVER_NONE:
         return dev->u.none.in;
+    case AUDIODEV_DRIVER_EMBED:
+        return dev->u.embed.in;
 #ifdef CONFIG_AUDIO_ALSA
     case AUDIODEV_DRIVER_ALSA:
         return qapi_AudiodevAlsaPerDirectionOptions_base(dev->u.alsa.in);
diff --git a/audio/audio_template.h b/audio/audio_template.h
