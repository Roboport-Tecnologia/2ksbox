+/*
+ * 2ksbox: a RAM region with a dirty log (a display adapter's VRAM) is
+ * mapped with the hypervisor tracking its dirty pages, and log_sync asks
+ * the hypervisor which ones the guest wrote. log_sync marked the whole
+ * region dirty on every call before, so a display redrew, copied and
+ * uploaded its whole frame at every refresh whatever changed, a cost that
+ * grows with the mode (a 3840x2160 desktop is 33 MB a refresh).
+ * WHPX_DIRTY_TRACK=0 keeps the old whole-region answer, the A/B.
+ */
+static bool whpx_dirty_track(MemoryRegion *mr, bool writable)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("WHPX_DIRTY_TRACK");
+        on = whp_dispatch.WHvQueryGpaRangeDirtyBitmap && !(e && !strcmp(e, "0"));
+    }
+    return on && writable &&
+           (memory_region_get_dirty_log_mask(mr) & ~(1 << DIRTY_MEMORY_CODE));
+}
+
+/*
+ * 2ksbox: the pieces of a section, in region offsets, tracked or not: the
+ * region's dirty_track_skip range (a device's command window) is left
+ * untracked. Returns how many (1 to 3).
+ */
+typedef struct WhpxPiece {
+    uint64_t start, end;
+    bool track;
+} WhpxPiece;
+
+static int whpx_pieces(MemoryRegion *mr, uint64_t off, uint64_t size, WhpxPiece *p)
+{
+    uint64_t s0 = MAX(mr->dirty_track_skip_offset, off);
+    uint64_t s1 = MIN(mr->dirty_track_skip_offset + mr->dirty_track_skip_size, off + size);
+    int n = 0;
+
+    if (!mr->dirty_track_skip_size || s1 <= s0) {
+        p[0] = (WhpxPiece){ off, off + size, true };
+        return 1;
+    }
+    if (s0 > off) {
+        p[n++] = (WhpxPiece){ off, s0, true };
+    }
+    p[n++] = (WhpxPiece){ s0, s1, false };
+    if (s1 < off + size) {
+        p[n++] = (WhpxPiece){ s1, off + size, true };
+    }
+    return n;
+}
+
+/* a tracked section mapped piece by piece; false (nothing left mapped) if
+ * the hypervisor refuses tracking */
+static bool whpx_map_tracked(MemoryRegionSection *section, void *mem, uint64_t gva,
+                             uint64_t size, WHV_MAP_GPA_RANGE_FLAGS flags)
+{
+    struct whpx_state *whpx = &whpx_global;
+    uint64_t off = section->offset_within_region;
+    WhpxPiece p[3];
+    int n = whpx_pieces(section->mr, off, size, p), i;
+
+    for (i = 0; i < n; i++) {
+        HRESULT hr = whp_dispatch.WHvMapGpaRange(whpx->partition, (uint8_t *)mem + (p[i].start - off),
+                                                 gva + (p[i].start - off), p[i].end - p[i].start,
+                                                 flags | (p[i].track ? WHvMapGpaRangeFlagTrackDirtyPages : 0));
+        if (FAILED(hr)) {
+            while (i-- > 0) {
+                whp_dispatch.WHvUnmapGpaRange(whpx->partition, gva + (p[i].start - off), p[i].end - p[i].start);
+            }
+            warn_report_once("WHPX: no dirty page tracking (0x%08lx)", (unsigned long)hr);
+            return false;
+        }
+    }
+    return true;
+}
