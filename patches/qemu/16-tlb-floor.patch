Softmmu TLB: a 4096-entry floor for the dynamic table (M9 track,
docs/tracks/m9-tcg-aarch64.md). See the comment in the header and the patch
README row.

diff --git a/accel/tcg/tlb-bounds.h b/accel/tcg/tlb-bounds.h
index f83d9ac9ee..da21f81f7d 100644
--- a/accel/tcg/tlb-bounds.h
+++ b/accel/tcg/tlb-bounds.h
@@ -6,8 +6,20 @@
 #ifndef ACCEL_TCG_TLB_BOUNDS_H
 #define ACCEL_TCG_TLB_BOUNDS_H
 
-#define CPU_TLB_DYN_MIN_BITS 6
+/*
+ * The dynamic TLB is direct-mapped and resized at every flush from the
+ * entries used since the previous one.  A Windows guest flushes at every
+ * context switch (hundreds a second), so the measured "working set" is a
+ * few hundred pages and the table shrank to 64-256 entries under the
+ * 30-70 % use-rate policy; at that load two live pages share an index all
+ * the time and every access to either is a victim-TLB swap (a 1997 game's
+ * software renderer: 6 million swaps a second, half the vCPU in the slow
+ * path).  A 4096-entry floor (128 KiB of entries per mmu index, memset per
+ * flush) is where those conflicts vanish on the game workloads; growth
+ * above it is unchanged.  M9 track, docs/tracks/m9-tcg-aarch64.md.
+ */
+#define CPU_TLB_DYN_MIN_BITS 12
 #define CPU_TLB_DYN_MAX_BITS (32 - TARGET_PAGE_BITS)
-#define CPU_TLB_DYN_DEFAULT_BITS 8
+#define CPU_TLB_DYN_DEFAULT_BITS 12
 
 #endif /* ACCEL_TCG_TLB_BOUNDS_H */
