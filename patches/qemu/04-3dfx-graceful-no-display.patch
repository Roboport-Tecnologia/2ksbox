Do not kill the VM when a guest activates GL pass-through and no frontend
has registered a 3D context provider: the Mesa backend is handed a NULL
window and refuses context creation, so the guest's wglCreateContext fails
cleanly instead of taking the machine with it.

Upstream qemu-3dfx reaches this state through ui/sdl2.c's
sdl_display_valid(), which exit(1)s; patch 30 replaces that path with the
provider vtable, and since 2026-09-07 QEMU is configured --disable-sdl so
ui/sdl2.c is not compiled at all. These two guards stay because they are
the backend's own half of the contract: qemu-system-i386 links the native
GLX backend and nothing registers a provider for it.

diff --git a/hw/mesa/mglcntx_linux.c b/hw/mesa/mglcntx_linux.c
index 94fb842d72..ed4d8b1596 100644
--- a/hw/mesa/mglcntx_linux.c
+++ b/hw/mesa/mglcntx_linux.c
@@ -416,6 +416,10 @@ void MGLWndRelease(void)
 int MGLCreateContext(uint32_t gDC)
 {
     int i, ret;
+    if (!win) {
+        DPRINTF("no window: GL context refused");
+        return 1;
+    }
     i = gDC & (MAX_PBUFFER - 1);
     if (gDC == ((MESAGL_HPBDC & 0xFFFFFFF0U) | i)) {
         ret = 0;
@@ -437,6 +441,8 @@ int MGLCreateContext(uint32_t gDC)
 
 int MGLMakeCurrent(uint32_t cntxRC, int level)
 {
+    if (!win)
+        return 0;
     int n = (level)? ((level % MAX_LVLCNTX)? (level % MAX_LVLCNTX):1):level;
     uint32_t i = cntxRC & (MAX_PBUFFER - 1);
     if (cntxRC == (MESAGL_MAGIC - n)) {
