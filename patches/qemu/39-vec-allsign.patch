+ * Bytes with the top bit set -> 0xff, their minimum, 0 iff all were.
+ */
+static void tgen_vec_allsign_i32(TCGContext *s, TCGType type,
+                                 TCGReg a0, TCGReg a1)
+{
+    tcg_out_insn(s, qrr_e, CMLT0, 1, MO_8, TCG_VEC_TMP0, a1);
+    tcg_out_insn(s, qrr_e, UMINV, 1, MO_8, TCG_VEC_TMP0, TCG_VEC_TMP0);
+    tcg_out_insn(s, simd_copy, UMOV, 0, a0, TCG_VEC_TMP0, 1, 0);
+    tcg_out_logicali(s, Ilogic_imm_EORI, TCG_TYPE_I32, a0, a0, 0xff);
+}
