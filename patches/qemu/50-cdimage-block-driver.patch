Build the cdimage block driver (block/cdimage.c, overlaid from
libdisc/qemu/ by scripts/prepare-qemu.sh) when -Dlibdisc_dir names the
directory holding liblibdisc.a, the Rust staticlib of the CD-ROM image
model (libdisc/, built by scripts/configure-qemu.sh). CONFIG_CDIMAGE
guards the disc paths in hw/ide/atapi.c (patch 51). Doc 17 §5.2.

diff --git a/block/meson.build b/block/meson.build
index bc419aebf0..7fb1d9a665 100644
--- a/block/meson.build
+++ b/block/meson.build
@@ -69,6 +69,8 @@ endif
 if get_option('bochs').allowed()
   block_ss.add(files('bochs.c'))
 endif
+# win98-xp-virt: the CD-ROM image driver over libdisc (overlaid by scripts/prepare-qemu.sh)
+block_ss.add(when: libdisc, if_true: files('cdimage.c'))
 if get_option('vvfat').allowed()
   block_ss.add(files('vvfat.c'))
 endif
diff --git a/meson.build b/meson.build
index caff03a6d2..72917ee927 100644
