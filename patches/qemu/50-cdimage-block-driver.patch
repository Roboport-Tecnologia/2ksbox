+++ b/meson.build
@@ -2007,6 +2007,25 @@ if snappy.found() and not cc.links('''
   endif
 endif
 
+# win98-xp-virt: libdisc, the CD-ROM image model (a Rust staticlib built by
+# scripts/configure-qemu.sh) behind block/cdimage.c; doc 17 §5.2
+libdisc = not_found
+if get_option('libdisc_dir') != ''
+  libdisc_lib = cc.find_library('libdisc', dirs: [get_option('libdisc_dir')],
+                                static: true, required: true)
+  # What the staticlib itself needs, as `rustc --print native-static-libs`
+  # reports it per platform (meson forbids a chained ternary).
+  if host_os == 'darwin'
+    libdisc_libs = ['-liconv']
+  elif host_os == 'windows'
+    libdisc_libs = ['-lkernel32', '-lntdll', '-luserenv', '-lws2_32', '-ldbghelp']
+  else
+    libdisc_libs = ['-ldl', '-lm', '-lrt', '-lutil', '-lgcc_s']
+  endif
+  libdisc = declare_dependency(dependencies: [libdisc_lib, threads],
+                               link_args: libdisc_libs)
+endif
+
 lzo = not_found
 if not get_option('lzo').auto() or have_system
   lzo = cc.find_library('lzo2', has_headers: ['lzo/lzo1x.h'],
@@ -2445,6 +2464,7 @@ config_host_data.set('CONFIG_LINUX', host_os == 'linux')
 config_host_data.set('CONFIG_POSIX', host_os != 'windows')
 config_host_data.set('CONFIG_WIN32', host_os == 'windows')
 config_host_data.set('CONFIG_LZO', lzo.found())
+config_host_data.set('CONFIG_CDIMAGE', libdisc.found())
 config_host_data.set('CONFIG_MPATH', mpathpersist.found())
 config_host_data.set('CONFIG_BLKIO', blkio.found())
 if blkio.found()
@@ -5034,6 +5054,7 @@ summary_info += {'TPM support':       have_tpm}
 summary_info += {'IGVM support':      igvm}
 summary_info += {'libssh support':    libssh}
 summary_info += {'lzo support':       lzo}
+summary_info += {'cdimage (libdisc)':  libdisc}
 summary_info += {'snappy support':    snappy}
 summary_info += {'bzip2 support':     libbzip2}
 summary_info += {'lzfse support':     liblzfse}
