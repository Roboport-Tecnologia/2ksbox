+/*
+ * 2ksbox: a tick whose edge arrives while the last one is still pending at
+ * the PIC is not lost (-global isa-pit.reinject=off restores upstream).
+ *
+ * irq_timer runs when the main loop wakes, and a wakeup is late by however
+ * coarse the host's waits are: every transition that came due meanwhile is
+ * then raised back to back, under the BQL, before the CPU can take one of
+ * them -- and on the edge-triggered 8259 all of them are one interrupt. A
+ * guest at 1 kHz (Windows 9x's multimedia timer, what a MIDI sequencer and
+ * many games run on) counts time in those interrupts, so it ran at the rate
+ * of the host's wakeups: 50 % with 2 ms waits, and 6 % on a Windows host,
+ * whose waits round to its 15.6 ms timer tick. Measured on Linux with the
+ * waits rounded that way, and the tool that did it is the pit-rate phase of
+ * tools/pit-guest-test.py.
+ *
+ * So an edge that finds IRQ 0 still requested and unmasked at the master
+ * PIC is counted, and each count is raised as a fresh edge when the CPU
+ * acknowledges IRQ 0 (pic_intack) -- after the ISR is entered, so the PIC
+ * holds it until the EOI, and the guest runs its handler once per tick.
+ * Owed ticks are capped at a quarter second of them, so a host stall
+ * catches up only that far, and a new count drops what the old rate owed.
+ * A guest that routes IRQ 0 elsewhere (an APIC HAL masks it at the 8259)
+ * owes nothing.
+ *
+ * And they are paced: an acknowledge raises the next owed edge only when
+ * half a period has passed since the last owed one, so a catch-up runs at
+ * twice the rate -- one regular tick and one owed per period -- and never
+ * as one burst. Raised at every acknowledge they nest: Windows 98's timer
+ * handler acknowledges early and runs with interrupts on, and a quarter
+ * second of 1 kHz ticks delivered back to back took the VMM down with a
+ * fatal exception 0D (2026-09-22, D3D7TEST on the Direct3D executor in
+ * the Wine process, whose first batch stalls the vCPU inside the doorbell
+ * write while wined3d compiles shaders; a 3.5 s stall at the status
+ * register reset the machine outright). Real hardware never stalls a CPU
+ * that long, and a guest that keeps interrupts off that long gets one
+ * edge; the paced catch-up is the nearest thing that keeps the clock. The
+ * pace is kept at the acknowledge and not by a timer of its own: a timer
+ * half a period out lands in the main loop's next wakeup beside the
+ * regular edge, the two merge into one, and the guest got one tick per
+ * wakeup -- 66 % on the Air, the rate phase of tools/pit-guest-test.py.
+ */
+static void pit_count_merged_edge(PITChannelState *s)
+{
+    /* a count of 0 is 65536, and before the reset nothing has loaded one */
+    uint32_t count = s->count > 0 ? (uint32_t)s->count : 0x10000;
+    uint32_t cap = MAX(8, PIT_FREQ / count / 4);
+
+    if (isa_pic && (isa_pic->irr & 1) && !(isa_pic->imr & 1) && s->owed < cap) {
+        s->owed++;
+    }
+}
+
+static void pit_irq0_acked(void *opaque)
+{
+    PITChannelState *s = opaque;
+    uint32_t count;
+    int64_t now, half;
+
+    if (!s->owed || s->irq_disabled) {
+        return;
+    }
+    count = s->count > 0 ? (uint32_t)s->count : 0x10000;
+    half = muldiv64(count, NANOSECONDS_PER_SECOND, PIT_FREQ) / 2;
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now - s->owed_last < half) {
+        return;             /* the next acknowledge, half a period on, raises it */
+    }
+    s->owed_last = now;
+    s->owed--;
+    /* a pulse, then the line back where the timer left it */
+    qemu_set_irq(s->irq, 0);
+    qemu_set_irq(s->irq, 1);
+    if (!s->out_level) {
+        qemu_set_irq(s->irq, 0);
+    }
+}
