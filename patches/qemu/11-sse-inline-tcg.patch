diff --git a/target/i386/tcg/sse-fast-lane.c.inc b/target/i386/tcg/sse-fast-lane.c.inc
new file mode 100644
index 0000000000..0d6ecebea1
--- /dev/null
+++ b/target/i386/tcg/sse-fast-lane.c.inc
@@ -0,0 +1,287 @@
+/*
+ * SSE inline fast path, per-lane code for one element width.
+ * Included twice from sse-fast.c.inc with W = 32 and W = 64. The
+ * conditions are documented there.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#define TCGv_iW         glue(TCGv_i, W)
+#define TMP()           glue(x87s_tmp_i, W)(s)
+#define OPW(name)       glue(glue(tcg_gen_, name), glue(_i, W))
+#define FPW(name)       glue(glue(tcg_gen_, name), glue(_f, W))
+#define CONSTW(v)       glue(tcg_constant_i, W)(v)
+#define LANEFN(name)    glue(glue(sses_, name), glue(_, W))
+
+#if W == 32
+#define LANE(i)         offsetof(ZMMReg, ZMM_L(i))
+#define NAN_LIMIT       0xff000000u             /* x << 1: >= exp all ones, > NaN */
+#define EXP_MASK        0x7f800000u
+#define EXP_LO          0x01000000u             /* exponent field 2 */
+#define EXP_RANGE       0x7e800000u             /* fields 2 .. 254 */
+#define ONE_BITS        0x3f800000u
+#define TO_I32(d, x)    tcg_gen_mov_i32(d, x)
+#else
+#define LANE(i)         offsetof(ZMMReg, ZMM_Q(i))
+#define NAN_LIMIT       0xffe0000000000000ull
+#define EXP_MASK        0x7ff0000000000000ull
+#define EXP_LO          0x0020000000000000ull
+#define EXP_RANGE       0x7fd0000000000000ull   /* fields 2 .. 2046 */
+#define ONE_BITS        0x3ff0000000000000ull
+#define TO_I32(d, x)    tcg_gen_extrl_i64_i32(d, x)
+#endif
+
+/*
+ * ok &= "r is an acceptable fast-path result". `z` is nonzero unless the
+ * result is an exact zero for the reason the fast path allows (an operand
+ * of a multiply, the dividend of a divide, is zero); NULL: no such case.
+ */
+static TCGv_iW LANEFN(check)(DisasContext *s, TCGv_iW ok, TCGv_iW r,
+                             TCGv_iW z, bool normal_only)
+{
+    TCGv_iW e = TMP();
+    TCGv_iW okl = TMP();
+
+    if (!normal_only) {
+        /* exponent field not all ones: no NaN, infinity or overflow */
+        OPW(shli)(e, r, 1);
+        OPW(setcondi)(TCG_COND_LTU, okl, e, NAN_LIMIT);
+    } else {
+        /* exponent field in [2, max - 1], or an allowed exact zero */
+        TCGv_iW t = TMP();
+        TCGv_iW pz = TMP();
+
+        OPW(andi)(e, r, EXP_MASK);
+        OPW(subi)(t, e, EXP_LO);
+        OPW(setcondi)(TCG_COND_LTU, okl, t, EXP_RANGE);
+        if (z) {
+            OPW(setcondi)(TCG_COND_EQ, pz, z, 0);
+            OPW(setcondi)(TCG_COND_NE, t, e, EXP_MASK);   /* not 0 * inf */
+            OPW(and)(pz, pz, t);
+            OPW(or)(okl, okl, pz);
+        }
+    }
+    if (ok) {
+        OPW(and)(ok, ok, okl);
+        return ok;
+    }
+    return okl;
+}
+
+/*
+ * ok &= "x is no denormal": with t = x << 1, a denormal is t in
+ * [1, EXP_LO - 1], EXP_LO being the first normal exponent field in that
+ * space too. Since QEMU 10.1 softfloat raises DE on a denormal operand.
+ */
+static TCGv_iW LANEFN(nodenorm)(DisasContext *s, TCGv_iW ok, TCGv_iW x)
+{
+    TCGv_iW t = TMP();
+    TCGv_iW okl = TMP();
+
+    OPW(shli)(t, x, 1);
+    OPW(subi)(t, t, 1);
+    OPW(setcondi)(TCG_COND_GEU, okl, t, EXP_LO - 1);
+    if (ok) {
+        OPW(and)(ok, ok, okl);
+        return ok;
+    }
+    return okl;
+}
+
+/* r = a op b (unary ops: b), see the table in sse-fast.c.inc */
+static TCGv_iW LANEFN(arith)(DisasContext *s, int op, TCGv_iW r,
+                             TCGv_iW a, TCGv_iW b, TCGv_iW ok)
+{
+    TCGv_iW z = TMP();
+    TCGv_iW t;
+
+    switch (op) {
+    case SSES_ADD:
+        FPW(add)(r, a, b);
+        return LANEFN(check)(s, ok, r, NULL, false);
+    case SSES_SUB:
+        FPW(sub)(r, a, b);
+        return LANEFN(check)(s, ok, r, NULL, false);
+    case SSES_SQRT:
+        FPW(sqrt)(r, b);
+        return LANEFN(check)(s, ok, r, NULL, false);
+    case SSES_MUL:
+        FPW(mul)(r, a, b);
+        t = TMP();
+        OPW(shli)(z, a, 1);
+        OPW(shli)(t, b, 1);
+        OPW(umin)(z, z, t);                     /* zero iff a or b is zero */
+        return LANEFN(check)(s, ok, r, z, true);
+    case SSES_DIV:
+        FPW(div)(r, a, b);
+        OPW(shli)(z, a, 1);                     /* zero iff the dividend is zero */
+        return LANEFN(check)(s, ok, r, z, true);
+    case SSES_RCP:
+        FPW(div)(r, CONSTW(ONE_BITS), b);
+        return LANEFN(check)(s, ok, r, NULL, true);
+    case SSES_RSQRT:
+        t = TMP();
+        FPW(sqrt)(t, b);
+        FPW(div)(r, CONSTW(ONE_BITS), t);
+        return LANEFN(check)(s, ok, r, NULL, true);
+    default:
+        g_assert_not_reached();
+    }
+}
+
+/* total-order key of a non-NaN value (t = x << 1): -0 -> +0, negatives flipped */
+static void LANEFN(key)(DisasContext *s, TCGv_iW k, TCGv_iW x, TCGv_iW t)
+{
+    TCGv_iW zero = CONSTW(0);
+    TCGv_iW c = TMP();
+    TCGv_iW sgn = TMP();
+
+    OPW(movcond)(TCG_COND_EQ, c, t, zero, zero, x);
+    OPW(sari)(sgn, c, W - 1);
+    OPW(shri)(sgn, sgn, 1);
+    OPW(xor)(k, c, sgn);
+}
+
+/* ok &= neither a nor b is a NaN; ka, kb = their keys */
+static TCGv_iW LANEFN(keys)(DisasContext *s, TCGv_iW ok, TCGv_iW ka,
+                            TCGv_iW kb, TCGv_iW a, TCGv_iW b)
+{
+    TCGv_iW ta = TMP();
+    TCGv_iW tb = TMP();
+    TCGv_iW m = TMP();
+    TCGv_iW okl = TMP();
+
+    OPW(shli)(ta, a, 1);
+    OPW(shli)(tb, b, 1);
+    OPW(umax)(m, ta, tb);
+    OPW(setcondi)(TCG_COND_LEU, okl, m, NAN_LIMIT);
+    LANEFN(key)(s, ka, a, ta);
+    LANEFN(key)(s, kb, b, tb);
+    if (ok) {
+        OPW(and)(ok, ok, okl);
+        return ok;
+    }
+    return okl;
+}
+
+/* comis/ucomis: cc = CC_Z (equal) | CC_C (less), other flags clear */
+static void LANEFN(comis)(DisasContext *s, TCGv_i32 cc, TCGv_iW a,
+                          TCGv_iW b, TCGLabel *slow)
+{
+    TCGv_iW ka = TMP();
+    TCGv_iW kb = TMP();
+    TCGv_iW eq = TMP();
+    TCGv_iW lt = TMP();
+    TCGv_iW t = TMP();
+    TCGv_iW ok;
+
+    ok = LANEFN(keys)(s, NULL, ka, kb, a, b);
+    ok = LANEFN(nodenorm)(s, ok, a);
+    ok = LANEFN(nodenorm)(s, ok, b);
+    OPW(brcondi)(TCG_COND_EQ, ok, 0, slow);
+    OPW(setcond)(TCG_COND_EQ, eq, ka, kb);
+    OPW(setcond)(TCG_COND_LT, lt, ka, kb);
+    OPW(movcond)(TCG_COND_NE, t, eq, CONSTW(0), CONSTW(CC_Z), CONSTW(0));
+    OPW(movcond)(TCG_COND_NE, lt, lt, CONSTW(0), CONSTW(CC_C), CONSTW(0));
+    OPW(or)(t, t, lt);
+    TO_I32(cc, t);
+}
+
+/* min: lt(a, b) ? a : b; max: lt(b, a) ? a : b (Intel's operand order rules) */
+static TCGv_iW LANEFN(minmax)(DisasContext *s, bool max, TCGv_iW r,
+                              TCGv_iW a, TCGv_iW b, TCGv_iW ok)
+{
+    TCGv_iW ka = TMP();
+    TCGv_iW kb = TMP();
+    TCGv_iW lt = TMP();
+
+    ok = LANEFN(keys)(s, ok, ka, kb, a, b);
+    if (max) {
+        OPW(setcond)(TCG_COND_LT, lt, kb, ka);
+    } else {
+        OPW(setcond)(TCG_COND_LT, lt, ka, kb);
+    }
+    OPW(movcond)(TCG_COND_NE, r, lt, CONSTW(0), a, b);
+    return ok;
+}
+
+/* cmpps predicate 0..7: eq lt le unord neq nlt nle ord -> all-ones / 0 */
+static TCGv_iW LANEFN(cmp)(DisasContext *s, int pred, TCGv_iW r,
+                           TCGv_iW a, TCGv_iW b, TCGv_iW ok)
+{
+    static const TCGCond conds[8] = {
+        TCG_COND_EQ, TCG_COND_LT, TCG_COND_LE, TCG_COND_NEVER,
+        TCG_COND_NE, TCG_COND_GE, TCG_COND_GT, TCG_COND_ALWAYS,
+    };
+    TCGv_iW ka = TMP();
+    TCGv_iW kb = TMP();
+
+    ok = LANEFN(keys)(s, ok, ka, kb, a, b);
+    if (pred == 3) {
+        OPW(movi)(r, 0);
+    } else if (pred == 7) {
+        OPW(movi)(r, -1);
+    } else {
+        OPW(setcond)(conds[pred], r, ka, kb);
+        OPW(neg)(r, r);
+    }
+    return ok;
+}
+
+/*
+ * The scalar form of an arithmetic, min/max or compare instruction: lane
+ * 0 of op[0] = op[1] op op[2] (unary: op[2]) in general registers, one
+ * branch to the slow block before the store.
+ */
+static void LANEFN(scalar)(DisasContext *s, X86DecodedInsn *decode, int op,
+                           int pred, TCGLabel *slow)
+{
+    bool unary = op == SSES_SQRT || op == SSES_RCP || op == SSES_RSQRT;
+    int d = vector_reg_offset(&decode->op[0]);
+    int src = vector_reg_offset(&decode->op[2]);
+    TCGv_iW a = NULL;
+    TCGv_iW b = TMP();
+    TCGv_iW r = TMP();
+    TCGv_iW ok;
+
+    OPW(ld)(b, tcg_env, src + LANE(0));
+    if (!unary) {
+        a = TMP();
+        OPW(ld)(a, tcg_env, vector_reg_offset(&decode->op[1]) + LANE(0));
+    }
+    switch (op) {
+    case SSES_MIN:
+    case SSES_MAX:
+        ok = LANEFN(minmax)(s, op == SSES_MAX, r, a, b, NULL);
+        break;
+    case SSES_CMP:
+        ok = LANEFN(cmp)(s, pred, r, a, b, NULL);
+        break;
+    default:
+        ok = LANEFN(arith)(s, op, r, a, b, NULL);
+        break;
+    }
+    if (op != SSES_RCP && op != SSES_RSQRT) {   /* those restore the flags */
+        ok = LANEFN(nodenorm)(s, ok, b);
+        if (!unary) {
+            ok = LANEFN(nodenorm)(s, ok, a);
+        }
+    }
+    OPW(brcondi)(TCG_COND_EQ, ok, 0, slow);
+    OPW(st)(r, tcg_env, d + LANE(0));
+}
+
+#undef TCGv_iW
+#undef TMP
+#undef OPW
+#undef FPW
+#undef CONSTW
+#undef LANEFN
+#undef LANE
+#undef NAN_LIMIT
+#undef EXP_MASK
+#undef EXP_LO
+#undef EXP_RANGE
+#undef ONE_BITS
+#undef TO_I32
+#undef W
diff --git a/target/i386/tcg/sse-fast.c.inc b/target/i386/tcg/sse-fast.c.inc
new file mode 100644
index 0000000000..e3a35a8f8b
--- /dev/null
+++ b/target/i386/tcg/sse-fast.c.inc
@@ -0,0 +1,734 @@
+/*
+ * SSE inline fast path: scalar and packed binary32/binary64 arithmetic,
+ * compares and int conversions on the host FPU, emitted inline by TCG
+ * (opcodes add_f32 .. cvtt_f64_i32, add_f64 .. of x87-shadow.c.inc).
+ * Doc 16 in the repository.
+ *
+ * Mode. A TB is translated in "SSE fast" mode (TB_FLAG_SSE_FAST) when
+ * MXCSR admits the host FPU verbatim (round to nearest, no FTZ/DAZ, all
+ * six exceptions masked, property sse-fast on: env->sse_fast_mode, kept
+ * by update_mxcsr_status) and the precision flag is already sticky in
+ * env->sse_status. That second condition is what makes the inline code
+ * flag-exact without a residual per lane: an admissible operation can
+ * raise nothing but PE, every other outcome is caught by a
+ * classification check on the result (on the operands for min/max and
+ * compares) and the instruction then runs the unmodified helper out of
+ * line. It is also the gate of softfloat's own hardfloat path.
+ *
+ * Whatever can change MXCSR or clear the flags (ldmxcsr, fxrstor, xrstor)
+ * ends the TB. A TB translated without the flag exits after the helper
+ * that first raises PE (sses_helper_done) so the next lookup finds the
+ * fast variant, and a runtime guard at the first inlined instruction of
+ * a fast TB re-executes it from a correctly translated block if the
+ * state does not match (it cannot, unless a clearing site was missed).
+ *
+ * Fast conditions (softfloat with DAZ/FTZ off). Denormal operands are
+ * exact, but since QEMU 10.1 (57df511180) softfloat raises DE when it
+ * consumes one, so every operation below but rcp/rsqrt (whose helpers
+ * restore the flags) and the int32 conversions (which raise no DE, as on
+ * the hardware) also needs no denormal operand:
+ *   add, sub, sqrt      result exponent field not all ones (no NaN, inf,
+ *                       overflow); a tiny add/sub result is exact and
+ *                       sqrt cannot underflow
+ *   mul, div, cvtsd2ss  result exponent field in [2, max - 1], or an exact
+ *                       zero because a factor / the dividend is zero: no
+ *                       NaN, inf, overflow, division by zero, underflow
+ *                       (whether tininess is detected before or after
+ *                       rounding)
+ *   rcp, rsqrt          normal result (the helpers restore the flags)
+ *   min, max, cmp,      no NaN operand; native minps/maxps/cmpps when the
+ *   comis, ucomis       host supports them (tcg_fp_minmax/cmp_vec_
+ *                       supported(), x86-64 only: same ISA as the guest,
+ *                       so -0/+0 tie-break and NaN-operand-selection come
+ *                       for free), else the portable fallback compares
+ *                       integer keys (-0 folded to +0)
+ *   cvt to int32        |x| < 2^31 - 1/2 (no overflow with either
+ *                       rounding; softfloat gives 0x80000000 + IE)
+ *   cvt from int32      always (PE only)
+ *   cvtss2sd            result not NaN/inf (an SNaN input raises IE)
+ * Everything else takes the slow block of the instruction: the helper
+ * and a TB exit to the next instruction, as x87-shadow does. Legacy SSE
+ * encodings only (VEX forms take the helpers). The slow blocks share the
+ * X87SlowBlock array and emitter.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#define W 32
+#include "sse-fast-lane.c.inc"
+#define W 64
+#include "sse-fast-lane.c.inc"
+
+/* room for the instruction's slow block and the guard */
+static bool sses_admissible(DisasContext *s)
+{
+    return s->sses_on && !(s->prefix & PREFIX_VEX)
+        && s->x87s_nslow + 2 <= X87S_MAX_SLOW;
+}
+
+/* t = env->sse_fast_mode & PE sticky: nonzero when the inline path applies now */
+static void sses_state(DisasContext *s, TCGv_i32 t)
+{
+    TCGv_i32 f = x87s_tmp_i32(s);
+
+    tcg_gen_ld8u_i32(t, tcg_env, offsetof(CPUX86State, sse_fast_mode));
+    /*
+     * float_exception_flags is a 16-bit bit-field since QEMU 11.1
+     * (8c86fe2451), and the first one of float_status: on a little-endian
+     * host, the low 16 bits at the struct's own offset.
+     */
+    QEMU_BUILD_BUG_ON(HOST_BIG_ENDIAN);
+    tcg_gen_ld16u_i32(f, tcg_env, offsetof(CPUX86State, sse_status));
+    tcg_gen_shri_i32(f, f, ctz32(float_flag_inexact));
+    tcg_gen_and_i32(t, t, f);
+}
+
+/* Runtime guard, once per TB (see the header). */
+static void sses_guard(DisasContext *s)
+{
+    X87SlowBlock *b;
+    TCGv_i32 t;
+
+    if (s->sses_guarded) {
+        return;
+    }
+    s->sses_guarded = true;
+    b = x87s_new_slow(s, SSES_SLOW_GUARD);
+    t = x87s_tmp_i32(s);
+    sses_state(s, t);
+    tcg_gen_brcondi_i32(TCG_COND_EQ, t, 0, b->label);
+}
+
+/*
+ * After a helper that may raise PE, in a TB translated without the fast
+ * flag: leave the TB if the fast path now applies, so the loop this
+ * instruction sits in gets retranslated inline instead of running the
+ * helpers until the next lookup. The check is emitted at the end of the
+ * instruction (sses_emit_pending, from the decoder), after its register
+ * and flags write-back.
+ */
+static void sses_helper_done(DisasContext *s)
+{
+    if (s->sses_on || !tcg_f64_supported()
+        || (s->flags & (HF_TF_MASK | HF_INHIBIT_IRQ_MASK))
+        || s->x87s_nslow + 1 > X87S_MAX_SLOW) {
+        return;
+    }
+    s->sses_pending = true;
+}
+
+static void sses_emit_pending(DisasContext *s)
+{
+    X87SlowBlock *b;
+    TCGv_i32 t;
+
+    if (!s->sses_pending) {
+        return;
+    }
+    s->sses_pending = false;
+    b = x87s_new_slow(s, SSES_SLOW_EXIT_NEXT);
+    t = x87s_tmp_i32(s);
+    sses_state(s, t);
+    tcg_gen_brcondi_i32(TCG_COND_NE, t, 0, b->label);
+    x87s_free_tmps(s);
+}
+
+/* MXCSR (or the flags) may change: the fast flag is a TB flag */
+static void sses_end_tb(DisasContext *s)
+{
+    if (tcg_f64_supported()) {
+        s->base.is_jmp = DISAS_EOB_NEXT;
+    }
+}
+
+static X87SlowBlock *sses_slow(DisasContext *s, X86DecodedInsn *decode,
+                               int kind, void *fn, int nargs)
+{
+    X87SlowBlock *b = x87s_new_slow(s, kind);
+    int i;
+
+    b->fn = fn;
+    b->nargs = nargs;
+    for (i = 0; i < 3; i++) {
+        X86DecodedOp *op = &decode->op[i];
+
+        b->off[i] = op->unit == X86_OP_SSE ? vector_reg_offset(op) : 0;
+    }
+    return b;
+}
+
+static TCGv_ptr sses_ptr(DisasContext *s, X87SlowBlock *b, int i)
+{
+    TCGv_ptr p = x87s_tmp_ptr(s);
+
+    tcg_gen_addi_ptr(p, tcg_env, b->off[i]);
+    return p;
+}
+
+static void sses_count(DisasContext *s, int idx)
+{
+    TCGv_i64 t = x87s_tmp_i64(s);
+    int off = offsetof(CPUX86State, sses_stat[idx]);
+
+    tcg_gen_ld_i64(t, tcg_env, off);
+    tcg_gen_addi_i64(t, t, 1);
+    tcg_gen_st_i64(t, tcg_env, off);
+}
+
+/* Called by x87s_emit_slow_blocks with the translator state restored. */
+static void sses_emit_slow_block(DisasContext *s, X87SlowBlock *b)
+{
+    x87s_flush_code(s);
+    sses_count(s, b->kind == SSES_SLOW_GUARD ? 0 : b->kind == SSES_SLOW_EXIT_NEXT ? 1
+               : b->kind == SSES_SLOW_HELPER ? 2 : 3);
+    switch (b->kind) {
+    case SSES_SLOW_GUARD:
+        x87s_exit_to(s, b->pc_insn);
+        return;
+    case SSES_SLOW_EXIT_NEXT:
+        break;
+    case SSES_SLOW_HELPER:
+        if (b->nargs == 3) {
+            ((SSEFunc_0_eppp)b->fn)(tcg_env, sses_ptr(s, b, 0),
+                                    sses_ptr(s, b, 1), sses_ptr(s, b, 2));
+        } else {
+            ((SSEFunc_0_epp)b->fn)(tcg_env, sses_ptr(s, b, 0),
+                                   sses_ptr(s, b, 2));
+        }
+        break;
+    case SSES_SLOW_CVT2SI: {
+        TCGv_i32 r = x87s_tmp_i32(s);
+        TCGv t = tcg_temp_new();
+
+        ((SSEFunc_i_ep)b->fn)(r, tcg_env, sses_ptr(s, b, 2));
+        tcg_gen_extu_i32_tl(t, r);
+        gen_op_mov_reg_v(s, b->reg_ot, b->reg_n, t);
+        break;
+    }
+    case SSES_SLOW_COMIS:
+        ((SSEFunc_0_epp)b->fn)(tcg_env, sses_ptr(s, b, 1), sses_ptr(s, b, 2));
+        assume_cc_op(s, CC_OP_EFLAGS);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    x87s_exit_to(s, b->pc_next);
+}
+
+/* ------------------------------------------------------------------ */
+/* vector path: arithmetic, min/max and compares, all lanes or lane 0    */
+
+typedef struct SSESVec {
+    TCGType type;
+    unsigned vece;
+    uint64_t nan_limit;         /* x << 1 above this: NaN; at or above: exp all ones */
+    uint64_t exp_mask, exp_lo, exp_range;   /* fields 2 .. max - 1 */
+    uint64_t one;
+    TCGv_vec tmps[24];
+    int ntmps;
+} SSESVec;
+
+static void sses_vinit(SSESVec *v, bool dbl)
+{
+    v->type = TCG_TYPE_V128;
+    v->ntmps = 0;
+    if (dbl) {
+        v->vece = MO_64;
+        v->nan_limit = 0xffe0000000000000ull;
+        v->exp_mask = 0x7ff0000000000000ull;
+        v->exp_lo = 0x0020000000000000ull;
+        v->exp_range = 0x7fd0000000000000ull;
+        v->one = 0x3ff0000000000000ull;
+    } else {
+        v->vece = MO_32;
+        v->nan_limit = 0xff000000u;
+        v->exp_mask = 0x7f800000u;
+        v->exp_lo = 0x01000000u;
+        v->exp_range = 0x7e800000u;
+        v->one = 0x3f800000u;
+    }
+}
+
+static TCGv_vec sses_vtmp(SSESVec *v)
+{
+    TCGv_vec t = tcg_temp_new_vec(v->type);
+
+    tcg_debug_assert(v->ntmps < ARRAY_SIZE(v->tmps));
+    v->tmps[v->ntmps++] = t;
+    return t;
+}
+
+static void sses_vfree(SSESVec *v)
+{
+    int i;
+
+    for (i = 0; i < v->ntmps; i++) {
+        tcg_temp_free_vec(v->tmps[i]);
+    }
+    v->ntmps = 0;
+}
+
+static TCGv_vec sses_vconst(SSESVec *v, uint64_t c)
+{
+    return tcg_constant_vec(v->type, v->vece, c);
+}
+
+/*
+ * Lanes whose result is acceptable, all ones. `pz`: lanes where an exact
+ * zero result is allowed (a factor / the dividend is zero), or NULL.
+ */
+static TCGv_vec sses_vcheck(SSESVec *v, TCGv_vec r, TCGv_vec pz, bool normal_only)
+{
+    unsigned vece = v->vece;
+    TCGv_vec ok = sses_vtmp(v);
+    TCGv_vec t = sses_vtmp(v);
+
+    if (!normal_only) {
+        tcg_gen_shli_vec(vece, t, r, 1);
+        tcg_gen_cmp_vec(TCG_COND_LTU, vece, ok, t, sses_vconst(v, v->nan_limit));
+    } else {
+        TCGv_vec e = sses_vtmp(v);
+
+        tcg_gen_and_vec(vece, e, r, sses_vconst(v, v->exp_mask));
+        tcg_gen_sub_vec(vece, t, e, sses_vconst(v, v->exp_lo));
+        tcg_gen_cmp_vec(TCG_COND_LTU, vece, ok, t, sses_vconst(v, v->exp_range));
+        if (pz) {
+            tcg_gen_cmp_vec(TCG_COND_NE, vece, t, e, sses_vconst(v, v->exp_mask));
+            tcg_gen_and_vec(vece, t, t, pz);
+            tcg_gen_or_vec(vece, ok, ok, t);
+        }
+    }
+    return ok;
+}
+
+/* ok with the lanes where x is a denormal cleared (sses_nodenorm_*) */
+static TCGv_vec sses_vnodenorm(SSESVec *v, TCGv_vec ok, TCGv_vec x)
+{
+    unsigned vece = v->vece;
+    TCGv_vec t = sses_vtmp(v);
+
+    tcg_gen_shli_vec(vece, t, x, 1);
+    tcg_gen_sub_vec(vece, t, t, sses_vconst(v, 1));
+    tcg_gen_cmp_vec(TCG_COND_LTU, vece, t, t, sses_vconst(v, v->exp_lo - 1));
+    tcg_gen_andc_vec(vece, ok, ok, t);
+    return ok;
+}
+
+/* lanes where x is zero (either sign), all ones; t = x << 1 out */
+static TCGv_vec sses_vzero(SSESVec *v, TCGv_vec x, TCGv_vec *tp)
+{
+    TCGv_vec t = sses_vtmp(v);
+    TCGv_vec z = sses_vtmp(v);
+
+    tcg_gen_shli_vec(v->vece, t, x, 1);
+    tcg_gen_cmp_vec(TCG_COND_EQ, v->vece, z, t, sses_vconst(v, 0));
+    if (tp) {
+        *tp = t;
+    }
+    return z;
+}
+
+/* total-order key of a non-NaN lane: -0 folded to +0, negatives flipped */
+static TCGv_vec sses_vkey(SSESVec *v, TCGv_vec x, TCGv_vec z)
+{
+    unsigned vece = v->vece;
+    TCGv_vec c = sses_vtmp(v);
+    TCGv_vec sgn = sses_vtmp(v);
+    TCGv_vec k = sses_vtmp(v);
+
+    tcg_gen_andc_vec(vece, c, x, z);
+    tcg_gen_sari_vec(vece, sgn, c, (8 << vece) - 1);
+    tcg_gen_shri_vec(vece, sgn, sgn, 1);
+    tcg_gen_xor_vec(vece, k, c, sgn);
+    return k;
+}
+
+/* ok = lanes with no NaN operand; keys of both operands */
+static TCGv_vec sses_vkeys(SSESVec *v, TCGv_vec a, TCGv_vec b,
+                           TCGv_vec *ka, TCGv_vec *kb)
+{
+    unsigned vece = v->vece;
+    TCGv_vec ta, tb;
+    TCGv_vec za = sses_vzero(v, a, &ta);
+    TCGv_vec zb = sses_vzero(v, b, &tb);
+    TCGv_vec na = sses_vtmp(v);
+    TCGv_vec nb = sses_vtmp(v);
+    TCGv_vec ok = sses_vtmp(v);
+
+    tcg_gen_cmp_vec(TCG_COND_GTU, vece, na, ta, sses_vconst(v, v->nan_limit));
+    tcg_gen_cmp_vec(TCG_COND_GTU, vece, nb, tb, sses_vconst(v, v->nan_limit));
+    tcg_gen_or_vec(vece, ok, na, nb);
+    tcg_gen_not_vec(vece, ok, ok);
+    *ka = sses_vkey(v, a, za);
+    *kb = sses_vkey(v, b, zb);
+    return ok;
+}
+
+/*
+ * ok = lanes with no NaN operand, without the total-order key transform:
+ * for use with the native minps/maxps/cmpps opcodes (tcg_fp_minmax_vec_
+ * supported() / tcg_fp_cmp_vec_supported()), which already implement
+ * the guest's own -0/+0 tie-break and NaN-operand-selection rules
+ * exactly (same host ISA as the guest here), so sses_vkeys's key
+ * computation -- needed only to give cmp_vec's integer compare a
+ * monotonic float ordering -- is dead weight on this path.
+ */
+static TCGv_vec sses_vnan_ok(SSESVec *v, TCGv_vec a, TCGv_vec b)
+{
+    unsigned vece = v->vece;
+    TCGv_vec ta = sses_vtmp(v);
+    TCGv_vec tb = sses_vtmp(v);
+    TCGv_vec na = sses_vtmp(v);
+    TCGv_vec nb = sses_vtmp(v);
+    TCGv_vec ok = sses_vtmp(v);
+
+    tcg_gen_shli_vec(vece, ta, a, 1);
+    tcg_gen_shli_vec(vece, tb, b, 1);
+    tcg_gen_cmp_vec(TCG_COND_GTU, vece, na, ta, sses_vconst(v, v->nan_limit));
+    tcg_gen_cmp_vec(TCG_COND_GTU, vece, nb, tb, sses_vconst(v, v->nan_limit));
+    tcg_gen_or_vec(vece, ok, na, nb);
+    tcg_gen_not_vec(vece, ok, ok);
+    return ok;
+}
+
+/*
+ * One packed arithmetic, min/max or compare instruction on the vector
+ * unit: op[0] = op[1] op op[2] (unary: op[2]). Every lane is computed
+ * and checked; the lane mask goes through env->sses_scratch (TCG has no
+ * vector-to-scalar move), then one branch to the slow block, then the
+ * store: nothing is written before the check. Scalar forms use the
+ * general-register lane code (sse-fast-lane.c.inc).
+ */
+static void sses_vec_insn(DisasContext *s, X86DecodedInsn *decode, int op,
+                          int pred, bool dbl, TCGLabel *slow)
+{
+    static const TCGCond conds[8] = {
+        TCG_COND_EQ, TCG_COND_LT, TCG_COND_LE, TCG_COND_NEVER,
+        TCG_COND_NE, TCG_COND_GE, TCG_COND_GT, TCG_COND_ALWAYS,
+    };
+    SSESVec vv, *v = &vv;
+    unsigned vece;
+    int d = vector_reg_offset(&decode->op[0]);
+    int src = vector_reg_offset(&decode->op[2]);
+    bool unary = op == SSES_SQRT || op == SSES_RCP || op == SSES_RSQRT;
+    int scratch = offsetof(CPUX86State, sses_scratch[0]);
+    TCGv_vec a = NULL, b, r, ok, t, pz, ka, kb;
+    TCGv_i64 lo, hi;
+
+    sses_vinit(v, dbl);
+    vece = v->vece;
+    b = sses_vtmp(v);
+    tcg_gen_ld_vec(b, tcg_env, src);
+    if (!unary) {
+        a = sses_vtmp(v);
+        tcg_gen_ld_vec(a, tcg_env, vector_reg_offset(&decode->op[1]));
+    }
+    r = sses_vtmp(v);
+    switch (op) {
+    case SSES_ADD:
+        tcg_gen_fadd_vec(vece, r, a, b);
+        ok = sses_vcheck(v, r, NULL, false);
+        break;
+    case SSES_SUB:
+        tcg_gen_fsub_vec(vece, r, a, b);
+        ok = sses_vcheck(v, r, NULL, false);
+        break;
+    case SSES_SQRT:
+        tcg_gen_fsqrt_vec(vece, r, b);
+        ok = sses_vcheck(v, r, NULL, false);
+        break;
+    case SSES_MUL:
+        tcg_gen_fmul_vec(vece, r, a, b);
+        pz = sses_vzero(v, a, NULL);
+        t = sses_vzero(v, b, NULL);
+        tcg_gen_or_vec(vece, pz, pz, t);
+        ok = sses_vcheck(v, r, pz, true);
+        break;
+    case SSES_DIV:
+        tcg_gen_fdiv_vec(vece, r, a, b);
+        pz = sses_vzero(v, a, NULL);
+        ok = sses_vcheck(v, r, pz, true);
+        break;
+    case SSES_RCP:
+        tcg_gen_fdiv_vec(vece, r, sses_vconst(v, v->one), b);
+        ok = sses_vcheck(v, r, NULL, true);
+        break;
+    case SSES_RSQRT:
+        t = sses_vtmp(v);
+        tcg_gen_fsqrt_vec(vece, t, b);
+        tcg_gen_fdiv_vec(vece, r, sses_vconst(v, v->one), t);
+        ok = sses_vcheck(v, r, NULL, true);
+        break;
+    case SSES_MIN:
+    case SSES_MAX:
+        if (tcg_fp_minmax_vec_supported(vece)) {
+            ok = sses_vnan_ok(v, a, b);
+            if (op == SSES_MAX) {
+                tcg_gen_fmax_vec(vece, r, a, b);
+            } else {
+                tcg_gen_fmin_vec(vece, r, a, b);
+            }
+            break;
+        }
+        ok = sses_vkeys(v, a, b, &ka, &kb);
+        t = sses_vtmp(v);
+        if (op == SSES_MAX) {
+            tcg_gen_cmp_vec(TCG_COND_LT, vece, t, kb, ka);
+        } else {
+            tcg_gen_cmp_vec(TCG_COND_LT, vece, t, ka, kb);
+        }
+        tcg_gen_bitsel_vec(vece, r, t, a, b);
+        break;
+    case SSES_CMP:
+        if (tcg_fp_cmp_vec_supported(vece)) {
+            ok = sses_vnan_ok(v, a, b);
+            tcg_gen_fcmp_vec(vece, r, a, b, pred);
+            break;
+        }
+        ok = sses_vkeys(v, a, b, &ka, &kb);
+        if (pred == 3) {
+            tcg_gen_dupi_vec(vece, r, 0);
+        } else if (pred == 7) {
+            tcg_gen_dupi_vec(vece, r, -1);
+        } else {
+            tcg_gen_cmp_vec(conds[pred], vece, r, ka, kb);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    if (op != SSES_RCP && op != SSES_RSQRT) {   /* those restore the flags */
+        ok = sses_vnodenorm(v, ok, b);
+        if (!unary) {
+            ok = sses_vnodenorm(v, ok, a);
+        }
+    }
+
+    tcg_gen_st_vec(ok, tcg_env, scratch);
+    lo = x87s_tmp_i64(s);
+    hi = x87s_tmp_i64(s);
+    tcg_gen_ld_i64(lo, tcg_env, scratch);
+    tcg_gen_ld_i64(hi, tcg_env, scratch + 8);
+    tcg_gen_and_i64(lo, lo, hi);
+    tcg_gen_brcondi_i64(TCG_COND_NE, lo, -1, slow);
+    tcg_gen_st_vec(r, tcg_env, d);
+    sses_vfree(v);
+}
+
+/* ------------------------------------------------------------------ */
+/* instructions (return false: not inlined, emit the helper)            */
+
+/*
+ * add/sub/mul/div/min/max (pd, ps, sd, ss), sqrt (all four), rcp and
+ * rsqrt (ps, ss). The helper pointers are those the caller would use.
+ */
+static bool sses_arith(DisasContext *s, X86DecodedInsn *decode, int op,
+                       void *pd, void *ps, void *sd, void *ss)
+{
+    bool scalar = (s->prefix & (PREFIX_REPZ | PREFIX_REPNZ)) != 0;
+    bool dbl = (s->prefix & (PREFIX_DATA | PREFIX_REPNZ)) != 0;
+    bool unary = op == SSES_SQRT || op == SSES_RCP || op == SSES_RSQRT;
+    void *fn = scalar ? (dbl ? sd : ss) : (dbl ? pd : ps);
+    X87SlowBlock *b;
+
+    if (!fn || !sses_admissible(s) || !tcg_fp_vec_supported(dbl ? MO_64 : MO_32)
+        || (scalar && decode->op[0].offset != decode->op[1].offset)) {
+        return false;
+    }
+    b = sses_slow(s, decode, SSES_SLOW_HELPER, fn, unary && !scalar ? 2 : 3);
+    sses_guard(s);
+    if (!scalar) {
+        sses_vec_insn(s, decode, op, 0, dbl, b->label);
+    } else if (dbl) {
+        sses_scalar_64(s, decode, op, 0, b->label);
+    } else {
+        sses_scalar_32(s, decode, op, 0, b->label);
+    }
+    x87s_free_tmps(s);
+    return true;
+}
+
+/* cmpps/pd/ss/sd with a legacy predicate (immediate & 7) */
+static bool sses_cmp(DisasContext *s, X86DecodedInsn *decode, void *fn)
+{
+    bool scalar = (s->prefix & (PREFIX_REPZ | PREFIX_REPNZ)) != 0;
+    bool dbl = (s->prefix & (PREFIX_DATA | PREFIX_REPNZ)) != 0;
+    X87SlowBlock *b;
+
+    if (!sses_admissible(s) || !tcg_fp_vec_supported(dbl ? MO_64 : MO_32)
+        || (scalar && decode->op[0].offset != decode->op[1].offset)) {
+        return false;
+    }
+    b = sses_slow(s, decode, SSES_SLOW_HELPER, fn, 3);
+    sses_guard(s);
+    if (!scalar) {
+        sses_vec_insn(s, decode, SSES_CMP, decode->immediate & 7, dbl, b->label);
+    } else if (dbl) {
+        sses_scalar_64(s, decode, SSES_CMP, decode->immediate & 7, b->label);
+    } else {
+        sses_scalar_32(s, decode, SSES_CMP, decode->immediate & 7, b->label);
+    }
+    x87s_free_tmps(s);
+    return true;
+}
+
+/* comiss/comisd/ucomiss/ucomisd: op[1] vs op[2] -> eflags */
+static bool sses_comis(DisasContext *s, X86DecodedInsn *decode, void *fn)
+{
+    bool dbl = (s->prefix & PREFIX_DATA) != 0;
+    int v = vector_reg_offset(&decode->op[1]);
+    int src = vector_reg_offset(&decode->op[2]);
+    TCGv_i32 cc;
+    X87SlowBlock *b;
+
+    if (!sses_admissible(s)) {
+        return false;
+    }
+    cc = x87s_tmp_i32(s);
+    b = sses_slow(s, decode, SSES_SLOW_COMIS, fn, 2);
+    sses_guard(s);
+    if (dbl) {
+        TCGv_i64 a = x87s_tmp_i64(s);
+        TCGv_i64 c = x87s_tmp_i64(s);
+
+        tcg_gen_ld_i64(a, tcg_env, v + offsetof(ZMMReg, ZMM_Q(0)));
+        tcg_gen_ld_i64(c, tcg_env, src + offsetof(ZMMReg, ZMM_Q(0)));
+        sses_comis_64(s, cc, a, c, b->label);
+    } else {
+        TCGv_i32 a = x87s_tmp_i32(s);
+        TCGv_i32 c = x87s_tmp_i32(s);
+
+        tcg_gen_ld_i32(a, tcg_env, v + offsetof(ZMMReg, ZMM_L(0)));
+        tcg_gen_ld_i32(c, tcg_env, src + offsetof(ZMMReg, ZMM_L(0)));
+        sses_comis_32(s, cc, a, c, b->label);
+    }
+    tcg_gen_extu_i32_tl(cpu_cc_src, cc);
+    set_cc_op(s, CC_OP_EFLAGS);
+    x87s_free_tmps(s);
+    return true;
+}
+
+/* cvtsi2ss/sd from a 32-bit integer: only PE can be raised, no slow block */
+static bool sses_cvtsi2s(DisasContext *s, X86DecodedInsn *decode, TCGv_i32 in)
+{
+    int d = vector_reg_offset(&decode->op[0]);
+
+    if (!sses_admissible(s)) {
+        return false;
+    }
+    sses_guard(s);
+    if (s->prefix & PREFIX_REPNZ) {
+        TCGv_i64 r = x87s_tmp_i64(s);
+
+        tcg_gen_cvt_i32_f64(r, in);
+        tcg_gen_st_i64(r, tcg_env, d + offsetof(ZMMReg, ZMM_Q(0)));
+    } else {
+        TCGv_i32 r = x87s_tmp_i32(s);
+
+        tcg_gen_cvt_i32_f32(r, in);
+        tcg_gen_st_i32(r, tcg_env, d + offsetof(ZMMReg, ZMM_L(0)));
+    }
+    x87s_free_tmps(s);
+    return true;
+}
+
+/* cvt(t)ss2si / cvt(t)sd2si to a 32-bit register (s->T0) */
+static bool sses_cvts2si(DisasContext *s, X86DecodedInsn *decode, bool trunc,
+                         void *ss2si, void *sd2si)
+{
+    bool dbl = (s->prefix & PREFIX_REPNZ) != 0;
+    int src = vector_reg_offset(&decode->op[2]);
+    TCGv_i32 r;
+    X87SlowBlock *b;
+
+    if (!sses_admissible(s) || decode->op[0].unit != X86_OP_INT) {
+        return false;
+    }
+    r = x87s_tmp_i32(s);
+    b = sses_slow(s, decode, SSES_SLOW_CVT2SI, dbl ? sd2si : ss2si, 0);
+    b->reg_ot = decode->op[0].ot;
+    b->reg_n = decode->op[0].n;
+    sses_guard(s);
+    if (dbl) {
+        TCGv_i64 a = x87s_tmp_i64(s);
+        TCGv_i64 t = x87s_tmp_i64(s);
+
+        tcg_gen_ld_i64(a, tcg_env, src + offsetof(ZMMReg, ZMM_Q(0)));
+        tcg_gen_shli_i64(t, a, 1);
+        /* |a| < 2^31 - 1/2 (0x41dfffffffe00000), also excludes NaN */
+        tcg_gen_brcondi_i64(TCG_COND_GEU, t, 0x83bfffffffc00000ull, b->label);
+        if (trunc) {
+            tcg_gen_cvtt_f64_i32(r, a);
+        } else {
+            tcg_gen_cvt_f64_i32(r, a);
+        }
+    } else {
+        TCGv_i32 a = x87s_tmp_i32(s);
+        TCGv_i32 t = x87s_tmp_i32(s);
+
+        tcg_gen_ld_i32(a, tcg_env, src + offsetof(ZMMReg, ZMM_L(0)));
+        tcg_gen_shli_i32(t, a, 1);
+        /* |a| < 2^31 (0x4f000000); floats there are integers already */
+        tcg_gen_brcondi_i32(TCG_COND_GEU, t, 0x9e000000u, b->label);
+        if (trunc) {
+            tcg_gen_cvtt_f32_i32(r, a);
+        } else {
+            tcg_gen_cvt_f32_i32(r, a);
+        }
+    }
+    tcg_gen_extu_i32_tl(s->T0, r);
+    x87s_free_tmps(s);
+    return true;
+}
+
+/* cvtss2sd (to_double) and cvtsd2ss, lane 0 of op[2] into lane 0 of op[0] */
+static bool sses_cvt_ss_sd(DisasContext *s, X86DecodedInsn *decode,
+                           bool to_double, void *fn)
+{
+    int d = vector_reg_offset(&decode->op[0]);
+    int src = vector_reg_offset(&decode->op[2]);
+    X87SlowBlock *b;
+
+    if (!sses_admissible(s)
+        || decode->op[0].offset != decode->op[1].offset) {
+        return false;
+    }
+    b = sses_slow(s, decode, SSES_SLOW_HELPER, fn, 3);
+    sses_guard(s);
+    if (to_double) {
+        TCGv_i32 a = x87s_tmp_i32(s);
+        TCGv_i64 a64 = x87s_tmp_i64(s);
+        TCGv_i64 r = x87s_tmp_i64(s);
+        TCGv_i64 t = x87s_tmp_i64(s);
+
+        tcg_gen_ld_i32(a, tcg_env, src + offsetof(ZMMReg, ZMM_L(0)));
+        tcg_gen_brcondi_i32(TCG_COND_EQ, sses_nodenorm_32(s, NULL, a), 0,
+                            b->label);
