WHPX's xsave state: the size the hypervisor asks for, and its real
error. whpx_get_xsave_state() sized its buffer by CPUID(0xD, 0).ECX, the
standard area of the XCR0 components, while the hypervisor returns the
compacted (XSAVES) area, which also holds the supervisor components the
guest enabled in IA32_XSS. Windows 11 enables some (CET), and a reset
of a running Windows 11 then logged "failed to get xsave state" once
per vCPU, followed sometimes by a VM that never ran again. On
WHV_E_INSUFFICIENT_BUFFER the get is retried with the size the
hypervisor wrote back; a failure reports the HRESULT and the sizes
(it printed errno, which no Windows API sets) and no longer leaks the
buffer; the set's failure no longer calls itself a get. Drop when
upstream sizes the area from the hypervisor's answer.

diff --git a/target/i386/whpx/whpx-all.c b/target/i386/whpx/whpx-all.c
index 87b1da5..b3bd765 100644
--- a/target/i386/whpx/whpx-all.c
+++ b/target/i386/whpx/whpx-all.c
@@ -51,6 +51,10 @@
 
 #include <winhvplatform.h>
 
+#ifndef WHV_E_INSUFFICIENT_BUFFER
+#define WHV_E_INSUFFICIENT_BUFFER 0x80370301L
+#endif
+
 #define HYPERV_APIC_BUS_FREQUENCY      (200000000ULL)
 /* for kernel-irqchip=off */
 #define HV_X64_MSR_APIC_FREQUENCY       0x40000023
@@ -443,8 +447,8 @@ static int whpx_set_xsave_state(const CPUState *cpu)
 
     qemu_vfree(xsavec_buf);
     if (FAILED(hr)) {
-        error_report("WHPX: Failed to get virtual processor context, hr=%08lx",
-                     hr);
+        error_report("WHPX: failed to set vCPU %d's xsave state, hr=%08lx",
+                     cpu->cpu_index, hr);
     }
 
     return 0;
@@ -822,24 +826,40 @@ static int whpx_get_xsave_state(CPUState *cpu)
     size_t xsavec_buf_len = whpx_get_xsave_max_len();
     UINT32 bytes_written;
 
-    xsavec_buf = qemu_memalign(page, xsavec_buf_len);
-    memset(xsavec_buf, 0, xsavec_buf_len);
-
-    if (!whpx_is_legacy_os()) {
-        hr = whp_dispatch.WHvGetVirtualProcessorState(
-            whpx->partition, cpu->cpu_index,
-            WHvVirtualProcessorStateTypeXsaveState,
-            xsavec_buf,
-            xsavec_buf_len, &bytes_written);
-    } else {
-        hr = whp_dispatch.WHvGetVirtualProcessorXsaveState(
-            whpx->partition, cpu->cpu_index,
-            xsavec_buf,
-            xsavec_buf_len, &bytes_written);
+    /*
+     * The hypervisor returns the compacted (XSAVES) area, which holds the
+     * supervisor components the guest enabled in IA32_XSS (Windows 11:
+     * CET) beside the XCR0 ones that CPUID(0xD, 0).ECX sizes, so the
+     * buffer can be too small: it then says how much it needs.
+     */
+    for (;;) {
+        xsavec_buf = qemu_memalign(page, xsavec_buf_len);
+        memset(xsavec_buf, 0, xsavec_buf_len);
+        bytes_written = 0;
+        if (!whpx_is_legacy_os()) {
+            hr = whp_dispatch.WHvGetVirtualProcessorState(
+                whpx->partition, cpu->cpu_index,
+                WHvVirtualProcessorStateTypeXsaveState,
+                xsavec_buf,
+                xsavec_buf_len, &bytes_written);
+        } else {
+            hr = whp_dispatch.WHvGetVirtualProcessorXsaveState(
+                whpx->partition, cpu->cpu_index,
+                xsavec_buf,
+                xsavec_buf_len, &bytes_written);
+        }
+        if (hr != WHV_E_INSUFFICIENT_BUFFER || bytes_written <= xsavec_buf_len) {
+            break;
+        }
+        qemu_vfree(xsavec_buf);
+        xsavec_buf_len = bytes_written;
     }
     if (FAILED(hr) || bytes_written == 0) {
-        error_report("failed to get xsave state: %s", strerror(errno));
-        return -errno;
+        error_report("WHPX: failed to get vCPU %d's xsave state, hr=%08lx "
+                     "(%u of %zu bytes)", cpu->cpu_index, hr, bytes_written,
+                     xsavec_buf_len);
+        qemu_vfree(xsavec_buf);
+        return -EIO;
     }
 
     ret = decompact_xsave_area(xsavec_buf, xsavec_buf_len, env);
