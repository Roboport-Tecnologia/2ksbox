diff --git a/util/oslib-msvc.c b/util/oslib-msvc.c
new file mode 100644
index 0000000..1824ac8
--- /dev/null
+++ b/util/oslib-msvc.c
@@ -0,0 +1,425 @@
+/*
+ * The POSIX functions mingw-w64 supplies and MSVC's runtime does not
+ * (2ksbox patch 83): built only when the compiler targets MSVC's ABI.
+ * Their declarations are include/msvc/.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <dirent.h>
+#include <libgen.h>
+
+/* getopt() and getopt_long(), with glibc's argument permutation */
+
+char *optarg;
+int optind = 1, opterr = 1, optopt = '?';
+
+static int nextchar;    /* position inside a cluster of short options */
+
+/* Move argv[from] down to argv[to], shifting the ones between up by one. */
+static void permute(char **argv, int to, int from)
+{
+    char *arg = argv[from];
+
+    memmove(&argv[to + 1], &argv[to], (from - to) * sizeof(argv[0]));
+    argv[to] = arg;
+}
+
+static int long_option(int argc, char **argv, const char *optstring,
+                       const struct option *longopts, int *longindex)
+{
+    const char *name = argv[optind] + 2;
+    const char *eq = strchr(name, '=');
+    size_t len = eq ? (size_t)(eq - name) : strlen(name);
+    int found = -1, i;
+    bool exact = false, ambiguous = false;
+    bool colon = optstring[0] == ':';
+
+    for (i = 0; longopts[i].name; i++) {
+        if (strncmp(longopts[i].name, name, len) != 0) {
+            continue;
+        }
+        if (strlen(longopts[i].name) == len) {
+            found = i;
+            exact = true;
+            break;
+        }
+        if (found >= 0) {
+            ambiguous = true;
+        } else {
+            found = i;
+        }
+    }
+    optind++;
+    if (found < 0 || (ambiguous && !exact)) {
+        if (opterr && !colon) {
+            fprintf(stderr, "%s: %s option '--%.*s'\n", argv[0],
+                    found < 0 ? "unrecognized" : "ambiguous", (int)len, name);
+        }
+        optopt = 0;
+        return '?';
+    }
+    optarg = NULL;
+    if (eq) {
+        if (longopts[found].has_arg == no_argument) {
+            if (opterr && !colon) {
+                fprintf(stderr, "%s: option '--%s' doesn't allow an argument\n",
+                        argv[0], longopts[found].name);
+            }
+            optopt = longopts[found].val;
+            return '?';
+        }
+        optarg = (char *)eq + 1;
+    } else if (longopts[found].has_arg == required_argument) {
+        if (optind >= argc) {
+            if (opterr && !colon) {
+                fprintf(stderr, "%s: option '--%s' requires an argument\n",
+                        argv[0], longopts[found].name);
+            }
+            optopt = longopts[found].val;
+            return colon ? ':' : '?';
+        }
+        optarg = argv[optind++];
+    }
+    if (longindex) {
+        *longindex = found;
+    }
+    if (longopts[found].flag) {
+        *longopts[found].flag = longopts[found].val;
+        return 0;
+    }
+    return longopts[found].val;
+}
+
+static int getopt_internal(int argc, char *const argv_[], const char *optstring,
+                           const struct option *longopts, int *longindex)
+{
+    char **argv = (char **)argv_;
+    bool permuting = true;
+    const char *spec;
+    int c;
+
+    if (optind == 0) {          /* glibc's way to start over */
+        optind = 1;
+        nextchar = 0;
+    }
+    if (*optstring == '+' || *optstring == '-') {
+        permuting = false;
+        optstring++;
+    }
+    if (getenv("POSIXLY_CORRECT")) {
+        permuting = false;
+    }
+    optarg = NULL;
+
+    if (nextchar == 0) {
+        if (optind >= argc) {
+            return -1;
+        }
+        if (permuting) {
+            /* skip non-options, bringing the next option to optind */
+            int i = optind;
+            while (i < argc && (argv[i][0] != '-' || argv[i][1] == '\0')) {
+                i++;
+            }
+            if (i >= argc) {
+                return -1;
+            }
+            if (i != optind) {
+                permute(argv, optind, i);
+            }
+        } else if (argv[optind][0] != '-' || argv[optind][1] == '\0') {
+            return -1;
+        }
+        if (strcmp(argv[optind], "--") == 0) {
+            optind++;
+            return -1;
+        }
+        if (longopts && argv[optind][1] == '-') {
+            return long_option(argc, argv, optstring, longopts, longindex);
+        }
+        nextchar = 1;
+    }
+
+    c = (unsigned char)argv[optind][nextchar++];
+    spec = c == ':' ? NULL : strchr(optstring, c);
+    if (argv[optind][nextchar] == '\0') {
+        optind++;
+        nextchar = 0;
+    }
+    if (!spec) {
+        if (opterr && *optstring != ':') {
+            fprintf(stderr, "%s: invalid option -- '%c'\n", argv[0], c);
+        }
+        optopt = c;
+        return '?';
+    }
+    if (spec[1] == ':') {
+        if (nextchar != 0) {
+            /* the rest of this argument is the option's */
+            optarg = &argv[optind][nextchar];
+            optind++;
+            nextchar = 0;
+        } else if (spec[2] != ':') {
+            if (optind >= argc) {
+                if (opterr && *optstring != ':') {
+                    fprintf(stderr, "%s: option requires an argument -- '%c'\n",
+                            argv[0], c);
+                }
+                optopt = c;
+                return *optstring == ':' ? ':' : '?';
+            }
+            optarg = argv[optind++];
+        }
+    }
+    return c;
+}
+
+int getopt(int argc, char *const argv[], const char *optstring)
+{
+    return getopt_internal(argc, argv, optstring, NULL, NULL);
+}
+
+int getopt_long(int argc, char *const argv[], const char *optstring,
+                const struct option *longopts, int *longindex)
+{
+    return getopt_internal(argc, argv, optstring, longopts, longindex);
+}
+
+/* Time */
+
+int gettimeofday(struct timeval *tv, void *tz)
+{
+    int64_t us = g_get_real_time();
+
+    tv->tv_sec = us / 1000000;
+    tv->tv_usec = us % 1000000;
+    return 0;
+}
+
+int clock_gettime(clockid_t clock_id, struct timespec *tp)
+{
+    int64_t ns;
+
+    if (clock_id == CLOCK_MONOTONIC) {
+        LARGE_INTEGER count, freq;
+        QueryPerformanceCounter(&count);
+        QueryPerformanceFrequency(&freq);
+        /* in two parts: no 128-bit division in MSVC's runtime */
+        ns = count.QuadPart / freq.QuadPart * 1000000000 +
+             count.QuadPart % freq.QuadPart * 1000000000 / freq.QuadPart;
+    } else if (clock_id == CLOCK_REALTIME) {
+        ns = g_get_real_time() * 1000;
+    } else {
+        errno = EINVAL;
+        return -1;
+    }
+    tp->tv_sec = ns / 1000000000;
+    tp->tv_nsec = ns % 1000000000;
+    return 0;
+}
+
+int nanosleep(const struct timespec *req, struct timespec *rem)
+{
+    g_usleep(req->tv_sec * G_USEC_PER_SEC + req->tv_nsec / 1000);
+    if (rem) {
+        rem->tv_sec = 0;
+        rem->tv_nsec = 0;
+    }
+    return 0;
+}
+
+int usleep(useconds_t usec)
+{
+    g_usleep(usec);
+    return 0;
+}
+
+unsigned int sleep(unsigned int seconds)
+{
+    g_usleep((gulong)seconds * G_USEC_PER_SEC);
+    return 0;
+}
+
+/* Files */
+
+int mkstemp(char *tmpl)
+{
+    return g_mkstemp(tmpl);
+}
+
+/* Path names, as POSIX's basename() and dirname(): in place */
+
+char *basename(char *path)
+{
+    char *end, *p;
+
+    if (!path || !*path) {
+        return (char *)".";
+    }
+    end = path + strlen(path) - 1;
+    while (end > path && (*end == '/' || *end == '\\')) {
+        *end-- = '\0';
+    }
+    for (p = end; p > path; p--) {
+        if (p[-1] == '/' || p[-1] == '\\' || (p == path + 2 && p[-1] == ':')) {
+            break;
+        }
+    }
+    return p;
+}
+
+char *dirname(char *path)
+{
+    char *base;
+
+    if (!path || !*path) {
+        return (char *)".";
+    }
+    base = basename(path);
+    if (base == path) {
+        return (char *)".";
+    }
+    while (base > path + 1 && (base[-1] == '/' || base[-1] == '\\')) {
+        base--;
+    }
+    *base = '\0';
+    if (base > path && (base[-1] == '/' || base[-1] == '\\') && base - 1 > path) {
+        base[-1] = '\0';
+    }
+    return path;
+}
+
+/* Directories, over FindFirstFile */
+
+struct QemuMsvcDir {
+    HANDLE find;
+    WIN32_FIND_DATAA data;
+    bool first;
+    char *pattern;
+    struct dirent ent;
+};
+
+DIR *opendir(const char *name)
+{
+    DIR *dir = g_new0(DIR, 1);
+
+    dir->pattern = g_build_filename(name, "*", NULL);
+    dir->find = FindFirstFileA(dir->pattern, &dir->data);
+    if (dir->find == INVALID_HANDLE_VALUE) {
+        errno = GetLastError() == ERROR_DIRECTORY ? ENOTDIR : ENOENT;
+        g_free(dir->pattern);
+        g_free(dir);
+        return NULL;
+    }
+    dir->first = true;
+    return dir;
+}
+
+struct dirent *readdir(DIR *dir)
+{
+    if (!dir->first) {
+        if (!FindNextFileA(dir->find, &dir->data)) {
+            return NULL;
+        }
+    }
+    dir->first = false;
+    g_strlcpy(dir->ent.d_name, dir->data.cFileName, sizeof(dir->ent.d_name));
+    dir->ent.d_namlen = strlen(dir->ent.d_name);
+    dir->ent.d_reclen = sizeof(dir->ent);
+    return &dir->ent;
+}
+
+void rewinddir(DIR *dir)
+{
+    FindClose(dir->find);
+    dir->find = FindFirstFileA(dir->pattern, &dir->data);
+    dir->first = dir->find != INVALID_HANDLE_VALUE;
+}
+
+int closedir(DIR *dir)
+{
+    if (dir->find != INVALID_HANDLE_VALUE) {
+        FindClose(dir->find);
+    }
+    g_free(dir->pattern);
+    g_free(dir);
+    return 0;
+}
+
+/*
+ * 128-bit division: clang calls these for __int128 / and %, from
+ * compiler-rt, which mingw links and MSVC's libraries do not have.
+ * The x64 DIV instruction when the quotient fits in 64 bits,
+ * the common case, and shift-and-subtract otherwise.
+ */
+typedef unsigned __int128 u128;
+typedef __int128 s128;
+
+static u128 udivmod128(u128 n, u128 d, u128 *rem)
+{
+    uint64_t nhi = n >> 64, nlo = n, dhi = d >> 64, dlo = d;
+    u128 q = 0, r = 0;
+    int i;
+
+    if (dhi == 0 && nhi < dlo) {
+        uint64_t q64, r64;
+        __asm__("divq %4" : "=a"(q64), "=d"(r64) : "a"(nlo), "d"(nhi), "rm"(dlo));
+        if (rem) {
+            *rem = r64;
+        }
+        return q64;
+    }
+    if (d > n) {
+        if (rem) {
+            *rem = n;
+        }
+        return 0;
+    }
+    for (i = 127; i >= 0; i--) {
+        r = (r << 1) | ((n >> i) & 1);
+        if (r >= d) {
+            r -= d;
+            q |= (u128)1 << i;
+        }
+    }
+    if (rem) {
+        *rem = r;
+    }
+    return q;
+}
+
+u128 __udivti3(u128 n, u128 d);
+u128 __umodti3(u128 n, u128 d);
+s128 __divti3(s128 n, s128 d);
+s128 __modti3(s128 n, s128 d);
+
+u128 __udivti3(u128 n, u128 d)
+{
+    return udivmod128(n, d, NULL);
+}
+
+u128 __umodti3(u128 n, u128 d)
+{
+    u128 r;
+
+    udivmod128(n, d, &r);
+    return r;
+}
+
+s128 __divti3(s128 n, s128 d)
+{
+    u128 q = udivmod128(n < 0 ? -(u128)n : (u128)n,
+                        d < 0 ? -(u128)d : (u128)d, NULL);
+
+    return (n < 0) != (d < 0) ? -(s128)q : (s128)q;
+}
+
+s128 __modti3(s128 n, s128 d)
+{
+    u128 r;
+
+    udivmod128(n < 0 ? -(u128)n : (u128)n, d < 0 ? -(u128)d : (u128)d, &r);
+    return n < 0 ? -(s128)r : (s128)r;
+}
