The libtpms TPM backend: a TPM 2.0 inside QEMU's process (track M20).

backends/tpm/tpm_libtpms.c is ours, overlaid from tpm/qemu/ by
prepare-qemu.sh; this wires it in. A `libtpms` meson feature (configure
--enable-libtpms) finds libtpms and libcrypto by pkg-config (on Linux and
macOS the static pair scripts/build-deps.sh builds; libtpms's .pc names
only -ltpms, so libcrypto is asked for by name), sets
CONFIG_TPM_LIBTPMS, and builds the file. QAPI gains the `libtpms`
TpmType with its `state` option, so `-tpmdev libtpms,id=..,state=<file>`
parses and query-tpm / `info tpm` describe it. Everything sits behind
CONFIG_TPM, which QEMU 9.2 still refuses on a Windows host.

diff --git a/backends/tpm/meson.build b/backends/tpm/meson.build
index 0bfa6c4..bcd5c76 100644
--- a/backends/tpm/meson.build
+++ b/backends/tpm/meson.build
@@ -3,4 +3,5 @@ if have_tpm
   system_ss.add(files('tpm_util.c'))
   system_ss.add(when: 'CONFIG_TPM_PASSTHROUGH', if_true: files('tpm_passthrough.c'))
   system_ss.add(when: 'CONFIG_TPM_EMULATOR', if_true: files('tpm_emulator.c'))
+  system_ss.add(when: libtpms, if_true: files('tpm_libtpms.c'))
 endif
diff --git a/meson.build b/meson.build
index d31f799..d893bae 100644
--- a/meson.build
+++ b/meson.build
@@ -1662,6 +1662,19 @@ if not get_option('libssh').auto() or have_block
                     required: get_option('libssh'))
 endif
 
+# libtpms: the TPM itself, in this process (backends/tpm/tpm_libtpms.c).
+# Its .pc names only -ltpms, so a static libtpms needs libcrypto asked for.
+libtpms = not_found
+if have_tpm and not get_option('libtpms').disabled()
+  libtpms_lib = dependency('libtpms', method: 'pkg-config',
+                           required: get_option('libtpms'))
+  libtpms_crypto = dependency('libcrypto', method: 'pkg-config',
+                              required: get_option('libtpms'))
+  if libtpms_lib.found() and libtpms_crypto.found()
+    libtpms = declare_dependency(dependencies: [libtpms_lib, libtpms_crypto])
+  endif
+endif
+
 libbzip2 = not_found
 if not get_option('bzip2').auto() or have_block
   libbzip2 = cc.find_library('bz2', has_headers: ['bzlib.h'],
@@ -2529,6 +2542,7 @@ if get_option('tcg').allowed()
   config_host_data.set('CONFIG_TCG_INTERPRETER', tcg_arch == 'tci')
 endif
 config_host_data.set('CONFIG_TPM', have_tpm)
+config_host_data.set('CONFIG_TPM_LIBTPMS', libtpms.found())
 config_host_data.set('CONFIG_TSAN', get_option('tsan'))
 config_host_data.set('CONFIG_USB_LIBUSB', libusb.found())
 config_host_data.set('CONFIG_VDE', vde.found())
@@ -4888,6 +4902,7 @@ summary_info += {'seccomp support':   seccomp}
 summary_info += {'GlusterFS support': glusterfs}
 summary_info += {'hv-balloon support': hv_balloon}
 summary_info += {'TPM support':       have_tpm}
+summary_info += {'libtpms support':   libtpms}
 summary_info += {'libssh support':    libssh}
 summary_info += {'lzo support':       lzo}
 summary_info += {'cdimage (libdisc)':  libdisc}
