+/* READ CD MSF: start MSF inclusive (bytes 3..5), end MSF exclusive (6..8) */
+static void cmd_read_cd_msf(IDEState *s, uint8_t* buf)
+{
+    int start = atapi_msf_to_lba(buf[3], buf[4], buf[5]);
+    int end = atapi_msf_to_lba(buf[6], buf[7], buf[8]);
+    uint64_t total_sectors = s->nb_sectors >> 2;
+
+    if (end == start) {
+        ide_atapi_cmd_ok(s);
+        return;
+    }
+    if (end < start || start < 0 || start >= total_sectors ||
+        end > total_sectors) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_LOGICAL_BLOCK_OOR);
+        return;
+    }
+
+    atapi_read_cd_common(s, buf, start, end - start);
+}
