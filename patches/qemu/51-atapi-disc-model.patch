+/*
+ * The DMA path of a disc-model read: each chunk is filled synchronously
+ * from libdisc and pushed through the bus-master engine; the next chunk
+ * is entered through a bottom half so the stack stays flat and the
+ * completion asynchronous, which every era driver copes with.
+ */
+static void ide_atapi_disc_read_dma_cb(void *opaque, int ret)
+{
+    IDEState *s = opaque;
+    int per_chunk, n, i;
+
+    if (s->io_buffer_size > 0) {
+        s->packet_transfer_size -= s->io_buffer_size;
+        if (s->bus->dma->ops->rw_buf(s->bus->dma, 1) == 0) {
+            goto eot;
+        }
+    }
+
+    if (s->packet_transfer_size <= 0) {
+        s->status = READY_STAT | SEEK_STAT;
+        s->nsector = (s->nsector & ~7) | ATAPI_INT_REASON_IO | ATAPI_INT_REASON_CD;
+        ide_bus_set_irq(s->bus);
+        goto eot;
+    }
+
+    per_chunk = s->io_buffer_total_len / s->cd_sector_size;
+    n = s->packet_transfer_size / s->cd_sector_size;
+    if (n > per_chunk) {
+        n = per_chunk;
+    }
+    for (i = 0; i < n; i++) {
+        if (atapi_disc_read_sector(s, s->io_buffer + i * s->cd_sector_size,
+                                   s->cd_sector_size) < 0) {
+            /* the sense is set; the failing sector aborts the command */
+            ret = -EIO;
+            goto eot;
+        }
+    }
+    s->io_buffer_index = 0;
+    s->io_buffer_size = n * s->cd_sector_size;
+    replay_bh_schedule_oneshot_event(qemu_get_aio_context(),
+                                     ide_atapi_disc_read_dma_bh, s);
+    return;
+
+eot:
+    if (ret < 0) {
+        block_acct_failed(blk_get_stats(s->blk), &s->acct);
+    } else {
+        block_acct_done(blk_get_stats(s->blk), &s->acct);
+    }
+    ide_set_inactive(s, false);
+}
+
+static void ide_atapi_disc_read_dma(IDEState *s, int lba, int nb_sectors,
+                                    int sector_size)
+{
+    assert(0 <= lba && lba < (s->nb_sectors >> 2));
+
+    s->lba = lba;
+    s->packet_transfer_size = nb_sectors * sector_size;
+    s->io_buffer_size = 0;
+    s->cd_sector_size = sector_size;
+
+    block_acct_start(blk_get_stats(s->blk), &s->acct, s->packet_transfer_size,
+                     BLOCK_ACCT_READ);
+
+    s->status = READY_STAT | SEEK_STAT | DRQ_STAT | BUSY_STAT;
+    ide_start_dma(s, ide_atapi_disc_read_dma_cb);
+}
