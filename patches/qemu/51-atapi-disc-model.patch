+/* the parameter list of MODE SELECT(10) has arrived in io_buffer */
+static void atapi_mode_select_apply(IDEState *s)
+{
+    uint8_t *buf = s->io_buffer;
+    int len = s->packet_transfer_size;
+    int bdl, off;
+
+    if (len < 8) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, 0x1a); /* parameter list length error */
+        return;
+    }
+    bdl = lduw_be_p(buf + 6);
+    off = 8 + bdl;
+    while (off + 2 <= len) {
+        int code = buf[off] & 0x3f;
+        int plen = buf[off + 1];
+
+        if (off + 2 + plen > len) {
+            ide_atapi_cmd_error(s, ILLEGAL_REQUEST, 0x26); /* invalid field in parameter list */
+            return;
+        }
+        if (code == MODE_PAGE_AUDIO_CTL && plen >= 14) {
+            int i;
+
+            for (i = 0; i < 4; i++) {
+                s->atapi_audio_port[i] = buf[off + 8 + 2 * i] & 0x0f;
+                s->atapi_audio_vol[i] = buf[off + 9 + 2 * i];
+            }
+        }
+        /* other pages (error recovery, capabilities) are accepted and ignored */
+        off += 2 + plen;
+    }
+    ide_atapi_cmd_ok(s);
+}
+
+/* the end-transfer function of a data-out packet command (core.c knows it) */
+void ide_atapi_data_out_done(IDEState *s)
+{
+    atapi_mode_select_apply(s);
+}
+
+static void atapi_mode_select_dma_cb(void *opaque, int ret)
+{
+    IDEState *s = opaque;
+
+    s->io_buffer_index = 0;
+    s->io_buffer_size = s->packet_transfer_size;
+    s->bus->dma->ops->rw_buf(s->bus->dma, 0);
+    atapi_mode_select_apply(s);
+    ide_set_inactive(s, false);
+}
+
+static void cmd_mode_select(IDEState *s, uint8_t *buf)
+{
+    int len = lduw_be_p(buf + 7);
+
+    if (len == 0) {
+        ide_atapi_cmd_ok(s);
+        return;
+    }
+    if (len > s->io_buffer_total_len) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_INV_FIELD_IN_CMD_PACKET);
+        return;
+    }
+    s->lba = -1;
+    s->packet_transfer_size = len;
+    s->elementary_transfer_size = 0;
+    if (s->atapi_dma) {
+        s->io_buffer_size = 0;
+        s->status = READY_STAT | SEEK_STAT | DRQ_STAT | BUSY_STAT;
+        ide_start_dma(s, atapi_mode_select_dma_cb);
+        return;
+    }
+    /* data to the device: interrupt reason CD=0 IO=0, then the byte count */
+    s->nsector = s->nsector & ~7;
+    s->lcyl = len & 0xff;
+    s->hcyl = len >> 8;
+    s->status = READY_STAT | SEEK_STAT;
+    ide_transfer_start(s, s->io_buffer, len, ide_atapi_data_out_done);
+    ide_bus_set_irq(s->bus);
+}
