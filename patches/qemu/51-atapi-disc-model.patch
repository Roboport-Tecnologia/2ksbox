+static void ide_atapi_disc_read_dma_bh(void *opaque)
+{
+    IDEState *s = opaque;
+
+    /* a bus reset in between drops the transfer */
+    if (s->atapi_disc_read && s->lba != -1) {
+        ide_atapi_disc_read_dma_cb(s, 0);
+    }
+}
