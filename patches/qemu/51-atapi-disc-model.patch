+/* the sense a drive reports for each libdisc error (doc 17 §3) */
+static void atapi_disc_error(IDEState *s, int rc)
+{
+    switch (rc) {
+    case LIBDISC_ERANGE:
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_LOGICAL_BLOCK_OOR);
+        break;
+    case LIBDISC_EMEDIUM:
+        ide_atapi_cmd_error_ascq(s, MEDIUM_ERROR, ASC_UNRECOVERED_READ_ERROR,
+                                 0x05); /* L-EC uncorrectable error */
+        break;
+    case LIBDISC_EMODE:
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_ILLEGAL_MODE_FOR_THIS_TRACK);
+        break;
+    case LIBDISC_EINVAL:
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_INV_FIELD_IN_CMD_PACKET);
+        break;
+    default:
+        ide_atapi_cmd_error(s, HARDWARE_ERROR, ASC_LUN_COMMUNICATION_FAILURE);
+        break;
+    }
+}
+
+/* a responder's reply (or its error) into io_buffer, then to the guest */
+static void atapi_disc_reply(IDEState *s, int len, int max_len)
+{
+    if (len < 0) {
+        atapi_disc_error(s, len);
+        return;
+    }
+    if (atapi_trace_enabled()) {
+        atapi_trace_hex("reply", s->io_buffer, len);
+    }
+    ide_atapi_cmd_reply(s, len, max_len);
+}
+
+/*
+ * One sector of the current READ CD-shaped transfer from the model into
+ * dst; on failure the sense is set and -1 returned. Advances s->lba.
+ */
+static int atapi_disc_read_sector(IDEState *s, uint8_t *dst, int cap)
+{
+    libdisc *disc = atapi_disc(s);
+    int n;
+
+    if (!disc) {
+        ide_atapi_cmd_error(s, NOT_READY, ASC_MEDIUM_NOT_PRESENT);
+        return -1;
+    }
+    n = libdisc_mmc_read_cd_sector(disc, s->lba, s->atapi_rc_type,
+                                   s->atapi_rc_b9, s->atapi_rc_b10, dst, cap);
+    if (n < 0) {
+        atapi_disc_error(s, n);
+        return -1;
+    }
+    if (n != s->cd_sector_size) {
+        ide_atapi_cmd_error(s, HARDWARE_ERROR, ASC_LUN_COMMUNICATION_FAILURE);
+        return -1;
+    }
+    s->atapi_last_lba = s->lba;
+    s->lba++;
+    return 0;
+}
+
+/* ---- CD-DA position tracking (the voice comes with patch 51's M5b part) */
+
+static uint32_t atapi_audio_position(IDEState *s)
+{
+    switch (s->atapi_audio_status) {
+    case 0x11: {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+        if (s->atapi_voice) {
+            return s->atapi_play_lba;
+        }
+        int64_t adv = (now - s->atapi_play_start_ns) * 75 / NANOSECONDS_PER_SECOND;
+        uint64_t lba = s->atapi_play_start_lba + adv;
+
+        if (lba >= s->atapi_play_end) {
+            lba = s->atapi_play_end - 1;
+        }
+        return lba;
+    }
+    case 0x12:
+    case 0x13:
+        return s->atapi_play_lba;
+    default:
+        return s->atapi_last_lba;
+    }
+}
+
+static void atapi_play_timer_cb(void *opaque)
+{
+    IDEState *s = opaque;
+
+    if (s->atapi_audio_status == 0x11) {
+        s->atapi_play_lba = s->atapi_play_end;
+        s->atapi_audio_status = 0x13;
+    }
+}
+
+static void atapi_audio_stop(IDEState *s, uint8_t status)
+{
+    if (s->atapi_audio_status == 0x11) {
+        s->atapi_play_lba = atapi_audio_position(s);
+    }
+    if (s->atapi_play_timer) {
+        timer_del(s->atapi_play_timer);
+    }
+    if (s->atapi_voice) {
+        audio_be_set_active_out(s->atapi_be, s->atapi_voice, 0);
+    }
+    s->atapi_audio_frame_len = 0;
+    s->atapi_audio_status = status;
+}
+
+/*
+ * The stop a guest asks for: playback ends, the drive has no audio status
+ * to report and the position falls back to the last sector read. Both
+ * STOP PLAY/SCAN and the stop half of START STOP UNIT mean this.
+ */
+static void atapi_audio_stop_play(IDEState *s)
+{
+    atapi_audio_stop(s, 0x15);
+    s->atapi_play_lba = 0;
+}
+
+/*
+ * One audio sector into the voice's frame buffer with mode page 0x0E's
+ * routing: port 0 feeds the left output, port 1 the right; a port's
+ * channel selection is a bit mask (1 = left, 2 = right, 3 = both, mixed)
+ * scaled by its volume.
+ */
+static void atapi_audio_route(IDEState *s, const uint8_t *raw)
+{
+    int i;
+
+    for (i = 0; i < 588; i++) {
+        int l = (int16_t)(raw[i * 4] | (raw[i * 4 + 1] << 8));
+        int r = (int16_t)(raw[i * 4 + 2] | (raw[i * 4 + 3] << 8));
+        int out[2];
+        int port;
+
+        for (port = 0; port < 2; port++) {
+            int sel = s->atapi_audio_port[port] & 3;
+            int v = (sel & 1 ? l : 0) + (sel & 2 ? r : 0);
+
+            if (sel == 3) {
+                v /= 2;
+            }
+            out[port] = v * s->atapi_audio_vol[port] / 255;
+        }
+        s->atapi_audio_frame[i * 4] = out[0] & 0xff;
+        s->atapi_audio_frame[i * 4 + 1] = (out[0] >> 8) & 0xff;
+        s->atapi_audio_frame[i * 4 + 2] = out[1] & 0xff;
+        s->atapi_audio_frame[i * 4 + 3] = (out[1] >> 8) & 0xff;
+    }
+    s->atapi_audio_frame_pos = 0;
+    s->atapi_audio_frame_len = 2352;
+}
+
+/* the audio layer asks for up to `avail` bytes: sectors of the play range */
+static void atapi_audio_cb(void *opaque, int avail)
+{
+    IDEState *s = opaque;
+
+    while (avail > 0 && s->atapi_audio_status == 0x11) {
+        if (s->atapi_audio_frame_pos < s->atapi_audio_frame_len) {
+            int n = audio_be_write(s->atapi_be, s->atapi_voice,
+                              s->atapi_audio_frame + s->atapi_audio_frame_pos,
+                              MIN(avail, s->atapi_audio_frame_len - s->atapi_audio_frame_pos));
+            if (n <= 0) {
+                return;
+            }
+            s->atapi_audio_frame_pos += n;
+            avail -= n;
+            continue;
+        }
+        if (s->atapi_play_lba >= s->atapi_play_end) {
+            s->atapi_audio_status = 0x13;
+            audio_be_set_active_out(s->atapi_be, s->atapi_voice, 0);
+            return;
+        }
+        {
+            libdisc *disc = atapi_disc(s);
+            uint8_t raw[2352];
+            LibdiscSectorInfo info;
+
+            if (!disc || libdisc_sector_info(disc, s->atapi_play_lba, &info) < 0 ||
+                info.kind != LIBDISC_KIND_AUDIO ||
+                libdisc_read_raw(disc, s->atapi_play_lba, raw) < 0) {
+                /* a data sector or a lost medium inside the range: error stop */
+                s->atapi_audio_status = 0x14;
+                audio_be_set_active_out(s->atapi_be, s->atapi_voice, 0);
+                return;
+            }
+            atapi_audio_route(s, raw);
+            s->atapi_play_lba++;
+        }
+    }
+}
+
+/* play [lba, atapi_play_end) at 75 sectors per second of virtual time */
+static void atapi_audio_start(IDEState *s, uint32_t lba)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    s->atapi_play_lba = lba;
+    s->atapi_play_start_lba = lba;
+    s->atapi_play_start_ns = now;
+    s->atapi_audio_frame_len = 0;
+    if (s->atapi_voice) {
+        s->atapi_audio_status = 0x11;
+        audio_be_set_active_out(s->atapi_be, s->atapi_voice, 1);
+        return;
+    }
+    if (!s->atapi_play_timer) {
+        s->atapi_play_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                           atapi_play_timer_cb, s);
+    }
+    timer_mod(s->atapi_play_timer, now + (int64_t)(s->atapi_play_end - lba) *
+              NANOSECONDS_PER_SECOND / 75);
+    s->atapi_audio_status = 0x11;
+}
+
+static void atapi_play_range(IDEState *s, libdisc *disc, int64_t start,
+                             int64_t end)
+{
+    uint32_t total = libdisc_sector_count(disc);
+    LibdiscSectorInfo info;
+    int rc;
+
+    if (start < 0 || start > total || end > total || end < start) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_LOGICAL_BLOCK_OOR);
+        return;
+    }
+    if (start == end) {
+        atapi_audio_stop(s, 0x13);
+        s->atapi_play_lba = start;
+        ide_atapi_cmd_ok(s);
+        return;
+    }
+    rc = libdisc_sector_info(disc, start, &info);
+    if (rc < 0) {
+        atapi_disc_error(s, rc);
+        return;
+    }
+    if (info.kind != LIBDISC_KIND_AUDIO) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_ILLEGAL_MODE_FOR_THIS_TRACK);
+        return;
+    }
+    atapi_audio_stop(s, 0x15);
+    s->atapi_play_end = end;
+    atapi_audio_start(s, start);
+    ide_atapi_cmd_ok(s);
+}
+#else
+typedef void libdisc;
+static inline libdisc *atapi_disc(IDEState *s)
+{
+    return NULL;
+}
+#endif
