+static void atapi_disc_get_configuration(IDEState *s, uint8_t *buf)
+{
+    static const struct {
+        uint16_t code;
+        uint8_t version_flags;
+        uint8_t body[4];
+    } features[] = {
+        { 0x0000, (0 << 2) | 0x03, { 0x00, 0x08, 0x01, 0x00 } }, /* profile list: CD-ROM, current */
+        { 0x001e, (2 << 2) | 0x03, { 0x02, 0x00, 0x00, 0x00 } }, /* CD read: C2 error pointers */
+        { 0x0103, (1 << 2) | 0x03, { 0x07, 0x00, 0x01, 0x00 } }, /* CD audio: scan, mute, volume, 256 levels */
+    };
+    int rt = buf[1] & 3;
+    int start = lduw_be_p(buf + 2);
+    int max_len = lduw_be_p(buf + 7);
+    int len = 8, i;
+
+    if (rt == 3) {
+        ide_atapi_cmd_error(s, ILLEGAL_REQUEST, ASC_INV_FIELD_IN_CMD_PACKET);
+        return;
+    }
+    if (max_len > BDRV_SECTOR_SIZE) {
+        max_len = BDRV_SECTOR_SIZE;
+    }
+    memset(buf, 0, MAX(max_len, 8));
+    stw_be_p(buf + 6, MMC_PROFILE_CD_ROM);
+    for (i = 0; i < ARRAY_SIZE(features); i++) {
+        if (rt == 2 ? features[i].code != start : features[i].code < start) {
+            continue;
+        }
+        if (len + 8 > BDRV_SECTOR_SIZE) {
+            break;
+        }
+        stw_be_p(buf + len, features[i].code);
+        buf[len + 2] = features[i].version_flags;
+        buf[len + 3] = 4;
+        memcpy(buf + len + 4, features[i].body, 4);
+        len += 8;
+    }
+    stl_be_p(buf, len - 4);
+    ide_atapi_cmd_reply(s, len, max_len);
