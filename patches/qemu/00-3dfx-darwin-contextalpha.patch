qemu-3dfx Darwin build fix: GL_CONTEXTALPHA was defined only under
CONFIG_LINUX but is used in the shared Linux/Darwin body of
MGLPresetPixelFormat() (upstream regression, qemu-3dfx d00e858).
Error on macOS: "use of undeclared identifier GL_CONTEXTALPHA".

diff --git a/hw/mesa/mglcntx_linux.c b/hw/mesa/mglcntx_linux.c
index c8c6a784cc..94fb842d72 100644
--- a/hw/mesa/mglcntx_linux.c
+++ b/hw/mesa/mglcntx_linux.c
@@ -71,8 +71,9 @@ int MGLUpdateGuestBufo(mapbufo_t *bufo, const int add)
 
     return ret;
 }
-#define GL_CONTEXTALPHA 1
 #endif /* CONFIG_LINUX */
+/* used by MGLPresetPixelFormat() below on both Linux and Darwin */
+#define GL_CONTEXTALPHA 1
 
 typedef uint16_t WORD;
 typedef uint32_t DWORD;
