+#ifdef CONFIG_CDIMAGE
+/*
+ * 2ksbox (patch 102, M5h, doc 17 §9): a host drive's sectors are read off
+ * the main loop. A read there can wait out a seek, 2.7 s on a USB drive
+ * changing spin speed, and on the main loop that froze the whole machine.
+ * The sectors go to the thread pool into a buffer of the request's own,
+ * with a reference to the disc of its own (the disc can be swapped out of
+ * the drive meanwhile); the completion runs on the main loop and carries
+ * on where the synchronous read would have. A reset in between clears
+ * atapi_disc_pending and the result is dropped. Images keep the
+ * synchronous path: their reads are a file's.
+ */
+typedef struct AtapiDiscRead AtapiDiscRead;
+typedef void AtapiDiscReadFinish(IDEState *s, AtapiDiscRead *r);
+
+struct AtapiDiscRead {
+    IDEState *s;
+    libdisc *disc;
+    uint32_t lba;
+    int n, size;
+    uint8_t type, b9, b10;
+    uint8_t *buf;
+    int done;                   /* sectors read before rc */
+    int rc;                     /* 0, a LIBDISC_E* code, or 1: a short sector */
+    AtapiDiscReadFinish *finish;
+};
+
+/* the thread pool's worker: no IDEState, no BQL */
+static int atapi_disc_read_worker(void *opaque)
+{
+    AtapiDiscRead *r = opaque;
+
+    for (r->done = 0; r->done < r->n; r->done++) {
+        int got = libdisc_mmc_read_cd_sector(r->disc, r->lba + r->done,
+                                             r->type, r->b9, r->b10,
+                                             r->buf + r->done * r->size,
+                                             r->size);
+        if (got != r->size) {
+            r->rc = got < 0 ? got : 1;
+            break;
+        }
+    }
+    return 0;
+}
+
+static void atapi_disc_read_done(void *opaque, int ret)
+{
+    AtapiDiscRead *r = opaque;
+    IDEState *s = r->s;
+
+    if (s->atapi_disc_pending == r) {
+        s->atapi_disc_pending = NULL;
+        r->finish(s, r);
+    }
+    libdisc_close(r->disc);
+    g_free(r->buf);
+    g_free(r);
+}
+
+static void atapi_disc_read_async(IDEState *s, libdisc *disc, uint32_t lba,
+                                  int n, AtapiDiscReadFinish *finish)
+{
+    AtapiDiscRead *r = g_new0(AtapiDiscRead, 1);
+
+    r->s = s;
+    r->disc = libdisc_ref(disc);
+    r->lba = lba;
+    r->n = n;
+    r->size = s->cd_sector_size;
+    r->type = s->atapi_rc_type;
+    r->b9 = s->atapi_rc_b9;
+    r->b10 = s->atapi_rc_b10;
+    r->buf = g_malloc((size_t)n * r->size);
+    r->finish = finish;
+    s->atapi_disc_pending = r;
+    s->status |= BUSY_STAT;
+    thread_pool_submit_aio(atapi_disc_read_worker, r, atapi_disc_read_done, r);
+}
+
+/*
+ * What atapi_disc_read_sector did per sector, for the whole read: the
+ * position of the last sector read, and the sense of a failed one (which
+ * ends the command). -1 when it failed.
+ */
+static int atapi_disc_read_result(IDEState *s, AtapiDiscRead *r)
+{
+    if (r->done > 0) {
+        s->atapi_last_lba = r->lba + r->done - 1;
+    }
+    if (r->rc == 1) {
+        ide_atapi_cmd_error(s, HARDWARE_ERROR, ASC_LUN_COMMUNICATION_FAILURE);
+        return -1;
+    }
+    if (r->rc < 0) {
+        atapi_disc_error(s, r->rc);
+        return -1;
+    }
+    return 0;
+}
+
+/* PIO: the burst is in; hand it over as cd_read_sector's synchronous path does */
+static void cd_disc_read_finish(IDEState *s, AtapiDiscRead *r)
+{
+    if (!s->atapi_disc_read || atapi_disc_read_result(s, r) < 0) {
+        return;
+    }
+    memcpy(s->io_buffer, r->buf, (size_t)r->n * r->size);
+    cd_read_sector_done(s);
+}
