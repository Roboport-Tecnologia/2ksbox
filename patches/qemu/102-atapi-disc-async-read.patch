+/*
+ * patch 102: a chunk read off the main loop is in. Into io_buffer and on
+ * through the bus-master engine, or the failed sector's sense and the
+ * end of the command, as the synchronous loop below does.
+ */
+static void ide_atapi_disc_read_dma_finish(IDEState *s, AtapiDiscRead *r)
+{
+    /* a bus reset in between drops the transfer, as in the bottom half */
+    if (!s->atapi_disc_read || s->lba == -1) {
+        return;
+    }
+    s->lba += r->done;
+    if (atapi_disc_read_result(s, r) < 0) {
+        block_acct_failed(blk_get_stats(s->blk), &s->acct);
+        ide_set_inactive(s, false);
+        return;
+    }
+    memcpy(s->io_buffer, r->buf, (size_t)r->n * r->size);
+    s->io_buffer_index = 0;
+    s->io_buffer_size = r->n * s->cd_sector_size;
+    ide_atapi_disc_read_dma_cb(s, 0);
+}
