+void translator_lookup_and_goto_ptr(TCGv_i64 pc, TCGv_i64 cs_base,
+                                    TCGv_i32 flags)
+{
+#if UINTPTR_MAX == UINT64_MAX && !defined(CONFIG_USER_ONLY)
+    TCGv_i64 tmp, hash, entry, tb, tbs, m, ptr;
+    TCGv_i32 f, c;
+
+    if (!tcg_inline_lookup
+        || (tcg_ctx->gen_tb->cflags & CF_NO_GOTO_PTR)
+        || qatomic_read(&one_insn_per_tb)
+        || qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC
+                              | CPU_LOG_TB_NOCHAIN)) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+
+    /*
+    * Branch-free on purpose: a brcond ends a TCG basic block, where every
+    * live TB temporary is spilled to the stack and reloaded after it. The
+    * probe accumulates a mismatch word instead and decides once, at the
+    * goto_ptr. A null jump-cache entry is replaced by the TB being
+    * translated so the loads are safe; its nullness is part of the word.
+    */
+#define CPU_OFF(f) (offsetof(CPUState, f) - (ptrdiff_t)sizeof(CPUState))
+    tmp = tcg_temp_ebb_new_i64();
+    hash = tcg_temp_ebb_new_i64();
+    entry = tcg_temp_ebb_new_i64();
+    tb = tcg_temp_ebb_new_i64();
+    tbs = tcg_temp_ebb_new_i64();
+    m = tcg_temp_ebb_new_i64();
+    ptr = tcg_temp_ebb_new_i64();
+    f = tcg_temp_ebb_new_i32();
+    c = tcg_temp_ebb_new_i32();
+
+    /* hash = tb_jmp_cache_hash_func(pc) */
+    tcg_gen_shri_i64(tmp, pc, TARGET_PAGE_BITS - TB_JMP_PAGE_BITS);
+    tcg_gen_xor_i64(tmp, tmp, pc);
+    tcg_gen_shri_i64(hash, tmp, TARGET_PAGE_BITS - TB_JMP_PAGE_BITS);
+    tcg_gen_andi_i64(hash, hash, TB_JMP_PAGE_MASK);
+    tcg_gen_andi_i64(tmp, tmp, TB_JMP_ADDR_MASK);
+    tcg_gen_or_i64(hash, hash, tmp);
+
+    /* entry = &cpu->tb_jmp_cache->array[hash] */
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+    tcg_gen_ld_i64(entry, tcg_env, CPU_OFF(tb_jmp_cache));
+    tcg_gen_shli_i64(hash, hash, 4);
+    tcg_gen_add_i64(entry, entry, hash);
+
+    /* tb = entry->tb; tbs = tb ? tb : the current TB (a safe base) */
+    tcg_gen_ld_i64(tb, (TCGv_ptr)entry, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_movcond_i64(TCG_COND_EQ, tbs, tb, tcg_constant_i64(0),
+                        tcg_constant_i64((uintptr_t)tcg_ctx->gen_tb), tb);
+
+    /* m: zero iff the entry is a hit and the chain may be taken */
+    tcg_gen_setcondi_i64(TCG_COND_EQ, m, tb, 0);
+    tcg_gen_ld_i64(tmp, (TCGv_ptr)entry, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_xor_i64(tmp, tmp, pc);
+    tcg_gen_or_i64(m, m, tmp);
+    tcg_gen_ld_i64(tmp, (TCGv_ptr)tbs, offsetof(TranslationBlock, cs_base));
+    tcg_gen_xor_i64(tmp, tmp, cs_base);
+    tcg_gen_or_i64(m, m, tmp);
+    /* a breakpoint list or gdb single-step: the main loop's lookup decides */
+    tcg_gen_ld_i64(tmp, tcg_env, CPU_OFF(breakpoints.tqh_first));
+    tcg_gen_or_i64(m, m, tmp);
+
+    tcg_gen_ld_i32(f, (TCGv_ptr)tbs, offsetof(TranslationBlock, flags));
+    tcg_gen_xor_i32(f, f, flags);
+    tcg_gen_ld_i32(c, (TCGv_ptr)tbs, offsetof(TranslationBlock, cflags));
+    tcg_gen_or_i32(f, f, c);
+    tcg_gen_ld_i32(c, tcg_env, CPU_OFF(tcg_cflags));
+    tcg_gen_xor_i32(f, f, c);      /* (tb->cflags ^ cpu->tcg_cflags) folded */
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, singlestep_flags) != 4);
+    tcg_gen_ld_i32(c, tcg_env, CPU_OFF(singlestep_flags));
+    tcg_gen_andi_i32(c, c, SSTEP_ENABLE);       /* cpu_single_stepping() */
+    tcg_gen_or_i32(f, f, c);
+    tcg_gen_extu_i32_i64(tmp, f);
+    tcg_gen_or_i64(m, m, tmp);
+
+    /* jump to the TB's code, or to the epilogue (return 0: no last TB) */
+    tcg_gen_ld_i64(ptr, (TCGv_ptr)tbs, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_movcond_i64(TCG_COND_EQ, ptr, m, tcg_constant_i64(0), ptr,
+                        tcg_constant_i64((uintptr_t)tcg_code_gen_epilogue));
+    plugin_gen_disable_mem_helpers();
+    tcg_gen_goto_ptr((TCGv_ptr)ptr);
+#undef CPU_OFF
+#else
+    tcg_gen_lookup_and_goto_ptr();
+#endif
+}
