+/*
+ * The jump-cache probe inline (M9 track, patch 20): the target's pc, cs_base
+ * and flags as cpu_get_tb_cpu_state() computes them, from the state the
+ * instruction and gen_eob() have already stored, so far jumps (CS and hflags
+ * changed by a helper) and the x87 / SSE fast-mode bits (runtime state) are
+ * covered exactly like the helper would. i386 target only: the x86-64
+ * target's CS64 case (cs_base 0, a 64-bit pc) is not built here.
+ */
+static void gen_lookup_and_goto_ptr(DisasContext *s)
+{
+#ifdef TARGET_X86_64
+    tcg_gen_lookup_and_goto_ptr();
+#else
+    TCGv_i32 flags = tcg_temp_new_i32();
+    TCGv_i32 t = tcg_temp_new_i32();
+    TCGv_i32 u = tcg_temp_new_i32();
+    TCGv_i64 pc = tcg_temp_new_i64();
+    TCGv_i64 cs_base = tcg_temp_new_i64();
+
+    tcg_gen_ld_i32(flags, tcg_env, offsetof(CPUX86State, hflags));
+    tcg_gen_ld_i32(t, tcg_env, offsetof(CPUX86State, eflags));
+    tcg_gen_andi_i32(t, t, IOPL_MASK | TF_MASK | RF_MASK | VM_MASK | AC_MASK);
+    tcg_gen_or_i32(flags, flags, t);
+    tcg_gen_ld8u_i32(t, tcg_env, offsetof(CPUX86State, x87_fast_mode));
+    tcg_gen_shli_i32(t, t, TB_FLAG_X87_MODE_SHIFT);
+    tcg_gen_or_i32(flags, flags, t);
+    /* the 16-bit bit-field float_exception_flags, as in sses_state() */
+    QEMU_BUILD_BUG_ON(HOST_BIG_ENDIAN);
+    tcg_gen_ld16u_i32(t, tcg_env, offsetof(CPUX86State, sse_status));
+    tcg_gen_andi_i32(t, t, float_flag_inexact);
+    tcg_gen_setcondi_i32(TCG_COND_NE, t, t, 0);
+    tcg_gen_ld8u_i32(u, tcg_env, offsetof(CPUX86State, sse_fast_mode));
+    tcg_gen_setcondi_i32(TCG_COND_NE, u, u, 0);
+    tcg_gen_and_i32(t, t, u);
+    tcg_gen_shli_i32(t, t, TB_FLAG_SSE_FAST_SHIFT);
+    tcg_gen_or_i32(flags, flags, t);
+
+    tcg_gen_ld_i32(t, tcg_env, offsetof(CPUX86State, segs[R_CS].base));
+    tcg_gen_extu_i32_i64(cs_base, t);
+    tcg_gen_add_i32(t, t, cpu_eip);
+    tcg_gen_extu_i32_i64(pc, t);
+
+    translator_lookup_and_goto_ptr(pc, cs_base, flags);
+#endif
+}
